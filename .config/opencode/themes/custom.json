{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "background": "#05070a",
    "foreground": "#f0f3f6",
    "surface": "#0d1117",
    "surface2": "#101826",
    "cursorline": "#0b1220",
    "border": "#30363d",
    "selection": "#1f6feb",

    "black": "#05070a",
    "red": "#ff6b7a",
    "green": "#4ade80",
    "yellow": "#facc15",
    "blue": "#60a5fa",
    "purple": "#c084fc",
    "cyan": "#22d3ee",
    "white": "#ffffff",

    "pink": "#ff79c6",
    "orange": "#fb923c",
    "gray": "#8b949e",
    "lightGray": "#c9d1d9",

    "brightRed": "#ff4d6d",
    "brightGreen": "#22c55e",
    "brightYellow": "#eab308",
    "brightBlue": "#3b82f6",
    "brightPurple": "#a855f7",
    "brightCyan": "#06b6d4",

    "diffAddedBg": "#10251a",
    "diffRemovedBg": "#2a0b10",
    "diffContextBg": "#0d1117",
    "diffHunkBg": "#101826"
  },
  "theme": {
    "primary": {
      "dark": "blue",
      "light": "blue"
    },
    "secondary": {
      "dark": "purple",
      "light": "purple"
    },
    "accent": {
      "dark": "cyan",
      "light": "cyan"
    },
    "error": {
      "dark": "red",
      "light": "red"
    },
    "warning": {
      "dark": "yellow",
      "light": "yellow"
    },
    "success": {
      "dark": "green",
      "light": "green"
    },
    "info": {
      "dark": "blue",
      "light": "blue"
    },

    "text": {
      "dark": "foreground",
      "light": "foreground"
    },
    "textMuted": {
      "dark": "gray",
      "light": "gray"
    },

    "background": {
      "dark": "background",
      "light": "background"
    },
    "backgroundPanel": {
      "dark": "surface",
      "light": "surface"
    },
    "backgroundElement": {
      "dark": "surface2",
      "light": "surface2"
    },

    "border": {
      "dark": "border",
      "light": "border"
    },
    "borderActive": {
      "dark": "blue",
      "light": "blue"
    },
    "borderSubtle": {
      "dark": "border",
      "light": "border"
    },

    "diffAdded": {
      "dark": "green",
      "light": "green"
    },
    "diffRemoved": {
      "dark": "red",
      "light": "red"
    },
    "diffContext": {
      "dark": "gray",
      "light": "gray"
    },
    "diffHunkHeader": {
      "dark": "blue",
      "light": "blue"
    },
    "diffHighlightAdded": {
      "dark": "brightGreen",
      "light": "brightGreen"
    },
    "diffHighlightRemoved": {
      "dark": "brightRed",
      "light": "brightRed"
    },
    "diffAddedBg": {
      "dark": "diffAddedBg",
      "light": "diffAddedBg"
    },
    "diffRemovedBg": {
      "dark": "diffRemovedBg",
      "light": "diffRemovedBg"
    },
    "diffContextBg": {
      "dark": "diffContextBg",
      "light": "diffContextBg"
    },
    "diffLineNumber": {
      "dark": "gray",
      "light": "gray"
    },
    "diffAddedLineNumberBg": {
      "dark": "diffAddedBg",
      "light": "diffAddedBg"
    },
    "diffRemovedLineNumberBg": {
      "dark": "diffRemovedBg",
      "light": "diffRemovedBg"
    },

    "markdownText": {
      "dark": "foreground",
      "light": "foreground"
    },
    "markdownHeading": {
      "dark": "blue",
      "light": "blue"
    },
    "markdownLink": {
      "dark": "blue",
      "light": "blue"
    },
    "markdownLinkText": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownCode": {
      "dark": "green",
      "light": "green"
    },
    "markdownBlockQuote": {
      "dark": "gray",
      "light": "gray"
    },
    "markdownEmph": {
      "dark": "orange",
      "light": "orange"
    },
    "markdownStrong": {
      "dark": "yellow",
      "light": "yellow"
    },
    "markdownHorizontalRule": {
      "dark": "border",
      "light": "border"
    },
    "markdownListItem": {
      "dark": "orange",
      "light": "orange"
    },
    "markdownListEnumeration": {
      "dark": "purple",
      "light": "purple"
    },
    "markdownImage": {
      "dark": "purple",
      "light": "purple"
    },
    "markdownImageText": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownCodeBlock": {
      "dark": "green",
      "light": "green"
    },

    "syntaxComment": {
      "dark": "gray",
      "light": "gray"
    },
    "syntaxKeyword": {
      "dark": "pink",
      "light": "pink"
    },
    "syntaxFunction": {
      "dark": "blue",
      "light": "blue"
    },
    "syntaxVariable": {
      "dark": "purple",
      "light": "purple"
    },
    "syntaxString": {
      "dark": "green",
      "light": "green"
    },
    "syntaxNumber": {
      "dark": "yellow",
      "light": "yellow"
    },
    "syntaxType": {
      "dark": "cyan",
      "light": "cyan"
    },
    "syntaxOperator": {
      "dark": "green",
      "light": "green"
    },
    "syntaxPunctuation": {
      "dark": "gray",
      "light": "gray"
    }
  }
}
