#!/usr/bin/env bash

source "$HOME/.local/bin/auto-update-app.bash"

_dalfox_download() {
    local os arch release archive_dir
    case "$(uname -s)" in
        Linux) os=linux ;;
        Darwin) os=macos ;;
        *) printf 'dalfox: unsupported system: %s\n' "$(uname -s)" >&2; return 2 ;;
    esac
    case "$(uname -m)" in
        x86_64 | amd64) arch=x86_64 ;;
        aarch64 | arm64) arch=aarch64 ;;
        *) printf 'dalfox: unsupported cpu arch: %s\n' "$(uname -m)" >&2; return 2 ;;
    esac
    release="$(auto_update_latest_release_tag hahwul/dalfox)" || return 1
    archive_dir="dalfox-${release}-${os}-${arch}"
    AUTO_UPDATE_URL="https://github.com/hahwul/dalfox/releases/download/$release/$archive_dir.tar.gz"
    AUTO_UPDATE_SOURCE_REL="$archive_dir"
    AUTO_UPDATE_SOURCE_BIN_REL="$archive_dir/dalfox"
    AUTO_UPDATE_VERSION="$release"
}

_dalfox_cache_dir="$(auto_update_platform_cache_dir "$HOME/.local/cache/dalfox")"
if auto_update_ensure_tar_app dalfox "$_dalfox_cache_dir" dalfox dalfox/dalfox 3 _dalfox_download; then
    exec "$_dalfox_cache_dir/dalfox/dalfox" "$@"
fi
exit 1
