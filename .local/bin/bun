#!/usr/bin/env bash
set -euo pipefail

_helper="${AUTO_UPDATE_APP_HELPER:-$HOME/.local/bin/auto-update-app.bash}"
if [ ! -r "$_helper" ]; then
    printf 'bun install failed: missing helper: %s\n' "$_helper" >&2
    exit 1
fi

. "$_helper"

_bun_resolve() {
    local os
    local arch
    local target
    local source_dir
    local tag

    case "$(auto_update_platform_os)" in
        darwin | linux)
            os="$(auto_update_platform_os)"
            ;;
        *)
            printf 'bun install failed: unsupported OS: %s\n' "$(uname -s)" >&2
            return 1
            ;;
    esac

    case "$(auto_update_platform_arch)" in
        x86_64)
            arch=x64
            ;;
        aarch64)
            arch=aarch64
            ;;
        *)
            printf 'bun install failed: unsupported architecture: %s\n' "$(uname -m)" >&2
            return 1
            ;;
    esac

    tag="$(auto_update_latest_release_tag oven-sh/bun)" || return 1
    target="$os-$arch"
    source_dir="bun-$target"
    AUTO_UPDATE_URL="https://github.com/oven-sh/bun/releases/download/$tag/$source_dir.zip"
    AUTO_UPDATE_SOURCE_REL="$source_dir"
    AUTO_UPDATE_SOURCE_BIN_REL="$source_dir/bun"
}

_cache_dir="$(auto_update_platform_cache_dir "${XDG_CACHE_HOME:-$HOME/.cache}/bun-bin")"
auto_update_ensure_zip_app bun "$_cache_dir" bun bun/bun 7 _bun_resolve https://github.com/oven-sh/bun
exec "$_cache_dir/bun/bun" "$@"
