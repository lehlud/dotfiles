#!/usr/bin/env bash

source "$HOME/.local/bin/auto-update-app.bash"

_murat_download() {
    local arch
    local os
    local release

    case "$(uname -m)" in
        x86_64 | amd64)
            arch=amd64
            ;;
        aarch64 | arm64)
            arch=arm64
            ;;
        i386 | i686)
            arch=386
            ;;
        armv*)
            arch=arm
            ;;
        riscv64)
            arch=riscv64
            ;;
        *)
            printf 'murat update failed: unsupported cpu arch: %s\n' "$(uname -m)" >&2
            return 2
            ;;
    esac

    case "$(uname -s)" in
        Linux)
            os=linux
            ;;
        Darwin)
            os=darwin
            ;;
        FreeBSD)
            os=freebsd
            ;;
        NetBSD)
            os=netbsd
            ;;
        OpenBSD)
            os=openbsd
            ;;
        DragonFly)
            os=dragonfly
            ;;
        *)
            printf 'murat update failed: unsupported system: %s\n' "$(uname -s)" >&2
            return 2
            ;;
    esac

    release="$(auto_update_latest_release_tag lehlud/murat)" || return 1

    AUTO_UPDATE_URL="https://github.com/lehlud/murat/releases/download/$release/$release-$os-$arch.tar.gz"
    AUTO_UPDATE_SOURCE_REL=murat
    AUTO_UPDATE_SOURCE_BIN_REL=murat
    AUTO_UPDATE_VERSION="$release"
}

_murat_cache_dir="$(auto_update_platform_cache_dir "$HOME/.local/cache/murat")"

if auto_update_ensure_tar_app murat "$_murat_cache_dir" murat murat 3 _murat_download; then
    exec "$_murat_cache_dir/murat" "$@"
fi

exit 1
