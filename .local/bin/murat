    references: list[str] | None = None
    attachments: list[DraftAttachment] | None = None


@dataclass
class SendIdentity:
    id: str
    email: str
    name: str


@dataclass
class JmapSession:
    api_url: str
    download_url: str | None
    upload_url: str | None
    capabilities: set[str]
    accounts: dict[str, dict[str, Any]]
    primary_accounts: dict[str, str]

    @property
    def primary_mail_account_id(self) -> str | None:
        if self.primary_accounts.get(CAP_MAIL):
            return self.primary_accounts[CAP_MAIL]
        for account_id, account in self.accounts.items():
            if CAP_MAIL in account_capabilities(account):
                return account_id
        return None


