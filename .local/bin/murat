class MuratError(Exception):
    pass


def enable_prompt_editing() -> None:
    global _PROMPT_EDITING_READY, _READLINE
    if _PROMPT_EDITING_READY:
        return
    _PROMPT_EDITING_READY = True
    try:
        import readline
    except ImportError:
        return
    _READLINE = readline
    for binding in (
        '"\\e[D": backward-char',
        '"\\e[C": forward-char',
        '"\\e[H": beginning-of-line',
        '"\\e[F": end-of-line',
    ):
        try:
            readline.parse_and_bind(binding)
        except Exception:
            pass


@dataclass(frozen=True)
class Paths:
    config_dir: Path
    config_file: Path
    data_dir: Path
    key_file: Path
    accounts_file: Path
    mail_file: Path
    search_file: Path


@dataclass
class Account:
    id: str
    name: str
    email: str
    username: str
    session_url: str
    auth_kind: str
    secret: str
    primary_mail_account_id: str | None = None
    created_at: str = ""
    updated_at: str = ""

    def auth_header(self) -> str:
        if self.auth_kind == "basic":
            token = base64.b64encode(f"{self.username}:{self.secret}".encode()).decode()
            return f"Basic {token}"
        return f"Bearer {self.secret}"

    def to_json(self) -> dict[str, Any]:
        return {
            "id": self.id,
            "name": self.name,
            "email": self.email,
            "username": self.username,
            "session_url": self.session_url,
            "auth_kind": self.auth_kind,
            "secret": self.secret,
            "primary_mail_account_id": self.primary_mail_account_id,
            "created_at": self.created_at,
            "updated_at": self.updated_at,
        }

    @classmethod
    def from_json(cls, value: dict[str, Any]) -> "Account":
        return cls(
            id=str(value.get("id", "")),
            name=str(value.get("name", "")),
            email=str(value.get("email", "")),
            username=str(value.get("username", "")),
            session_url=str(value.get("session_url", "")),
            auth_kind=str(value.get("auth_kind", "bearer")),
            secret=str(value.get("secret", "")),
            primary_mail_account_id=value.get("primary_mail_account_id") or None,
            created_at=str(value.get("created_at", "")),
            updated_at=str(value.get("updated_at", "")),
        )


@dataclass
class DraftAttachment:
    name: str
    content_type: str
    data: bytes


@dataclass
