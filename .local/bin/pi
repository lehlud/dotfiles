#!/usr/bin/env bash

_helper="${AUTO_UPDATE_APP_HELPER:-$HOME/.local/bin/auto-update-app.bash}"
if [ ! -r "$_helper" ]; then
    printf 'pi install failed: missing helper: %s\n' "$_helper" >&2
    exit 1
fi
source "$_helper"

_pi_download() {
    local os
    local arch
    local release

    case "$(auto_update_platform_os)" in
        linux | darwin)
            os="$(auto_update_platform_os)"
            ;;
        *)
            printf 'pi install failed: unsupported system: %s\n' "$(uname -s)" >&2
            return 2
            ;;
    esac

    case "$(auto_update_platform_arch)" in
        x86_64)
            arch=x64
            ;;
        aarch64)
            arch=arm64
            ;;
        *)
            printf 'pi install failed: unsupported cpu arch: %s\n' "$(uname -m)" >&2
            return 2
            ;;
    esac

    release="$(auto_update_latest_release_tag earendil-works/pi)" || return 1

    AUTO_UPDATE_URL="https://github.com/earendil-works/pi/releases/download/$release/pi-$os-$arch.tar.gz"
    AUTO_UPDATE_SOURCE_REL=pi
    AUTO_UPDATE_SOURCE_BIN_REL=pi/pi
    AUTO_UPDATE_VERSION="$release"
}

_pi_cache_dir="$(auto_update_platform_cache_dir "$HOME/.local/cache/pi")"

# Mandatory review: only the configured operator extensions may be loaded.
# Model actions run in its isolated executor, never in this host shell.
for _arg in "$@"; do
    case "$_arg" in
        -e|--extension|--extension=*|-a|--approve|--tools|--tools=*|-t|--exclude-tools|--exclude-tools=*|-xt)
            printf 'pi: this option conflicts with mandatory Auto-Approval: %s\n' "$_arg" >&2
            exit 2
            ;;
    esac
done

_gate="$HOME/.pi/agent/extensions/auto-approval/index.ts"
_web="$HOME/.pi/agent/extensions/web-research/index.ts"
_writing="$HOME/.pi/agent/extensions/public-writing/index.ts"
_conversations="$HOME/.pi/agent/extensions/conversations/index.ts"
_multiplex="$HOME/.pi/agent/extensions/multiplex/index.ts"
_recovery="$HOME/.pi/agent/extensions/provider-recovery/index.ts"
_code_quality="$HOME/.pi/agent/extensions/code-quality/index.ts"
_fast="$HOME/.pi/agent/extensions/fast-mode/index.ts"
_models="$HOME/.pi/agent/extensions/model-selection/index.ts"
_subagents="$HOME/.pi/agent/extensions/subagents/index.ts"
_context="$HOME/.pi/agent/extensions/context-management/index.ts"
if [ ! -r "$_gate" ]; then
    printf 'pi: mandatory approval gate is missing; startup blocked\n' >&2
    exit 1
fi
if [ ! -r "$_web" ]; then
    printf 'pi: web-research extension is missing; startup blocked\n' >&2
    exit 1
fi
if [ ! -r "$_writing" ]; then
    printf 'pi: public-writing extension is missing; startup blocked\n' >&2
    exit 1
fi
for _extension in "$_conversations" "$_multiplex" "$_recovery" "$_code_quality" "$_fast" "$_models" "$_subagents" "$_context"; do
    if [ ! -r "$_extension" ]; then
        printf 'pi: required extension is missing: %s; startup blocked\n' "$_extension" >&2
        exit 1
    fi
done

# Bootstrap and update on operator startup, before any agent tools run.
# Pi's cache, launcher and approval gate remain protected inside the sandbox.
if auto_update_ensure_tar_app pi "$_pi_cache_dir" pi pi/pi 3 _pi_download https://github.com/earendil-works/pi; then
    if ! command -v bun >/dev/null 2>&1; then
        printf 'pi: Bun is required to prepare Auto-Approval; startup blocked\n' >&2
        exit 1
    fi
    if ! bun "${_web%/*}/bootstrap.ts" >&2; then
        exit 1
    fi
    if ! bun "${_writing%/*}/bootstrap.ts" >&2; then
        exit 1
    fi
    if ! bun "${_gate%/*}/bootstrap.ts" >&2; then
        exit 1
    fi
    exec "$_pi_cache_dir/pi/pi" \
        --no-extensions \
        --extension "$_models" \
        --extension "$_gate" \
        --extension "$_web" \
        --extension "$_writing" \
        --extension "$_conversations" \
        --extension "$_multiplex" \
        --extension "$_recovery" \
        --extension "$_code_quality" \
        --extension "$_fast" \
        --extension "$_subagents" \
        --extension "$_context" \
        --no-approve \
        --tools approved_action,mailbox,set_goal,ask_user,user_questions,subagent,history,notes,new_context \
        "$@"
fi

exit 1
