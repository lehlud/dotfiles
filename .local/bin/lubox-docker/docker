#!/usr/bin/env bash

_docker_find_original() {
  local dir
  local candidate
  local candidate_dir
  local candidate_path
  local self_dir
  local self_path
  local IFS=:

  self_dir="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)" || return 1
  self_path="$self_dir/$(basename -- "${BASH_SOURCE[0]}")"

  for dir in $PATH; do
    [ -n "$dir" ] || dir=.
    candidate="$dir/docker"
    [ -x "$candidate" ] || continue

    candidate_dir="$(cd -P -- "$(dirname -- "$candidate")" 2>/dev/null && pwd)" || continue
    candidate_path="$candidate_dir/$(basename -- "$candidate")"
    [ "$candidate_path" = "$self_path" ] && continue

    printf '%s\n' "$candidate_path"
    return 0
  done

  return 1
}

_docker_host_exec() {
  local lubox_bin="$1"
  local name
  local -a forwarded_env=()
  shift

  # lubox host-exec intentionally filters process environment variables. Pass
  # only the variables interpolated by this workspace's Compose configuration.
  for name in HTTP_PORT CONTAINER_SOCKET SHIBBOLETH_EXTERNAL_URL SHIBBOLETH_SP_HOSTNAME; do
    if [[ -v "$name" ]]; then
      forwarded_env+=("$name=${!name}")
    fi
  done

  if ((${#forwarded_env[@]})); then
    exec "$lubox_bin" host-exec env "${forwarded_env[@]}" docker "$@"
  fi

  exec "$lubox_bin" host-exec docker "$@"
}

_docker_original="$(_docker_find_original)" || {
  _docker_original=
}

if [ -n "${LUBOX_CONTAINER_NAME:-}" ]; then
  if [ "${LUBOX_HOST_EXEC:-0}" = 1 ]; then
    if [ -x /usr/local/bin/lubox ]; then
      _docker_host_exec /usr/local/bin/lubox "$@"
    fi

    if command -v lubox >/dev/null 2>&1; then
      _docker_host_exec lubox "$@"
    fi

    printf 'docker wrapper failed: lubox command not found for host-exec\n' >&2
    exit 127
  fi

  printf 'docker wrapper failed: lubox host-exec is disabled for this container\n' >&2
  exit 126
fi

if [ -n "${CONTAINER_ID:-}" ]; then
  if [ -n "$_docker_original" ] && [ -x /usr/bin/distrobox-host-exec ]; then
    exec /usr/bin/distrobox-host-exec "$_docker_original" "$@"
  fi

  printf 'docker wrapper failed: distrobox host exec unavailable\n' >&2
  exit 127
elif [ -n "$_docker_original" ]; then
  exec "$_docker_original" "$@"
else
  printf 'docker wrapper failed: original docker not found in PATH\n' >&2
  exit 127
fi
