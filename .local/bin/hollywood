#!/usr/bin/env bash

_helper="${AUTO_UPDATE_APP_HELPER:-$HOME/.local/bin/auto-update-app.bash}"
if [ ! -r "$_helper" ]; then
    printf 'hollywood: missing auto-update helper: %s\n' "$_helper" >&2
    exit 1
fi
source "$_helper"

case "${1:-}" in
    -h | --help)
        printf '%s\n' 'Usage: hollywood [-s|--splits COUNT] [-d|--delay SECONDS]' \
            'Stop with Ctrl+C; if a shell remains, type exit.'
        exit 0
        ;;
esac

_image=cgr.dev/chainguard/hollywood:latest
_cache_dir="$(auto_update_platform_cache_dir "$HOME/.local/cache/hollywood")"
if ! auto_update_ensure_docker_image hollywood "$_image" "$_cache_dir" 3; then
    exit 1
fi

_tty=(-i)
if [ -t 0 ] && [ -t 1 ]; then
    _tty=(-it)
fi
exec docker run "${_tty[@]}" --rm --init \
    --env "TERM=${TERM:-xterm-256color}" "$_image" "$@"
