#!/usr/bin/env bash

set -euo pipefail

umask 077

die() {
    printf 'add-private-ssh-key: %s\n' "$*" >&2
    exit 1
}

for command_name in ssh-keygen ssh-add ssh-agent cksum install mktemp; do
    command -v "$command_name" >/dev/null 2>&1 ||
        die "required command not found: $command_name"
done

ssh_dir=${HOME:?HOME is not set}/.ssh
mkdir -p "$ssh_dir"
chmod 700 "$ssh_dir"

temporary_key=$(mktemp "${TMPDIR:-/tmp}/add-private-ssh-key.XXXXXXXX")
temporary_pub=${temporary_key}.pub
echo_was_disabled=0

cleanup() {
    if ((echo_was_disabled)); then
        stty echo </dev/tty 2>/dev/null || true
        printf '\n' >/dev/tty 2>/dev/null || true
    fi
    rm -f -- "$temporary_key" "$temporary_pub"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [[ -t 0 ]]; then
    printf '%s\n' \
        'Paste the ASCII private key, then press Ctrl-D on a new line.' \
        '(Input is hidden.)' >&2
    stty -echo </dev/tty
    echo_was_disabled=1
fi

cat >"$temporary_key"

if ((echo_was_disabled)); then
    stty echo </dev/tty
    echo_was_disabled=0
    printf '\n' >/dev/tty
fi

[[ -s $temporary_key ]] || die 'no private key was provided'
chmod 600 "$temporary_key"

printf 'Validating key and deriving its public key...\n' >&2
if ! ssh-keygen -y -f "$temporary_key" >"$temporary_pub"; then
    die 'input is not a valid private SSH key (or its passphrase was incorrect)'
fi

fingerprint_line=$(ssh-keygen -lf "$temporary_pub" -E sha256) ||
    die 'could not fingerprint the public key'
fingerprint=${fingerprint_line#* }
fingerprint=${fingerprint%% *}
[[ $fingerprint == SHA256:* ]] || die 'ssh-keygen returned an unexpected fingerprint'

# This compact in-script dictionary encodes 100 x 100 = 10,000 distinct
# compound words.  Indexing it avoids carrying a much larger 10,000-line blob.
read -r -a word_left <<'WORDS'
amber ancient apple arctic autumn azure bamboo beacon birch blue bold brass breeze bright bronze brook cedar cherry cipher clear cloud coral cosmic cotton crystal dawn deep delta desert dusk eager earth ember emerald fern fire flint floral forest frost gentle glass golden grand green harbor hazel hidden hollow honey indigo iron ivory jade keen lake lemon light lilac little lunar maple marble meadow mellow misty moon moss noble north ocean olive opal orange orchid pale pearl pine polar quiet rapid raven red river royal ruby sage scarlet shadow silver sky solar spring star stone storm summer sunny swift teal
WORDS
read -r -a word_right <<'WORDS'
anchor badger bay bear bell bird bloom bolt branch bridge brook cabin canyon cedar cloud comet cove crane creek crown dawn deer dove dream dune eagle elm ember falcon feather field finch flame forest fox frost garden gate glade glow grove harbor hawk hill island ivy lake lantern leaf lion maple marsh meadow moon moth mountain oak ocean otter owl panda path peak pine pond quartz rain raven reef ridge river robin rock rose sail seal shell shore sky snow sparrow spring star stone storm sun tiger trail tree valley wave whale willow wind wing wolf wood wren yard zephyr
WORDS

[[ ${#word_left[@]} -eq 100 && ${#word_right[@]} -eq 100 ]] ||
    die 'internal dictionary is corrupt'

read -r fingerprint_number _ < <(printf '%s' "$fingerprint" | cksum)
dictionary_index=$((fingerprint_number % 10000))
suffix_number=$(((fingerprint_number / 10000) % 100))
left_index=$((dictionary_index / 100))
right_index=$((dictionary_index % 100))
printf -v key_name '%s%s%02d' \
    "${word_left[left_index]}" "${word_right[right_index]}" "$suffix_number"

key_path=$ssh_dir/$key_name
pub_path=${key_path}.pub
installed=0

if [[ -e $key_path || -e $pub_path ]]; then
    if [[ -f $key_path && -f $pub_path ]]; then
        existing_line=$(ssh-keygen -lf "$pub_path" -E sha256 2>/dev/null || true)
        existing_fingerprint=${existing_line#* }
        existing_fingerprint=${existing_fingerprint%% *}
        if [[ $existing_fingerprint == "$fingerprint" ]]; then
            printf 'Key is already installed as %s.\n' "$key_path" >&2
        else
            die "deterministic name collision at $key_path; nothing was overwritten"
        fi
    else
        die "only one of $key_path and $pub_path exists; nothing was overwritten"
    fi
else
    install -m 600 "$temporary_key" "$key_path"
    install -m 644 "$temporary_pub" "$pub_path"
    installed=1
fi

agent_status=0
ssh-add -l >/dev/null 2>&1 || agent_status=$?
started_agent=0

if ((agent_status == 2)); then
    printf 'No usable ssh-agent found; starting one...\n' >&2
    agent_output=$(ssh-agent -s) || die 'could not start ssh-agent'
    eval "$agent_output" >/dev/null
    started_agent=1

    agent_env=$ssh_dir/agent.env
    {
        printf '# Generated by add-private-ssh-key\n'
        printf 'export SSH_AUTH_SOCK=%q\n' "$SSH_AUTH_SOCK"
        printf 'export SSH_AGENT_PID=%q\n' "$SSH_AGENT_PID"
    } >"$agent_env"
    chmod 600 "$agent_env"
fi

printf 'Adding key to ssh-agent...\n' >&2
if ! ssh-add "$key_path"; then
    if ((started_agent)); then
        ssh-agent -k >/dev/null 2>&1 || true
        rm -f -- "$ssh_dir/agent.env"
    fi
    die 'the key was installed, but ssh-add failed'
fi

if ((installed)); then
    printf 'Installed private key: %s\n' "$key_path"
    printf 'Installed public key:  %s\n' "$pub_path"
else
    printf 'Using private key:     %s\n' "$key_path"
    printf 'Using public key:      %s\n' "$pub_path"
fi
printf 'Fingerprint:           %s\n' "$fingerprint"

if ((started_agent)); then
    printf 'Started ssh-agent. In other shells, run:\n'
    printf '  source %q\n' "$ssh_dir/agent.env"
fi
