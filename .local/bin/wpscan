#!/usr/bin/env bash
set -euo pipefail

source "$HOME/.local/bin/auto-update-app.bash"

image="${WPSCAN_IMAGE:-docker.io/wpscanteam/wpscan:latest}"
db_volume="${WPSCAN_DB_VOLUME:-wpscan-db}"
update_days="${WPSCAN_AUTO_UPDATE_DAYS:-3}"
force_update="${WPSCAN_FORCE_UPDATE:-0}"
auto_update="${WPSCAN_AUTO_UPDATE:-1}"

case "$update_days" in
    '' | *[!0-9]*)
        printf 'wpscan: WPSCAN_AUTO_UPDATE_DAYS must be a non-negative integer\n' >&2
        exit 2
        ;;
esac

find_engine() {
    if [ -n "${WPSCAN_ENGINE:-}" ]; then
        case "$WPSCAN_ENGINE" in
            podman | docker)
                if command -v "$WPSCAN_ENGINE" >/dev/null 2>&1; then
                    printf '%s\n' "$WPSCAN_ENGINE"
                    return 0
                fi
                printf 'wpscan: requested container engine not found: %s\n' "$WPSCAN_ENGINE" >&2
                return 1
                ;;
            *)
                printf 'wpscan: WPSCAN_ENGINE must be podman or docker\n' >&2
                return 1
                ;;
        esac
    fi

    if command -v podman >/dev/null 2>&1; then
        printf '%s\n' podman
    elif command -v docker >/dev/null 2>&1; then
        printf '%s\n' docker
    else
        printf 'wpscan: podman or docker is required\n' >&2
        return 1
    fi
}

engine="$(find_engine)" || exit 127
image_cache_key="${image//[^A-Za-z0-9_.-]/_}"
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/wpscan/launcher/$image_cache_key"
image_marker="$cache_root/.image-updated"
database_marker="$cache_root/.database-updated"
update_lock="$cache_root/update.lock"
mkdir -p "$cache_root"

image_available() {
    "$engine" image inspect "$image" >/dev/null 2>&1
}

auto_update_enabled() {
    case "$auto_update" in
        0 | no | false | never)
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

update_forced() {
    case "$force_update" in
        1 | yes | true | always)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

database_update() {
    local -a args=(run --rm -v "$db_volume:/wpscan/.cache/wpscan/db")
    if [ "$engine" = podman ]; then
        args+=(--security-opt label=disable)
    fi
    args+=("$image" --update)
    _auto_update_run_with_progress 'wpscan database update' "$engine" "${args[@]}"
}

refresh_installation() {
    local need_image=0
    local need_database=0
    local had_image=0
    local had_database=0

    if image_available; then
        had_image=1
    else
        need_image=1
    fi
    [ -e "$database_marker" ] && had_database=1

    if update_forced; then
        need_image=1
        need_database=1
    elif auto_update_enabled; then
        auto_update_is_stale "$image_marker" "$update_days" && need_image=1
        auto_update_is_stale "$database_marker" "$update_days" && need_database=1
    elif [ "$had_database" -eq 0 ]; then
        need_database=1
    fi

    if [ "$need_image" -eq 1 ]; then
        if _auto_update_run_with_progress 'wpscan image update' "$engine" pull "$image"; then
            touch "$image_marker"
            had_image=1
            need_database=1
        elif [ "$had_image" -eq 0 ]; then
            printf 'wpscan install failed: could not pull %s\n' "$image" >&2
            return 1
        else
            printf 'wpscan update warning: using the existing image\n' >&2
        fi
    fi

    if [ "$need_database" -eq 1 ]; then
        if database_update; then
            touch "$database_marker"
            had_database=1
        elif [ "$had_database" -eq 0 ]; then
            printf 'wpscan install failed: could not initialize its local database\n' >&2
            return 1
        else
            printf 'wpscan update warning: using the existing local database\n' >&2
        fi
    fi
}

refresh_with_lock() {
    if command -v flock >/dev/null 2>&1; then
        (
            if ! flock -w 300 9; then
                printf 'wpscan update warning: timed out waiting for another update\n' >&2
                image_available
                exit $?
            fi
            refresh_installation
        ) 9>"$update_lock"
    else
        refresh_installation
    fi
}

refresh_with_lock || exit 1

workdir="$(pwd -P)"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/wpscan"
run_args=(run --rm -i -w "$workdir")

if [ -t 0 ] && [ -t 1 ]; then
    run_args+=(--tty)
fi
if [ "$engine" = podman ]; then
    run_args+=(--security-opt label=disable)
fi
if [ -n "${WPSCAN_CONTAINER_NETWORK:-}" ]; then
    run_args+=(--network "$WPSCAN_CONTAINER_NETWORK")
fi

run_args+=(
    -v "$db_volume:/wpscan/.cache/wpscan/db"
    -v "$workdir:$workdir:ro"
)

if [ -d "$config_dir" ]; then
    run_args+=(-v "$config_dir:/wpscan/.config/wpscan:ro")
fi

for variable in \
    WPSCAN_API_TOKEN WPSCAN_ENTERPRISE_DB_TOKEN \
    HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY \
    http_proxy https_proxy all_proxy no_proxy
do
    if [ -n "${!variable+x}" ]; then
        run_args+=(--env "$variable")
    fi
done

run_args+=("$image")
exec "$engine" "${run_args[@]}" "$@"
