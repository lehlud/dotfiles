CODE_SERVER_INSTALL_SCRIPT = r'''
import json
import os
import pathlib
import platform
import shutil
import tarfile
import tempfile
import urllib.request

arch_map = {"x86_64": "amd64", "amd64": "amd64", "aarch64": "arm64", "arm64": "arm64"}
arch = arch_map.get(platform.machine().lower())
if not arch:
    raise SystemExit(f"unsupported code-server architecture: {platform.machine()}")
base = pathlib.Path.home() / ".local" / "share" / "lubox" / "code-server"
base.mkdir(parents=True, exist_ok=True)
req = urllib.request.Request(
    "https://api.github.com/repos/coder/code-server/releases/latest",
    headers={"User-Agent": "lubox"},
)
with urllib.request.urlopen(req, timeout=30) as resp:
    release = json.loads(resp.read().decode("utf-8"))
tag = str(release.get("tag_name") or "").strip()
if not tag:
    raise SystemExit("latest code-server release has no tag_name")
asset = None
suffix = f"linux-{arch}.tar.gz"
for item in release.get("assets") or []:
    name = str(item.get("name") or "")
    url = str(item.get("browser_download_url") or "")
    if name.endswith(suffix) and url:
        asset = (name, url)
        break
if asset is None:
    raise SystemExit(f"no code-server release asset found for {suffix}")
install_dir = base / tag
bin_path = install_dir / "bin" / "code-server"
if not bin_path.exists():
    if install_dir.exists():
        shutil.rmtree(install_dir)
    with tempfile.TemporaryDirectory(prefix="lubox-code-server-") as td:
        tmp = pathlib.Path(td)
        archive = tmp / asset[0]
        req = urllib.request.Request(asset[1], headers={"User-Agent": "lubox"})
        with urllib.request.urlopen(req, timeout=120) as resp, archive.open("wb") as f:
            shutil.copyfileobj(resp, f)
        extract_dir = tmp / "extract"
        extract_dir.mkdir()
        with tarfile.open(archive, "r:gz") as tf:
            for member in tf.getmembers():
                target = (extract_dir / member.name).resolve()
                if not str(target).startswith(str(extract_dir.resolve()) + os.sep):
                    raise SystemExit(f"unsafe path in code-server archive: {member.name}")
            tf.extractall(extract_dir)
        roots = [p for p in extract_dir.iterdir() if p.is_dir() and (p / "bin" / "code-server").exists()]
        if not roots:
            raise SystemExit("code-server archive did not contain bin/code-server")
        shutil.move(str(roots[0]), str(install_dir))
current = base / "current"
try:
    if current.is_symlink() or current.exists():
        if current.is_dir() and not current.is_symlink():
            shutil.rmtree(current)
        else:
            current.unlink()
    current.symlink_to(install_dir, target_is_directory=True)
except OSError:
    pass
print(str(bin_path))
'''
CODE_SERVER_CONNECT_SCRIPT = r'''
import os
import select
import socket
import sys

target_port = int(sys.argv[1])
sock = socket.create_connection(("127.0.0.1", target_port), timeout=10)
sock.setblocking(False)
stdin_open = True
try:
    while True:
        readers = [sock]
        if stdin_open:
            readers.append(0)
        ready, _, _ = select.select(readers, [], [])
        if 0 in ready:
            data = os.read(0, 65536)
            if data:
                sock.sendall(data)
            else:
                stdin_open = False
                try:
                    sock.shutdown(socket.SHUT_WR)
                except OSError:
                    pass
        if sock in ready:
            data = sock.recv(65536)
            if not data:
                break
            os.write(1, data)
finally:
    sock.close()
'''
XDG_OPEN_SCRIPT = r'''#!/bin/sh
# lubox xdg-open shim. Inside containers, open targets on host.

usage()
{
    cat <<'EOF'
Usage: xdg-open { file | URL }
       xdg-open { --help | --manual | --version }

Opens a file or URL in the user's preferred application.
EOF
}

host_os="${LUBOX_HOST_OS:-}"
if [ -z "$host_os" ]; then
    case "$(uname -s)" in
        Darwin) host_os=darwin ;;
        Linux) host_os=linux ;;
        *) host_os="$(uname -s | tr '[:upper:]' '[:lower:]')" ;;
    esac
fi

host_os="$(printf '%s' "$host_os" | tr '[:upper:]' '[:lower:]')"

system_xdg_open()
{
    self="$0"
    case "$self" in
        /*) ;;
        */*) self="$(pwd -P)/$self" ;;
        *) self="$(command -v -- "$self" 2>/dev/null || printf '%s\n' "$self")" ;;
    esac

    old_ifs=$IFS
    IFS=:
    for dir in $PATH; do
        [ -n "$dir" ] || dir=.
        candidate="$dir/xdg-open"
        [ -x "$candidate" ] || continue
        case "$candidate" in
            /*) abs="$candidate" ;;
            *) abs="$(pwd -P)/$candidate" ;;
        esac
        if [ "$abs" = "$self" ] || [ "$candidate" = "$0" ]; then
            continue
        fi
        printf '%s\n' "$candidate"
        IFS=$old_ifs
        return 0
    done
    IFS=$old_ifs
    return 1
}

if [ -z "${LUBOX_CONTAINER_NAME:-}" ] && [ "$host_os" = linux ]; then
    xdg_open="$(system_xdg_open)" || {
        printf 'xdg-open: no system xdg-open found\n' >&2
        exit 3
    }
    exec "$xdg_open" "$@"
fi

case "${1:-}" in
    --help)
        usage
        exit 0
        ;;
    --manual)
        if command -v man >/dev/null 2>&1; then
            exec man xdg-open
        fi
        usage
        exit 0
        ;;
    --version)
        printf '%s\n' 'xdg-open lubox-host-bridge'
        exit 0
        ;;
    --*)
        printf 'xdg-open: unexpected option: %s\n' "$1" >&2
        usage >&2
        exit 1
        ;;
esac

if [ "$#" -ne 1 ]; then
    usage >&2
    exit 1
fi

target=$1

if [ -n "${LUBOX_CONTAINER_NAME:-}" ]; then
    if [ "${LUBOX_HOST_EXEC:-1}" = 0 ]; then
        printf 'xdg-open: lubox host-exec disabled for this container\n' >&2
        exit 3
    fi
    case "$host_os" in
        darwin | macos)
            exec /usr/local/bin/lubox host-exec open "$target"
            ;;
        linux)
            exec /usr/local/bin/lubox host-exec xdg-open "$target"
            ;;
        *)
            printf 'xdg-open: unsupported host OS: %s\n' "$host_os" >&2
            exit 3
            ;;
    esac
fi

case "$host_os" in
    darwin | macos)
        exec open "$target"
        ;;
    linux)
        xdg_open="$(system_xdg_open)" || {
            printf 'xdg-open: no system xdg-open found\n' >&2
            exit 3
        }
        exec "$xdg_open" "$target"
        ;;
    *)
        printf 'xdg-open: unsupported host OS: %s\n' "$host_os" >&2
        exit 3
        ;;
esac
'''
ENTER_PREFLIGHT_SCRIPT = r'''
import json, os, pathlib, stat, subprocess, sys

uid = int(sys.argv[1])
want_host = sys.argv[2] == "1"
want_ssh = sys.argv[3] == "1"
want_gpg = sys.argv[4] == "1"
cfg_path = pathlib.Path(os.environ.get("LUBOX_HOSTEXEC_CONFIG", "/run/lubox/hostexec.json"))

def fail(message):
    print(message, file=sys.stderr)
    raise SystemExit(1)

def is_socket(path):
    try:
        return stat.S_ISSOCK(pathlib.Path(path).stat().st_mode)
    except OSError:
        return False

def pid_running(pid_file):
    try:
        text = pathlib.Path(pid_file).read_text(encoding="utf-8").strip()
        pid = int(text)
    except (OSError, ValueError):
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True

cfg = {}
if want_host or want_ssh or want_gpg:
    try:
        cfg = json.loads(cfg_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        fail(f"hostexec config unavailable: {exc}")

if want_host:
    if not cfg.get("enabled"):
        fail("hostexec server disabled")
    cp = subprocess.run(["/usr/local/bin/lubox", "__hostexec-probe"], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    if cp.returncode != 0:
        fail(cp.stderr.strip() or f"hostexec probe failed: {cp.returncode}")

if want_ssh:
    ssh = cfg.get("ssh_agent")
    if not isinstance(ssh, dict) or not ssh.get("enabled"):
        fail("SSH agent proxy disabled")
    sock = str(ssh.get("socket_path") or f"/tmp/lubox-{uid}/ssh-agent.sock")
    pid = f"/tmp/lubox-{uid}/ssh-agent.pid"
    if not pid_running(pid) or not is_socket(sock):
        fail("SSH agent proxy not running")

if want_gpg:
    gpg = cfg.get("gpg_agent")
    sockets = gpg.get("sockets") if isinstance(gpg, dict) else None
    if not isinstance(gpg, dict) or not gpg.get("enabled") or not isinstance(sockets, dict) or not sockets:
        fail("GPG agent proxy disabled")
    pid = f"/tmp/lubox-{uid}/gpg-agent-proxy.pid"
    if not pid_running(pid):
        fail("GPG agent proxy not running")
    for key in sorted(sockets):
        item = sockets.get(key)
        if not isinstance(item, dict):
            fail(f"GPG proxy socket config invalid: {key}")
        sock = str(item.get("socket_path") or "")
        if not sock or not is_socket(sock):
            fail(f"GPG proxy socket missing: {key}")
'''


class LuboxError(Exception):
    def __init__(self, message: str, code: int = 1):
        super().__init__(message)
        self.code = code


class CommandError(LuboxError):
    def __init__(self, argv: Sequence[str], returncode: int, stderr: object = ""):
        self.argv = list(argv)
        self.returncode = returncode
        self.stderr = _decode_output(stderr)
        message = f"lubox: command failed ({returncode}): {shlex.join(self.argv)}"
        if self.stderr:
            message += f"\nstderr:\n{self.stderr.rstrip()}"
        super().__init__(message, 1)


class Progress:
    FRAMES = "-/|\\"

    def __init__(self, title: str, total: int):
        self.title = title
        self.total = max(1, total)
        self.current = 0
        self.label = ""
        self.detail_text = ""
        self.start_time = time.monotonic()
        self.last_draw = 0.0
        self.last_len = 0
        self.frame_index = 0
        self.enabled = sys.stderr.isatty()

    def begin(self, label: str, detail: str = "") -> None:
        self.current = min(self.total, self.current + 1)
        self.label = label
        self.detail_text = self.clean_detail(detail)
        if self.enabled:
            self.draw(force=True)
        else:
            eprint(f"lubox: [{self.current}/{self.total}] {label}")

    def detail(self, text: str) -> None:
        text = self.clean_detail(text)
        if not text:
            return
        self.detail_text = text
        self.draw()

    def pulse(self) -> None:
        self.draw()

    def finish(self, message: str = "done") -> None:
        if self.enabled:
            self.current = self.total
            self.label = message
            self.detail_text = ""
            self.draw(force=True, finished=True)
            sys.stderr.write("\n")
            sys.stderr.flush()
        else:
            eprint(f"lubox: {message}")

    def fail(self, message: str = "failed") -> None:
        if self.enabled:
            self.clear()
        eprint(f"lubox: {self.title}: {message} at {self.label or 'start'}")

    def draw(self, *, force: bool = False, finished: bool = False) -> None:
        if not self.enabled:
            return
        now = time.monotonic()
        if not force and now - self.last_draw < 0.08:
            return
        self.last_draw = now
        width = 28
        completed = self.total if finished else max(0, self.current - 1)
        filled = width if finished else int(width * completed / self.total)
        if finished:
            bar = "#" * width
            frame = " "
        else:
            bar_chars = ["#"] * filled + ["-"] * (width - filled)
            if filled < width:
                bar_chars[filled] = self.FRAMES[self.frame_index % len(self.FRAMES)]
            bar = "".join(bar_chars)
            frame = self.FRAMES[self.frame_index % len(self.FRAMES)]
            self.frame_index += 1
        elapsed = int(now - self.start_time)
        detail = f" | {self.detail_text}" if self.detail_text else ""
        line = f"{self.title} [{bar}] {self.current}/{self.total} {frame} {elapsed:02d}s {self.label}{detail}"
        columns = shutil.get_terminal_size(fallback=(120, 24)).columns
        if len(line) >= columns:
            line = line[: max(0, columns - 1)]
        pad = " " * max(0, self.last_len - len(line))
        sys.stderr.write("\r" + line + pad)
        sys.stderr.flush()
        self.last_len = len(line)

    def clear(self) -> None:
        if self.last_len:
            sys.stderr.write("\r" + " " * self.last_len + "\r")
            sys.stderr.flush()
            self.last_len = 0

    def clean_detail(self, text: str) -> str:
        text = text.replace("\r", " ").replace("\n", " ").strip()
        if len(text) > 96:
            text = text[:93] + "..."
        return text


def color_enabled(stream: object = None) -> bool:
    mode = os.environ.get("LUBOX_COLOR", "auto").lower()
    if mode in ("never", "no", "0", "false") or os.environ.get("NO_COLOR"):
        return False
    if mode in ("always", "yes", "1", "true"):
        return True
    target = stream if stream is not None else sys.stdout
    return bool(getattr(target, "isatty", lambda: False)()) and os.environ.get("TERM") != "dumb"


def ansi(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m"


def color_token_line(line: str, code: str) -> str:
    indent_len = len(line) - len(line.lstrip())
    stripped = line[indent_len:]
    if not stripped:
        return line
    token_end = len(stripped)
    for idx, ch in enumerate(stripped):
        if ch.isspace():
            token_end = idx
            break
    token = stripped[:token_end]
    return line[:indent_len] + ansi(code, token) + stripped[token_end:]


def color_help_text(text: str) -> str:
    if not color_enabled(sys.stdout):
        return text
    out: List[str] = []
    headings = {"positional arguments:", "optional arguments:", "examples:"}
    for line in text.splitlines():
        stripped = line.strip()
        indent_len = len(line) - len(line.lstrip())
        if line.startswith("usage:"):
            out.append(ansi("1;36", "usage:") + line[len("usage:"):])
        elif stripped in headings:
            out.append(ansi("1;34", line))
        elif line.startswith("  lubox "):
            out.append(line.replace("lubox", ansi("1;32", "lubox"), 1))
        elif indent_len == 2 and stripped.startswith("-"):
            out.append(color_token_line(line, "1;33"))
        elif indent_len == 4 and stripped and not stripped.startswith("="):
            out.append(color_token_line(line, "1;32"))
        else:
            out.append(line)
    if text.endswith("\n"):
        return "\n".join(out) + "\n"
    return "\n".join(out)


class LuboxHelpFormatter(argparse.RawDescriptionHelpFormatter):
    def format_help(self) -> str:
        return color_help_text(super().format_help())


class LuboxArgumentParser(argparse.ArgumentParser):
    def __init__(self, *args: Any, **kwargs: Any):
        kwargs.setdefault("formatter_class", LuboxHelpFormatter)
        super().__init__(*args, **kwargs)


def _decode_output(value: object) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", "replace")
    return str(value)


def eprint(*args: object) -> None:
    print(*args, file=sys.stderr)


def die(message: str, code: int = 1) -> None:
    raise LuboxError(message, code)


def is_linux() -> bool:
    return platform.system() == "Linux"


def is_macos() -> bool:
    return platform.system() == "Darwin"


def host_os_name() -> str:
    if is_macos():
        return "darwin"
    if is_linux():
        return "linux"
    return platform.system().lower()


def strip_dashdash(argv: Sequence[str]) -> List[str]:
    args = list(argv)
    if args and args[0] == "--":
        return args[1:]
    return args


def validate_box_name(name: str) -> None:
    allowed = set("abcdefghijklmnopqrstuvwxyz0123456789_.-")
    if not name:
        die("lubox: NAME must not be empty")
    if name[0] not in set("abcdefghijklmnopqrstuvwxyz0123456789"):
        die("lubox: NAME must start with lowercase letter or digit")
    if any(ch not in allowed for ch in name):
        die("lubox: NAME may contain only lowercase letters, digits, '.', '_', '-' ")


def validate_safe_word(label: str, value: str) -> None:
    allowed = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.+-")
    if not value or value[0] == "-" or any(ch not in allowed for ch in value):
        die(f"lubox: unsafe {label!s}: {value!r}")


def validate_image_ref(image: str) -> None:
    if not image or any(ch.isspace() for ch in image) or "\n" in image or "\r" in image:
        die(f"lubox: invalid image reference: {image!r}")


def current_username() -> str:
    return pwd.getpwuid(os.getuid()).pw_name


def container_name(name: str) -> str:
    return f"lubox-{current_username()}-{name}"


def image_name(name: str) -> str:
    return f"lubox/{name}:latest"


def secret_name(name: str) -> str:
    safe = []
    for ch in name:
        if ch.isalnum() or ch in "_.-":
            safe.append(ch)
        else:
            safe.append("_")
    return "lubox_" + "".join(safe) + "_hostexec_token"


def container_ssh_auth_sock(uid: Optional[int] = None) -> str:
    if uid is None:
        uid = os.getuid()
    return CONTAINER_SSH_AUTH_SOCK_TEMPLATE.format(uid=uid)


def container_ssh_agent_pid(uid: Optional[int] = None) -> str:
    if uid is None:
        uid = os.getuid()
    return CONTAINER_SSH_AGENT_PID_TEMPLATE.format(uid=uid)


def container_gpg_home(uid: Optional[int] = None) -> str:
    if uid is None:
        uid = os.getuid()
    return CONTAINER_GPG_HOME_TEMPLATE.format(uid=uid)


def container_gpg_agent_pid(uid: Optional[int] = None) -> str:
    if uid is None:
        uid = os.getuid()
    return CONTAINER_GPG_AGENT_PID_TEMPLATE.format(uid=uid)


def container_gpg_proxy_socket_path(socket_key: str, uid: Optional[int] = None) -> str:
    basename = GPG_SOCKET_BASENAMES.get(socket_key, socket_key)
    return str(pathlib.Path(container_gpg_home(uid)) / basename)


def current_ssh_auth_sock() -> Optional[pathlib.Path]:
    value = os.environ.get("SSH_AUTH_SOCK")
    if not value:
        return None
    return socket_path_if_connectable(pathlib.Path(value))


def socket_path_if_socket(path: pathlib.Path) -> Optional[pathlib.Path]:
    try:
        st = path.stat()
    except OSError:
        return None
    if stat.S_ISSOCK(st.st_mode):
        return path
    return None


def socket_path_if_connectable(path: pathlib.Path) -> Optional[pathlib.Path]:
    sock_path = socket_path_if_socket(path)
    if sock_path is None:
        return None
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.settimeout(0.5)
        sock.connect(str(sock_path))
        return sock_path
    except OSError:
        return None
    finally:
        sock.close()


def current_gpg_info() -> Tuple[Optional[pathlib.Path], Dict[str, pathlib.Path]]:
    rows: Dict[str, str] = {}
    gpgconf = shutil.which("gpgconf")
    if gpgconf:
        try:
            cp = subprocess.run(
                [gpgconf, "--list-dirs"],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=5,
            )
            if cp.returncode == 0:
                for line in cp.stdout.splitlines():
                    if ":" in line:
                        key, value = line.split(":", 1)
                        rows[key] = value
        except (OSError, subprocess.TimeoutExpired):
            pass
    home_value = rows.get("homedir") or os.environ.get("GNUPGHOME") or str(pathlib.Path.home() / ".gnupg")
    home = pathlib.Path(home_value).expanduser()
    sockets: Dict[str, pathlib.Path] = {}
    for key, basename in GPG_SOCKET_BASENAMES.items():
        value = rows.get(key)
        path = pathlib.Path(value).expanduser() if value else home / basename
        sock = socket_path_if_connectable(path)
        if sock is not None:
            sockets[key] = sock
    return home, sockets


def x11_binary(name: str) -> Optional[str]:
    found = shutil.which(name)
    if found:
        return found
    path = pathlib.Path("/opt/X11/bin") / name
    if path.exists() and os.access(path, os.X_OK):
        return str(path)
    return None


def xquartz_app_path() -> Optional[pathlib.Path]:
    for candidate in XQUARTZ_APP_CANDIDATES:
        path = pathlib.Path(candidate)
        if path.exists():
            return path
    return None


def parse_display_number(value: str) -> int:
    if not value or ":" not in value:
        return 0
    tail = value.rsplit(":", 1)[-1]
    number = tail.split(".", 1)[0]
    if number.isdigit():
        return int(number)
    return 0


def tcp_port_open(host: str, port: int, timeout: float = 0.25) -> bool:
    try:
        sock = socket.create_connection((host, port), timeout=timeout)
        sock.close()
        return True
    except OSError:
        return False


def env_flag_enabled(value: str) -> bool:
    return value.lower() in ("1", "true", "yes", "on", "always")


def env_flag_disabled(value: str) -> bool:
    return value.lower() in ("0", "false", "no", "off", "never")


def engine_unavailable_error(engine_name: str, stderr: object, stdout: object = "") -> bool:
    text = f"{_decode_output(stderr)}\n{_decode_output(stdout)}".lower()
    if not text.strip():
        return False
    patterns = [
        "cannot connect to podman",
        "unable to connect to podman",
        "is podman machine running",
        "cannot connect to the docker daemon",
        "docker daemon is not running",
        "error during connect",
        "connection refused",
    ]
    if any(pattern in text for pattern in patterns):
        return True
    if "no such file or directory" in text and ("podman" in text or "docker" in text) and ".sock" in text:
        return True
    if engine_name == "podman" and "machine" in text and "not running" in text:
        return True
    return False


def host_lubox_path() -> str:
    return str(pathlib.Path(__file__).resolve())


def inside_lubox_container() -> bool:
    config_path = pathlib.Path(os.environ.get("LUBOX_HOSTEXEC_CONFIG", CONTAINER_CONFIG_PATH))
    return bool(os.environ.get("LUBOX_CONTAINER_NAME")) and config_path.exists()


def host_lubox_command(raw_args: Sequence[str]) -> List[str]:
    configured = os.environ.get("LUBOX_HOST_LUBOX")
    if configured:
        return [configured] + list(raw_args)
    candidate = pathlib.Path(os.environ.get("HOME", str(pathlib.Path.home()))) / ".local" / "bin" / "lubox"
    if candidate.exists():
        return [str(candidate)] + list(raw_args)
    return ["lubox"] + list(raw_args)


def forward_lubox_command_if_needed(raw_args: Sequence[str]) -> Optional[int]:
    args = list(raw_args)
    if not args or args[0].startswith("-"):
        return None
    if args[0] not in FORWARDABLE_LUBOX_COMMANDS:
        return None
    if not inside_lubox_container():
        return None
    if args[0] == "code-server":
        current = os.environ.get("LUBOX_CONTAINER_NAME")
        if current:
            args = [args[0], current] + args[1:]
    return HostExecClient(host_lubox_command(args), probe=False).run()


def path_under(path: pathlib.Path, parent: pathlib.Path) -> bool:
    try:
        resolved_path = str(path.expanduser().resolve())
        resolved_parent = str(parent.expanduser().resolve())
        return os.path.commonpath([resolved_path, resolved_parent]) == resolved_parent
    except (OSError, ValueError):
        return False


def atomic_write_bytes(path: pathlib.Path, data: bytes, mode: Optional[int] = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    tmp_path = pathlib.Path(tmp)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        if mode is not None:
            os.chmod(tmp_path, mode)
        os.replace(tmp_path, path)
    finally:
        try:
            tmp_path.unlink()
        except FileNotFoundError:
            pass


def atomic_write_text(path: pathlib.Path, data: str, mode: Optional[int] = None) -> None:
    atomic_write_bytes(path, data.encode("utf-8"), mode)


def atomic_write_json(path: pathlib.Path, obj: Dict[str, Any], mode: Optional[int] = None) -> None:
    data = json.dumps(obj, sort_keys=True, indent=2) + "\n"
    atomic_write_text(path, data, mode)


def load_json_file(path: pathlib.Path) -> Dict[str, Any]:
    with path.open("r", encoding="utf-8") as f:
        data = json.load(f)
    if not isinstance(data, dict):
        die(f"lubox: expected object JSON in {path}")
    return data


def ensure_private_dir(path: pathlib.Path) -> pathlib.Path:
    path.mkdir(parents=True, exist_ok=True)
    st = path.stat()
    if not stat.S_ISDIR(st.st_mode):
        die(f"lubox: not a directory: {path}")
    if st.st_uid != os.getuid():
        die(f"lubox: refusing directory not owned by current user: {path}")
    if st.st_mode & 0o077:
        os.chmod(path, 0o700)
        st = path.stat()
        if st.st_mode & 0o077:
            die(f"lubox: refusing non-private directory: {path}")
    return path


def ensure_token_file(path: pathlib.Path) -> None:
    st = path.stat()
    if st.st_uid != os.getuid():
        die(f"lubox: refusing token file not owned by current user: {path}")
    if st.st_mode & 0o077:
        die(f"lubox: refusing token file with broad permissions: {path}")


def read_token(path: pathlib.Path) -> bytes:
    ensure_token_file(path)
    data = path.read_bytes()
    if len(data) < 32:
        die(f"lubox: token file too short: {path}")
    return data


def looks_like_pid_running(pid: int) -> bool:
    if pid <= 1:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def safe_unlink(path: pathlib.Path) -> None:
    try:
        path.unlink()
    except FileNotFoundError:
        pass


@dataclasses.dataclass(frozen=True)
class HostIdentity:
    username: str
    uid: int
    gid: int
    home: pathlib.Path
    login_shell: pathlib.Path
    shell_basename: str

    @classmethod
    def load(cls) -> "HostIdentity":
        pw = pwd.getpwuid(os.getuid())
        login_shell = pathlib.Path(pw.pw_shell) if pw.pw_shell else pathlib.Path("/bin/sh")
        shell_basename = login_shell.name or "sh"
        validate_safe_word("username", pw.pw_name)
        validate_safe_word("shell basename", shell_basename)
        return cls(
            username=pw.pw_name,
            uid=pw.pw_uid,
            gid=pw.pw_gid,
            home=pathlib.Path(pw.pw_dir),
            login_shell=login_shell,
            shell_basename=shell_basename,
        )


@dataclasses.dataclass(frozen=True)
class LuboxPaths:
    data: pathlib.Path
    state: pathlib.Path
    cache: pathlib.Path
    runtime: pathlib.Path

    @classmethod
    def load(cls) -> "LuboxPaths":
        home = pathlib.Path.home()
        data_home = pathlib.Path(os.environ.get("XDG_DATA_HOME", str(home / ".local" / "share")))
        state_home = pathlib.Path(os.environ.get("XDG_STATE_HOME", str(home / ".local" / "state")))
        cache_home = pathlib.Path(os.environ.get("XDG_CACHE_HOME", str(home / ".cache")))
        runtime_base_env = os.environ.get("XDG_RUNTIME_DIR")
        if runtime_base_env:
            runtime_base = pathlib.Path(runtime_base_env)
        elif is_linux():
            runtime_base = pathlib.Path("/tmp") / f"lubox-{os.getuid()}"
        else:
            runtime_base = pathlib.Path(tempfile.gettempdir()) / f"lubox-{os.getuid()}"
        paths = cls(
            data=ensure_private_dir(data_home / "lubox"),
            state=ensure_private_dir(state_home / "lubox"),
            cache=ensure_private_dir(cache_home / "lubox"),
            runtime=ensure_private_dir(runtime_base / "lubox"),
        )
        return paths

    def state_dir(self, name: str) -> pathlib.Path:
        return ensure_private_dir(self.state / name)

    def runtime_dir(self, name: str) -> pathlib.Path:
        return ensure_private_dir(self.runtime / name)

    def mount_dir(self, name: str, engine_name: str) -> pathlib.Path:
        if is_macos() and engine_name == "podman":
            return ensure_private_dir(self.state_dir(name) / "run")
        return ensure_private_dir(self.runtime_dir(name) / "run")

    def token_file(self, name: str) -> pathlib.Path:
        return self.state_dir(name) / "hostexec.token"

    def log_file(self, name: str) -> pathlib.Path:
        return self.state_dir(name) / "hostexec.log"

    def code_server_log_file(self, name: str) -> pathlib.Path:
        return self.state_dir(name) / "code-server.log"

    def code_server_tunnel_log_file(self, name: str, port: int) -> pathlib.Path:
        return self.state_dir(name) / f"code-server-tunnel-{port}.log"

    def pid_file(self, name: str) -> pathlib.Path:
        return self.runtime_dir(name) / "hostexec.pid"

    def code_server_tunnel_pid_file(self, name: str, port: int) -> pathlib.Path:
        return self.runtime_dir(name) / f"code-server-tunnel-{port}.pid"

    def lock_file(self, name: str) -> pathlib.Path:
        return self.runtime_dir(name) / "hostexec.lock"


@dataclasses.dataclass(frozen=True)
class Engine:
    name: str
    path: str

    @staticmethod
    def path_candidates(name: str) -> Iterable[Tuple[pathlib.Path, pathlib.Path]]:
        seen = set()
        for entry in (os.environ.get("PATH") or os.defpath).split(os.pathsep):
            candidate = pathlib.Path(entry or ".") / name
            if not os.access(candidate, os.X_OK) or candidate.is_dir():
                continue
            try:
                found_dir = candidate.parent.expanduser().resolve()
                found = found_dir / candidate.name
                resolved = found.resolve()
            except OSError:
                continue
            key = str(found)
            if key in seen:
                continue
            seen.add(key)
            yield found, resolved

    @classmethod
    def actual_path(cls, name: str) -> Tuple[Optional[str], List[str]]:
        home = pathlib.Path.home()
        ignored: List[str] = []
        for found, resolved in cls.path_candidates(name):
            if path_under(found.parent, home) or path_under(resolved, home):
                ignored.append(str(found))
                continue
            return str(found), ignored
        return None, ignored

    @classmethod
    def select(cls, override: Optional[str] = None) -> "Engine":
        requested = override or os.environ.get("LUBOX_ENGINE")
        if requested:
            if requested not in ("podman", "docker"):
                die("lubox: --engine/LUBOX_ENGINE must be podman or docker")
            found, ignored = cls.actual_path(requested)
            if not found:
                if ignored:
                    die(f"lubox: requested engine has no PATH executable outside HOME: {requested} (ignored {', '.join(ignored)})")
                die(f"lubox: requested engine not found in PATH: {requested}")
            return cls(requested, found)
        ignored_by_name: Dict[str, List[str]] = {}
        for name in ("podman", "docker"):
            found, ignored = cls.actual_path(name)
            if found:
                return cls(name, found)
            if ignored:
                ignored_by_name[name] = ignored
        if ignored_by_name:
            detail = "; ".join(f"{name}: {', '.join(paths)}" for name, paths in ignored_by_name.items())
            die(f"lubox: neither podman nor docker has PATH executable outside HOME (ignored {detail})")
        die("lubox: neither podman nor docker found in PATH")

    def argv(self, args: Sequence[str]) -> List[str]:
        return [self.path] + list(args)

    def run(
        self,
        args: Sequence[str],
        *,
        check: bool = True,
        capture: bool = True,
        input_data: object = None,
        timeout: Optional[float] = None,
        env: Optional[Dict[str, str]] = None,
    ) -> subprocess.CompletedProcess:
        argv = self.argv(args)
        text_mode = not isinstance(input_data, (bytes, bytearray))
        cp = subprocess.run(
            argv,
            input=input_data,
            text=text_mode,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.PIPE if capture else None,
            timeout=timeout,
            env=env,
        )
        if check and cp.returncode != 0:
            raise CommandError(argv, cp.returncode, cp.stderr)
        return cp

    def run_progress(
        self,
        args: Sequence[str],
        progress: Progress,
        *,
        check: bool = True,
        env: Optional[Dict[str, str]] = None,
    ) -> subprocess.CompletedProcess:
        argv = self.argv(args)
        proc = subprocess.Popen(
            argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
        )
        selector = selectors.DefaultSelector()
        stdout_data = bytearray()
        stderr_data = bytearray()
        stdout_pending = ""
        stderr_pending = ""
        if proc.stdout is not None:
            selector.register(proc.stdout.fileno(), selectors.EVENT_READ, "stdout")
        if proc.stderr is not None:
            selector.register(proc.stderr.fileno(), selectors.EVENT_READ, "stderr")
        try:
            while selector.get_map():
                events = selector.select(0.1)
                if not events:
                    progress.pulse()
                for key, _mask in events:
                    chunk = os.read(key.fd, 65536)
                    if not chunk:
                        selector.unregister(key.fd)
                        continue
                    if key.data == "stdout":
                        stdout_data.extend(chunk)
                        stdout_pending = self.progress_lines(chunk, stdout_pending, progress)
                    else:
                        stderr_data.extend(chunk)
                        stderr_pending = self.progress_lines(chunk, stderr_pending, progress)
            returncode = proc.wait()
        except KeyboardInterrupt:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
            raise
        finally:
            selector.close()
        if stdout_pending.strip():
            progress.detail(stdout_pending.strip())
        if stderr_pending.strip():
            progress.detail(stderr_pending.strip())
        stdout_text = stdout_data.decode("utf-8", "replace")
        stderr_text = stderr_data.decode("utf-8", "replace")
        if check and returncode != 0:
            raise CommandError(argv, returncode, stderr_text or stdout_text)
        return subprocess.CompletedProcess(argv, returncode, stdout_text, stderr_text)

    def progress_lines(self, chunk: bytes, pending: str, progress: Progress) -> str:
        text = pending + chunk.decode("utf-8", "replace").replace("\r", "\n")
        lines = text.split("\n")
        for line in lines[:-1]:
            line = line.strip()
            if line:
                progress.detail(line)
        return lines[-1]

    def popen(
        self,
        args: Sequence[str],
        *,
        stdin: object = None,
        stdout: object = None,
        stderr: object = None,
        start_new_session: bool = False,
    ) -> subprocess.Popen:
        return subprocess.Popen(
            self.argv(args),
            stdin=stdin,
            stdout=stdout,
            stderr=stderr,
            start_new_session=start_new_session,
        )

    def ensure_ready(self, *, start_machine: bool) -> None:
        if is_macos() and self.name == "podman" and start_machine:
            self.ensure_podman_machine_running()

    def podman_machine_rows(self) -> List[Dict[str, Any]]:
        cp = self.run(["machine", "ls", "--format", "json"], check=False, capture=True, timeout=20)
        if cp.returncode != 0:
            raise CommandError(self.argv(["machine", "ls", "--format", "json"]), cp.returncode, cp.stderr)
        text = _decode_output(cp.stdout).strip()
        if not text:
            return []
        try:
            data = json.loads(text)
        except json.JSONDecodeError as exc:
            die(f"lubox: cannot parse podman machine JSON: {exc}")
        if isinstance(data, list):
            return [row for row in data if isinstance(row, dict)]
        if isinstance(data, dict):
            return [data]
        return []

    def ensure_podman_machine_running(self) -> None:
        try:
            rows = self.podman_machine_rows()
        except CommandError as exc:
            die(
                "lubox: cannot list Podman machines\n"
                f"{exc}\n"
                'If no machine exists, run: podman machine init -v "$HOME:$HOME" --now'
            )
        if not rows:
            die(
                'lubox: no Podman machine exists; run: podman machine init -v "$HOME:$HOME" --now'
            )
        if any(bool(row.get("Running")) or str(row.get("Status", "")).lower() == "running" for row in rows):
            return
        cp = self.run(["machine", "start"], check=False, capture=True, timeout=120)
        if cp.returncode != 0:
            stderr = _decode_output(cp.stderr).strip()
            die(
                "lubox: failed to start Podman machine\n"
                f"command: {shlex.join(self.argv(['machine', 'start']))}\n"
                f"exit code: {cp.returncode}\n"
                f"stderr:\n{stderr}\n"
                'If no machine exists, run: podman machine init -v "$HOME:$HOME" --now'
            )

    def inspect_container(self, cname: str, *, required: bool = False) -> Optional[Dict[str, Any]]:
        cp = self.run(["inspect", cname], check=False, capture=True)
        if cp.returncode != 0:
            if engine_unavailable_error(self.name, cp.stderr, cp.stdout):
                raise CommandError(self.argv(["inspect", cname]), cp.returncode, cp.stderr or cp.stdout)
            if required:
                die(f"lubox: container not found: {cname}\nTry: lubox create {cname.removeprefix('lubox-')}")
            return None
        try:
            data = json.loads(_decode_output(cp.stdout))
        except json.JSONDecodeError as exc:
            die(f"lubox: cannot parse inspect JSON for {cname}: {exc}")
        if isinstance(data, list) and data:
            first = data[0]
            if isinstance(first, dict):
                return first
        if isinstance(data, dict):
            return data
        if required:
            die(f"lubox: container not found: {cname}\nTry: lubox create {cname.removeprefix('lubox-')}")
        return None

    def inspect_containers(self, cnames: Sequence[str]) -> Dict[str, Dict[str, Any]]:
        names = list(cnames)
        if not names:
            return {}
        cp = self.run(["inspect"] + names, check=False, capture=True)
        if cp.returncode != 0:
            if engine_unavailable_error(self.name, cp.stderr, cp.stdout):
                raise CommandError(self.argv(["inspect"] + names), cp.returncode, cp.stderr or cp.stdout)
            return {}
        try:
            data = json.loads(_decode_output(cp.stdout))
        except json.JSONDecodeError as exc:
            die(f"lubox: cannot parse inspect JSON: {exc}")
        rows = data if isinstance(data, list) else [data]
        infos: Dict[str, Dict[str, Any]] = {}
        for cname, item in zip(names, rows):
            if isinstance(item, dict):
                infos[cname] = item
        return infos

    def container_exists(self, cname: str) -> bool:
        return self.inspect_container(cname, required=False) is not None

    def is_running(self, cname: str) -> bool:
        info = self.inspect_container(cname, required=False)
        if not info:
            return False
        state = info.get("State", {})
        if isinstance(state, dict):
            return bool(state.get("Running")) or str(state.get("Status", "")).lower() == "running"
        return False

    def list_lubox_names(self) -> List[str]:
        cp = self.run(
            ["ps", "-a", "--filter", f"label={LABEL_PREFIX}=1", "--format", "{{.Names}}"],
            check=False,
            capture=True,
        )
        if cp.returncode != 0:
            raise CommandError(self.argv(["ps", "-a", "--filter", f"label={LABEL_PREFIX}=1", "--format", "{{.Names}}"]), cp.returncode, cp.stderr)
        names = []
        for line in _decode_output(cp.stdout).splitlines():
            line = line.strip()
            if line:
                names.append(line.split()[0])
        return names


class ImageBuilder:
    def __init__(self, engine: Engine, ident: HostIdentity):
        self.engine = engine
        self.ident = ident

    def build(self, name: str, base_image: str, progress: Optional[Progress] = None) -> str:
        validate_image_ref(base_image)
        tag = image_name(name)
        with tempfile.TemporaryDirectory(prefix="lubox-build-") as td:
            root = pathlib.Path(td)
            if progress is not None:
                progress.detail("writing Containerfile")
            atomic_write_text(root / "Containerfile", self.containerfile(base_image), 0o644)
            script_src = pathlib.Path(__file__).resolve()
            script_data = script_src.read_bytes()
            atomic_write_bytes(root / "lubox", script_data, 0o755)
            atomic_write_text(root / "xdg-open", XDG_OPEN_SCRIPT, 0o755)
            user_json = {
                "username": self.ident.username,
                "uid": self.ident.uid,
                "gid": self.ident.gid,
                "home": str(self.ident.home),
                "login_shell": str(self.ident.login_shell),
                "shell_basename": self.ident.shell_basename,
            }
            atomic_write_json(root / "user.json", user_json, 0o644)
            args = [
                "build",
                "-t",
                tag,
                "--build-arg",
                f"LUBOX_USERNAME={self.ident.username}",
                "--build-arg",
                f"LUBOX_UID={self.ident.uid}",
                "--build-arg",
                f"LUBOX_GID={self.ident.gid}",
                "--build-arg",
                f"LUBOX_HOME={self.ident.home}",
                "--build-arg",
                f"LUBOX_SHELL_BASENAME={self.ident.shell_basename}",
                "-f",
                str(root / "Containerfile"),
                str(root),
            ]
            if progress is None:
                self.engine.run(args, capture=True)
            else:
                progress.detail(f"{self.engine.name} build {tag}")
                self.engine.run_progress(args, progress)
        return tag

    def containerfile(self, base_image: str) -> str:
        return f"""FROM {base_image}
ARG LUBOX_USERNAME
ARG LUBOX_UID
ARG LUBOX_GID
ARG LUBOX_HOME
ARG LUBOX_SHELL_BASENAME
COPY lubox /usr/local/bin/lubox
COPY xdg-open /usr/local/bin/xdg-open
COPY user.json /tmp/lubox-user.json
RUN chmod 0755 /usr/local/bin/lubox /usr/local/bin/xdg-open \
 && set -eux \
 && shell_pkg="" \
    && if [ "$LUBOX_SHELL_BASENAME" != "sh" ]; then shell_pkg="$LUBOX_SHELL_BASENAME"; fi \
    && if command -v apt-get >/dev/null 2>&1; then \
      if [ -d /etc/dpkg/dpkg.cfg.d ]; then sed -i '/path-exclude=.*usr.*share.*man/d' /etc/dpkg/dpkg.cfg.d/* 2>/dev/null || true; fi; \
      export DEBIAN_FRONTEND=noninteractive; \
      apt-get update; \
      if command -v unminimize >/dev/null 2>&1; then yes | unminimize || true; fi; \
      apt-get install -y --no-install-recommends bubblewrap python3 sudo ca-certificates passwd coreutils procps hostname locales openssh-client git ncurses-bin debianutils grep net-tools vim-tiny nano man-db manpages manpages-dev less findutils sed gawk diffutils patch tar gzip bzip2 xz-utils zip unzip file curl wget rsync iproute2 iputils-ping libcap2-bin dnsutils lsof psmisc util-linux $shell_pkg; \
      if [ -x /usr/bin/man.REAL ] && grep -q 'This system has been minimized' /usr/bin/man 2>/dev/null; then dpkg-divert --quiet --remove /usr/bin/man || true; mv -f /usr/bin/man.REAL /usr/bin/man; fi; \
      mandb -q || true; \
      for p in jq tree tmux htop strace make bash-completion ripgrep fd-find fzf; do apt-get install -y --no-install-recommends "$p" || true; done; \
      rm -rf /var/lib/apt/lists/*; \
    elif command -v dnf >/dev/null 2>&1; then \
      sed -i '/^tsflags=nodocs/d' /etc/dnf/dnf.conf /etc/yum.conf 2>/dev/null || true; \
      dnf install -y "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"; \
      dnf install -y bubblewrap python3 sudo ca-certificates shadow-utils coreutils procps-ng hostname glibc-langpack-en openssh-clients git ncurses which grep net-tools vim-minimal nano man-db man-pages less findutils sed gawk diffutils patch tar gzip bzip2 xz zip unzip file curl wget rsync iproute iputils libcap bind-utils lsof psmisc util-linux jq tree tmux htop strace make bash-completion ripgrep fd-find fzf man-pages-posix $shell_pkg; \
      dnf clean all; \
    elif command -v microdnf >/dev/null 2>&1; then \
      sed -i '/^tsflags=nodocs/d' /etc/dnf/dnf.conf /etc/yum.conf 2>/dev/null || true; \
      microdnf install -y bubblewrap python3 sudo ca-certificates shadow-utils coreutils procps-ng hostname glibc-langpack-en openssh-clients git ncurses which grep net-tools vim-minimal nano man-db man-pages less findutils sed gawk diffutils patch tar gzip bzip2 xz zip unzip file curl wget rsync iproute iputils libcap bind-utils lsof psmisc util-linux $shell_pkg; \
      for p in jq tree tmux htop strace make bash-completion ripgrep fd-find fzf man-pages-posix; do microdnf install -y "$p" || true; done; \
      microdnf clean all; \
    elif command -v yum >/dev/null 2>&1; then \
      sed -i '/^tsflags=nodocs/d' /etc/dnf/dnf.conf /etc/yum.conf 2>/dev/null || true; \
      yum install -y bubblewrap python3 sudo ca-certificates shadow-utils coreutils procps-ng hostname glibc-langpack-en openssh-clients git ncurses which grep net-tools vim-minimal nano man-db man-pages less findutils sed gawk diffutils patch tar gzip bzip2 xz zip unzip file curl wget rsync iproute iputils libcap bind-utils lsof psmisc util-linux $shell_pkg; \
      for p in jq tree tmux htop strace make bash-completion ripgrep fd-find fzf man-pages-posix; do yum install -y "$p" || true; done; \
      yum clean all; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache bubblewrap python3 sudo ca-certificates shadow coreutils procps hostname libc-utils openssh-client git ncurses which grep net-tools vim nano mandoc man-pages less findutils sed gawk diffutils patch tar gzip bzip2 xz zip unzip file curl wget rsync iproute2 iputils libcap bind-tools lsof psmisc util-linux $shell_pkg; \
      for p in musl-locales musl-locales-lang jq tree tmux htop strace make bash-completion ripgrep fd fzf less-doc mandoc-apropos; do apk add --no-cache "$p" || true; done; \
    elif command -v pacman >/dev/null 2>&1; then \
      pacman -Syu --noconfirm bubblewrap python sudo ca-certificates shadow coreutils procps-ng inetutils openssh git ncurses which grep net-tools vim nano man-db man-pages less findutils sed gawk diffutils patch tar gzip bzip2 xz zip unzip file curl wget rsync iproute2 iputils libcap bind lsof psmisc util-linux $shell_pkg; \
      for p in jq tree tmux htop strace make bash-completion ripgrep fd fzf; do pacman -S --noconfirm "$p" || true; done; \
      pacman -Scc --noconfirm || true; \
    elif command -v zypper >/dev/null 2>&1; then \
      zypper --non-interactive refresh; \
      zypper --non-interactive install -y bubblewrap python3 sudo ca-certificates shadow coreutils procps hostname glibc-locale openssh git ncurses-utils which grep net-tools vim nano man man-pages less findutils sed gawk diffutils patch tar gzip bzip2 xz zip unzip file curl wget rsync iproute2 iputils libcap-progs bind-utils lsof psmisc util-linux $shell_pkg; \
      for p in jq tree tmux htop strace make bash-completion ripgrep fd fzf; do zypper --non-interactive install -y "$p" || true; done; \
      zypper clean -a || true; \
    else \
      echo 'lubox: unsupported image: no apt-get/dnf/microdnf/yum/apk/pacman/zypper found' >&2; \
      exit 70; \
    fi \
 && for cmd in bwrap ssh git clear which grep netstat vi nano man less curl wget rsync tar gzip xz unzip file find sed awk diff patch lsof ip ping; do \
      command -v "$cmd" >/dev/null 2>&1 || {{ echo "lubox: required CLI command missing after install: $cmd" >&2; exit 78; }}; \
    done \
 && if command -v ping >/dev/null 2>&1; then \
      ping_bin="$(command -v ping)"; \
      if command -v setcap >/dev/null 2>&1; then setcap cap_net_raw+ep "$ping_bin" || chmod u+s "$ping_bin" || true; \
      else chmod u+s "$ping_bin" || true; fi; \
    fi \
 && if [ -f /etc/locale.gen ]; then \
      sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen || true; \
      grep -q '^en_US.UTF-8 UTF-8' /etc/locale.gen || printf '%s\\n' 'en_US.UTF-8 UTF-8' >> /etc/locale.gen; \
      locale-gen || true; \
    fi \
 && if command -v localedef >/dev/null 2>&1 && ! locale -a 2>/dev/null | grep -Eiq '^en_US\\.utf-?8$'; then \
      localedef -i en_US -f UTF-8 en_US.UTF-8 || true; \
    fi \
 && SHELL_PATH="$(command -v "$LUBOX_SHELL_BASENAME" || true)" \
 && if [ -z "$SHELL_PATH" ]; then \
      echo "lubox: required login shell '$LUBOX_SHELL_BASENAME' was not installed in image" >&2; \
      exit 78; \
    fi \
 && case "$SHELL_PATH" in /*) : ;; *) echo "lubox: shell path is not absolute: $SHELL_PATH" >&2; exit 78 ;; esac \
 && mkdir -p /etc/lubox /etc/sudoers.d "$(dirname "$LUBOX_HOME")" "/tmp/lubox-$LUBOX_UID" \
 && if [ -f /etc/os-release ]; then cp /etc/os-release /etc/lubox/os-release-copy; else : > /etc/lubox/os-release-copy; fi \
 && if ! getent group "$LUBOX_GID" >/dev/null 2>&1; then \
      group_name="$LUBOX_USERNAME"; \
      if getent group "$group_name" >/dev/null 2>&1; then group_name="lubox_$LUBOX_GID"; fi; \
      groupadd -g "$LUBOX_GID" "$group_name"; \
    fi \
 && if id -u "$LUBOX_USERNAME" >/dev/null 2>&1; then \
      usermod -u "$LUBOX_UID" -g "$LUBOX_GID" -d "$LUBOX_HOME" -s "$SHELL_PATH" "$LUBOX_USERNAME"; \
    elif getent passwd "$LUBOX_UID" >/dev/null 2>&1; then \
      old_user="$(getent passwd "$LUBOX_UID" | cut -d: -f1)"; \
      usermod -l "$LUBOX_USERNAME" -d "$LUBOX_HOME" -m -s "$SHELL_PATH" -g "$LUBOX_GID" "$old_user"; \
    else \
      useradd -m -u "$LUBOX_UID" -g "$LUBOX_GID" -d "$LUBOX_HOME" -s "$SHELL_PATH" "$LUBOX_USERNAME"; \
    fi \
 && mkdir -p "$LUBOX_HOME" \
 && chown "$LUBOX_UID:$LUBOX_GID" "$LUBOX_HOME" "/tmp/lubox-$LUBOX_UID" \
 && printf '%s ALL=(ALL) NOPASSWD:ALL\\n' "$LUBOX_USERNAME" > /etc/sudoers.d/lubox \
 && chmod 0440 /etc/sudoers.d/lubox \
 && printf '%s\\n' "$SHELL_PATH" > /etc/lubox/shell \
 && cp /tmp/lubox-user.json /etc/lubox/user.json
"""


@dataclasses.dataclass
class ContainerInfo:
    name: str
    status: str
    image: str
    host_exec: str
    base_image: str


@dataclasses.dataclass(frozen=True)
class SocketForward:
    key: str
    source: pathlib.Path
    target: str
    readonly: bool = False


@dataclasses.dataclass(frozen=True)
class SocketForwardGroup:
    kind: str
    name: str
    label: str
    forwards: Tuple[SocketForward, ...]
    pid_file: str = ""
    marker_text: str = ""
    proxy_command: Tuple[str, ...] = ()
    proxy_env: Tuple[Tuple[str, str], ...] = ()
    check_command: Tuple[str, ...] = ()

    def socket_paths(self) -> List[str]:
        return [forward.target for forward in self.forwards]

    def sockets_config(self) -> Dict[str, Dict[str, str]]:
        return {
            forward.key: {
                "socket_path": forward.target,
                "host_path": str(forward.source),
            }
            for forward in self.forwards
        }


@dataclasses.dataclass(frozen=True)
class SocketForwardPlan:
    ssh_sock: Optional[pathlib.Path]
    gpg_home: Optional[pathlib.Path]
    gpg_sockets: Dict[str, pathlib.Path]
    ssh_agent: bool
    gpg_agent: bool
    groups: Tuple[SocketForwardGroup, ...]


BWRAP_PROFILE_SHA256 = "896bef499d0251ad753116a1fad04b5b049a4c86bdc7c0f4f49c8edf1cd9735a"


def bwrap_container_config(info: Dict[str, Any], image: str, profile: Dict[str, Any]) -> Dict[str, Any]:
    """Preserve inspect configuration, changing only the bwrap prerequisites."""
    config = json.loads(json.dumps(info.get("Config") or {}))
    host = json.loads(json.dumps(info.get("HostConfig") or {}))
    if host.get("Privileged") or any(cap in ("SYS_ADMIN", "CAP_SYS_ADMIN") for cap in (host.get("CapAdd") or [])):
        die("lubox: bwrap migration refuses privileged/CAP_SYS_ADMIN containers")
    config["Image"] = image
    config["Labels"] = config.get("Labels") or {}
    config["Labels"][f"{LABEL_PREFIX}.bwrap"] = "true"
    host["SecurityOpt"] = [opt for opt in host.get("SecurityOpt") or [] if not opt.startswith("seccomp=")]
    host["SecurityOpt"].append("seccomp=" + json.dumps(profile, separators=(",", ":")))
    # Locked child mounts below the parent /proc (including readonly binds)
    # prevent an unprivileged child PID namespace from mounting its own procfs.
    # This is an explicit --bwrap opt-in; keep every non-/proc restriction.
    if not isinstance(host.get("MaskedPaths"), list) or not isinstance(host.get("ReadonlyPaths"), list):
        die("lubox: inspect did not expose system path restrictions; refusing to guess")
    host["MaskedPaths"] = [path for path in host["MaskedPaths"] if path != "/proc" and not path.startswith("/proc/")]
    host["ReadonlyPaths"] = [path for path in host["ReadonlyPaths"] if path != "/proc" and not path.startswith("/proc/")]
    config["HostConfig"] = host
    networks = {}
    for name, endpoint in (info.get("NetworkSettings", {}).get("Networks") or {}).items():
        selected = {key: endpoint[key] for key in ("IPAMConfig", "Links", "Aliases", "DriverOpts") if endpoint.get(key)}
        if selected:
            networks[name] = selected
    if networks:
        config["NetworkingConfig"] = {"EndpointsConfig": networks}
    return config


class DockerAPI:
    """Local Unix-socket API for fields unavailable through `docker create`."""
    def __init__(self, engine: Engine):
        if engine.name != "docker":
            die("lubox: --bwrap currently supports Docker only")
        endpoint = os.environ.get("DOCKER_HOST") if not os.environ.get("DOCKER_CONTEXT") else None
        if not endpoint:
            endpoint = _decode_output(engine.run(["context", "inspect", "--format", "{{.Endpoints.docker.Host}}"]).stdout).strip()
        parsed = urllib.parse.urlparse(endpoint)
        if parsed.scheme != "unix" or not parsed.path:
            die("lubox: bwrap configuration requires a local Docker Unix socket")
        self.socket_path = urllib.parse.unquote(parsed.path)

    def create(self, name: str, config: Dict[str, Any]) -> Dict[str, Any]:
        connection = http.client.HTTPConnection("localhost", timeout=60)
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(60)
        try:
            sock.connect(self.socket_path)
            connection.sock = sock
            connection.request("POST", "/containers/create?name=" + urllib.parse.quote(name, safe=""),
                               body=json.dumps(config), headers={"Content-Type": "application/json"})
            response = connection.getresponse()
            data = json.loads(response.read())
            if response.status != 201 or not isinstance(data, dict) or not data.get("Id"):
                message = data.get("message", data) if isinstance(data, dict) else data
                die(f"lubox: Docker create failed ({response.status}): {str(message)[:500]}")
            return data
        finally:
            connection.close()
            sock.close()


class ContainerManager:
    def __init__(self, engine: Engine, ident: HostIdentity, paths: LuboxPaths):
        self.engine = engine
        self.ident = ident
        self.paths = paths
        self._locale_cache: Dict[str, List[str]] = {}

    def create(self, name: str, base_image: str, no_host_exec: bool, rebuild: bool, bwrap: bool = False) -> None:
        validate_box_name(name)
        if bwrap:
            self.require_bwrap_profile()
            if rebuild:
                die("lubox: --bwrap --rebuild is refused; use reconfigure NAME --bwrap on a stopped container to preserve its filesystem")
        cname = container_name(name)
        progress = Progress(f"lubox create {name}", 6)
        try:
            progress.begin("check engine")
            self.engine.ensure_ready(start_machine=True)

            progress.begin("check existing container")
            if self.engine.container_exists(cname):
                if not rebuild:
                    die(f"lubox: container already exists: {cname}; use --rebuild to recreate")
                progress.detail(f"removing existing {cname}")
                self.stop_server(name)
                self.engine.run_progress(["rm", "-f", cname], progress)

            progress.begin("prepare state")
            host_exec = not no_host_exec
            mount_dir = self.prepare_hostexec_files(name, host_exec)

            progress.begin("build image")
            tag = ImageBuilder(self.engine, self.ident).build(name, base_image, progress)

            progress.begin("validate image")
            shell_path = self.image_shell_path(tag, progress)

            progress.begin("create container")
            args = self.create_args(name, tag, base_image, host_exec, mount_dir, shell_path, bwrap=bwrap)
            self.engine.run_progress(args, progress)
            if bwrap:
                # Docker CLI cannot set MaskedPaths/ReadonlyPaths separately.
                # Replace only this never-started template through the local API.
                info = self.engine.inspect_container(cname, required=True)
                if not info or self.running_from_info(info) or info.get("State", {}).get("Status") != "created":
                    die("lubox: refusing to replace a running or previously used create template")
                self.replace_for_bwrap(name, info, tag, keep_backup=False)
            progress.finish(f"created {cname}")
            print(f"created {cname}")
        except LuboxError:
            progress.fail("failed")
            raise
        except KeyboardInterrupt:
            progress.fail("interrupted")
            raise

    def image_shell_path(self, tag: str, progress: Optional[Progress] = None) -> str:
        if progress is None:
            self.engine.run(["run", "--rm", tag, "/usr/local/bin/lubox", "__container-init-check"], capture=True)
            cp = self.engine.run(["run", "--rm", tag, "/bin/sh", "-lc", "cat /etc/lubox/shell"], capture=True)
        else:
            progress.detail("checking /etc/lubox metadata")
            self.engine.run_progress(["run", "--rm", tag, "/usr/local/bin/lubox", "__container-init-check"], progress)
            cp = self.engine.run_progress(["run", "--rm", tag, "/bin/sh", "-lc", "cat /etc/lubox/shell"], progress)
        shell_path = _decode_output(cp.stdout).strip()
        if not shell_path.startswith("/"):
            die(f"lubox: built image did not report absolute shell path: {shell_path!r}")
        return shell_path

    def create_args(
        self,
        name: str,
        tag: str,
        base_image: str,
        host_exec: bool,
        mount_dir: pathlib.Path,
        shell_path: str,
        bwrap: bool = False,
    ) -> List[str]:
        cname = container_name(name)
        sockets = self.socket_forward_plan(host_exec)
        if host_exec and not is_linux():
            self.seed_socket_forward_config(name, mount_dir, sockets.groups, sockets.gpg_home)
        self.warn_unforwarded_sockets(host_exec, sockets)
        args = ["create", "--name", cname, "--hostname", socket.gethostname(), "--cap-add", "NET_RAW"]
        if bwrap:
            profile = self.require_bwrap_profile()
            args += ["--security-opt", f"seccomp={profile}", "--label", f"{LABEL_PREFIX}.bwrap=true"]
        args += self.key_value_args("--label", self.create_labels(name, base_image, host_exec, sockets))
        args += self.env_args(self.create_env(name, cname, shell_path, host_exec, sockets))
        if is_linux():
            args += self.linux_session_mount_args(host_exec)
        args += self.create_mount_args(mount_dir, sockets)
        args += self.create_secret_args(name, host_exec)
        args += self.create_engine_identity_args(host_exec)
        args += [tag, "/bin/sh", "-lc", KEEPALIVE_COMMAND]
        return args

    def require_bwrap_profile(self) -> pathlib.Path:
        if self.engine.name != "docker":
            die("lubox: --bwrap currently supports Docker only")
        profile = pathlib.Path(__file__).resolve().parent.parent / "share" / "lubox" / "seccomp" / "bwrap.json"
        try:
            data = profile.read_bytes()
        except OSError as exc:
            die(f"lubox: bwrap seccomp profile unavailable: {profile}: {exc}")
        if hashlib.sha256(data).hexdigest() != BWRAP_PROFILE_SHA256:
            die(f"lubox: bwrap seccomp profile checksum mismatch: {profile}")
        return profile

    def replace_for_bwrap(self, name: str, info: Dict[str, Any], image: str, *, keep_backup: bool) -> str:
        if self.running_from_info(info):
            die("lubox: refusing bwrap reconfiguration of a RUNNING container; stop it from the host after saving your sessions")
        profile = load_json_file(self.require_bwrap_profile())
        config = bwrap_container_config(info, image, profile)
        api = DockerAPI(self.engine)  # Resolve connection before renaming anything.
        cname = container_name(name)
        backup = f"{cname}-before-bwrap-{secrets.token_hex(4)}"
        if self.engine.is_running(cname):
            die("lubox: container became running; refusing to reconfigure")
        self.engine.run(["rename", cname, backup])
        try:
            api.create(cname, config)
        except Exception:
            # Do not destroy an ambiguous API result or a container started by
            # somebody else. Preserve the original under its backup name.
            if self.engine.inspect_container(cname, required=False) is None:
                self.engine.run(["rename", backup, cname])
            else:
                eprint(f"lubox: original preserved as {backup}; inspect the new container before rollback")
            raise
        if not keep_backup:
            self.engine.run(["rm", backup])  # Only the never-started create template.
        return backup

    def reconfigure_bwrap(self, name: str) -> None:
        validate_box_name(name)
        self.require_bwrap_profile()
        info = self.require_container(name)
        if self.running_from_info(info):
            die("lubox: refusing bwrap reconfiguration of a RUNNING container. Save your sessions, then run `lubox stop NAME` and `lubox reconfigure NAME --bwrap` from the macOS/host terminal. No container was stopped or changed.")
        bwrap_container_config(info, str(info.get("Image") or ""), load_json_file(self.require_bwrap_profile()))
        cname = container_name(name)
        nonce = secrets.token_hex(4)
        snapshot = f"lubox/{name}:before-bwrap-{nonce}"
        # The container is already stopped: no process is paused or killed, and
        # its complete writable layer (including installed packages) is retained.
        self.engine.run(["commit", "--pause=false", cname, snapshot])
        self.engine.run(["run", "--rm", "--network=none", "--user", f"{self.ident.uid}:{self.ident.gid}",
                         "--entrypoint", "/bin/sh", snapshot, "-c", "test -x /usr/bin/bwrap"])
        backup = self.replace_for_bwrap(name, info, snapshot, keep_backup=True)
        print(f"lubox: original stopped container retained as {backup}")
        print(f"lubox: writable filesystem snapshot retained as {snapshot}")
        self.start(name, announce=False)
        self.engine.run(["exec", cname, "/usr/bin/bwrap", "--unshare-all", "--ro-bind", "/", "/", "--proc", "/proc", "--dev", "/dev", "--new-session", "--", "/bin/true"])
        print(f"lubox: enabled and verified bubblewrap in {cname}; only /proc submount restrictions relaxed, no extra capabilities")

    def socket_forward_plan(self, host_exec: bool) -> SocketForwardPlan:
        ssh_sock = current_ssh_auth_sock()
        gpg_home, gpg_sockets = current_gpg_info()
        ssh_agent = ssh_sock is not None and (is_linux() or host_exec)
        gpg_agent = bool(gpg_sockets) and (is_linux() or host_exec)
        return SocketForwardPlan(
            ssh_sock=ssh_sock,
            gpg_home=gpg_home,
            gpg_sockets=gpg_sockets,
            ssh_agent=ssh_agent,
            gpg_agent=gpg_agent,
            groups=tuple(
                self.socket_forward_groups(
                    ssh_agent=ssh_agent,
                    ssh_sock=ssh_sock,
                    gpg_agent=gpg_agent,
                    gpg_home=gpg_home,
                    gpg_sockets=gpg_sockets,
                )
            ),
        )

    def warn_unforwarded_sockets(self, host_exec: bool, sockets: SocketForwardPlan) -> None:
        if is_linux() or host_exec:
            return
        if sockets.ssh_sock is not None:
            eprint("lubox: SSH_AUTH_SOCK not forwarded because --no-host-exec disables macOS socket proxy")
        if sockets.gpg_sockets:
            eprint("lubox: GPG agent sockets not forwarded because --no-host-exec disables macOS socket proxy")

    def create_labels(self, name: str, base_image: str, host_exec: bool, sockets: SocketForwardPlan) -> Dict[str, str]:
        return {
            f"{LABEL_PREFIX}": "1",
            f"{LABEL_PREFIX}.name": name,
            f"{LABEL_PREFIX}.version": VERSION,
            f"{LABEL_PREFIX}.host_exec": "true" if host_exec else "false",
            f"{LABEL_PREFIX}.home": str(self.ident.home),
            f"{LABEL_PREFIX}.user": self.ident.username,
            f"{LABEL_PREFIX}.uid": str(self.ident.uid),
            f"{LABEL_PREFIX}.gid": str(self.ident.gid),
            f"{LABEL_PREFIX}.shell_basename": self.ident.shell_basename,
            f"{LABEL_PREFIX}.engine": self.engine.name,
            f"{LABEL_PREFIX}.base_image": base_image,
            f"{LABEL_PREFIX}.ssh_agent": "true" if sockets.ssh_agent else "false",
            f"{LABEL_PREFIX}.gpg_agent": "true" if sockets.gpg_agent else "false",
        }

    def create_env(self, name: str, cname: str, shell_path: str, host_exec: bool, sockets: SocketForwardPlan) -> List[Tuple[str, str]]:
        env = [
            ("HOME", str(self.ident.home)),
            ("USER", self.ident.username),
            ("LOGNAME", self.ident.username),
            ("SHELL", shell_path),
        ]
        env += self.lubox_exec_env(name, cname, host_exec)
        if is_linux() and host_exec:
            runtime_dir = self.linux_host_runtime_dir()
            if runtime_dir is not None:
                env.append(("XDG_RUNTIME_DIR", str(runtime_dir)))
        if sockets.ssh_agent:
            env.append(("SSH_AUTH_SOCK", container_ssh_auth_sock(self.ident.uid)))
            env.append(("LUBOX_SSH_AGENT_PROXY", "1" if not is_linux() else "0"))
        if sockets.gpg_agent and not is_linux():
            env.append(("GNUPGHOME", container_gpg_home(self.ident.uid)))
            env.append(("LUBOX_GPG_AGENT_PROXY", "1"))
        return env

    def create_mount_args(self, mount_dir: pathlib.Path, sockets: SocketForwardPlan) -> List[str]:
        args = [
            "--workdir",
            str(self.ident.home),
            "--mount",
            f"type=bind,src={self.ident.home},dst={self.ident.home}",
            "--mount",
            f"type=bind,src={mount_dir},dst=/run/lubox,readonly",
        ]
        if is_linux():
            args += self.socket_forward_mount_args(sockets.groups)
        return args

    def create_secret_args(self, name: str, host_exec: bool) -> List[str]:
        if self.engine.name != "podman" or not host_exec:
            return []
        return [
            "--secret",
            f"{secret_name(name)},type=mount,target={PODMAN_TOKEN_PATH},uid={self.ident.uid},gid={self.ident.gid},mode=0400",
        ]

    def uses_host_network(self, host_exec: bool) -> bool:
        return is_linux() or (self.engine.name == "docker" and host_exec)

    def create_engine_identity_args(self, host_exec: bool) -> List[str]:
        if self.engine.name == "podman":
            args = ["--userns=keep-id", "--user", f"{self.ident.uid}:{self.ident.gid}"]
            if is_linux():
                args += ["--group-add", "keep-groups", "--network=host", "--security-opt", "label=disable"]
            return args
        args = ["--user", f"{self.ident.uid}:{self.ident.gid}"]
        if self.uses_host_network(host_exec):
            args += ["--network=host"]
        if is_linux():
            for gid in sorted(set(os.getgroups())):
                args += ["--group-add", str(gid)]
        return args

    def key_value_args(self, flag: str, values: Dict[str, str]) -> List[str]:
        args: List[str] = []
        for key, value in values.items():
            args += [flag, f"{key}={value}"]
        return args

    def socket_forward_groups(
        self,
        *,
        ssh_agent: bool,
        ssh_sock: Optional[pathlib.Path],
        gpg_agent: bool,
        gpg_home: Optional[pathlib.Path],
        gpg_sockets: Dict[str, pathlib.Path],
        container_id: str = "",
    ) -> List[SocketForwardGroup]:
        groups: List[SocketForwardGroup] = []
        if ssh_agent and ssh_sock is not None:
            groups.append(self.ssh_socket_forward_group(ssh_sock, container_ssh_auth_sock(self.ident.uid), container_id))
        if gpg_agent and gpg_sockets:
            groups.append(
                self.gpg_socket_forward_group(
                    tuple(
                        SocketForward(key, gpg_sockets[key], container_gpg_proxy_socket_path(key, self.ident.uid))
                        for key in sorted(gpg_sockets)
                    ),
                    str(gpg_home or ""),
                    container_id,
                )
            )
        return groups

    def ssh_socket_forward_group(self, source: pathlib.Path, target: str, container_id: str) -> SocketForwardGroup:
        pid_file = container_ssh_agent_pid(self.ident.uid)
        return SocketForwardGroup(
            kind="ssh",
            name="ssh-agent",
            label="SSH agent",
            forwards=(SocketForward("agent", source, target),),
            pid_file=pid_file,
            marker_text=f"{container_id}:{source}",
            proxy_command=(
                "/usr/local/bin/lubox",
                "__ssh-agent-proxy-client",
                "--socket-path",
                target,
                "--pid-file",
                pid_file,
            ),
            check_command=(
                "/usr/local/bin/lubox",
                "__ssh-agent-proxy-client",
                "--check",
                "--socket-path",
                target,
                "--pid-file",
                pid_file,
            ),
        )

    def gpg_socket_forward_group(
        self,
        forwards: Tuple[SocketForward, ...],
        host_home: str,
        container_id: str,
        proxy_home: Optional[str] = None,
    ) -> SocketForwardGroup:
        pid_file = container_gpg_agent_pid(self.ident.uid)
        proxy_home = proxy_home or container_gpg_home(self.ident.uid)
        source_text = ",".join(f"{item.key}={item.source}" for item in forwards)
        return SocketForwardGroup(
            kind="gpg",
            name="gpg-agent",
            label="GPG agent",
            forwards=forwards,
            pid_file=pid_file,
            marker_text=f"{container_id}:{host_home}:{source_text}",
            proxy_command=(
                "/usr/local/bin/lubox",
                "__gpg-agent-proxy-client",
                "--home",
                proxy_home,
                "--pid-file",
                pid_file,
            ),
            proxy_env=(("GNUPGHOME", proxy_home),),
            check_command=(
                "/usr/local/bin/lubox",
                "__gpg-agent-proxy-client",
                "--check",
                "--home",
                proxy_home,
                "--pid-file",
                pid_file,
            ),
        )

    def current_socket_forward_groups(self, name: str, info: Dict[str, Any]) -> List[SocketForwardGroup]:
        ssh_agent = self.ssh_agent_enabled(name, info)
        gpg_agent = self.gpg_agent_enabled(name, info)
        ssh_sock = current_ssh_auth_sock() if ssh_agent else None
        gpg_home: Optional[pathlib.Path] = None
        gpg_sockets: Dict[str, pathlib.Path] = {}
        if gpg_agent:
            gpg_home, gpg_sockets = current_gpg_info()
        return self.socket_forward_groups(
            ssh_agent=ssh_agent,
            ssh_sock=ssh_sock,
            gpg_agent=gpg_agent,
            gpg_home=gpg_home,
            gpg_sockets=gpg_sockets,
            container_id=self.container_id_from_info(info),
        )

    def socket_forward_mount_args(self, groups: Iterable[SocketForwardGroup]) -> List[str]:
        args: List[str] = []
        for group in groups:
            for forward in group.forwards:
                suffix = ",readonly" if forward.readonly else ""
                args += ["--mount", f"type=bind,src={forward.source},dst={forward.target}{suffix}"]
        return args

    def seed_socket_forward_config(
        self,
        name: str,
        mount_dir: pathlib.Path,
        groups: Iterable[SocketForwardGroup],
        gpg_home: Optional[pathlib.Path],
    ) -> None:
        cfg_path = mount_dir / "hostexec.json"
        try:
            cfg = load_json_file(cfg_path)
        except (OSError, json.JSONDecodeError, LuboxError):
            return
        for group in groups:
            if group.kind == "ssh" and group.forwards:
                forward = group.forwards[0]
                cfg["ssh_agent"] = {
                    "enabled": False,
                    "host": self.hostexec_host(),
                    "port": 0,
                    "socket_path": forward.target,
                    "host_path": str(forward.source),
                    "token_path": "",
                }
            elif group.kind == "gpg":
                cfg["gpg_agent"] = {
                    "enabled": False,
                    "host": self.hostexec_host(),
                    "port": 0,
                    "home": str(gpg_home or ""),
                    "proxy_home": container_gpg_home(self.ident.uid),
                    "token_path": "",
                    "sockets": group.sockets_config(),
                }
        atomic_write_json(cfg_path, cfg, 0o644)

    def socket_forward_groups_from_config(self, cfg: Dict[str, Any]) -> List[SocketForwardGroup]:
        groups: List[SocketForwardGroup] = []
        container_id = str(cfg.get("container_id") or "")
        ssh_cfg = cfg.get("ssh_agent")
        if isinstance(ssh_cfg, dict) and ssh_cfg.get("enabled"):
            socket_path = str(ssh_cfg.get("socket_path") or container_ssh_auth_sock(self.ident.uid))
            host_path = str(ssh_cfg.get("host_path") or "")
            groups.append(self.ssh_socket_forward_group(pathlib.Path(host_path or socket_path), socket_path, container_id))
        gpg_cfg = cfg.get("gpg_agent")
        if isinstance(gpg_cfg, dict) and gpg_cfg.get("enabled"):
            sockets = gpg_cfg.get("sockets")
            if isinstance(sockets, dict) and sockets:
                proxy_home = str(gpg_cfg.get("proxy_home") or container_gpg_home(self.ident.uid))
                host_home = str(gpg_cfg.get("home") or "")
                forwards: List[SocketForward] = []
                for key in sorted(sockets):
                    item = sockets.get(key)
                    if not isinstance(item, dict):
                        continue
                    socket_path = str(item.get("socket_path") or container_gpg_proxy_socket_path(key, self.ident.uid))
                    host_path = str(item.get("host_path") or "")
                    forwards.append(SocketForward(str(key), pathlib.Path(host_path or socket_path), socket_path))
                if forwards:
                    groups.append(self.gpg_socket_forward_group(tuple(forwards), host_home, container_id, proxy_home))
        return groups

    def linux_session_env_keys(self) -> List[str]:
        keys = [
            "DISPLAY",
            "WAYLAND_DISPLAY",
            "XDG_RUNTIME_DIR",
            "XAUTHORITY",
            "DBUS_SESSION_BUS_ADDRESS",
            "PULSE_SERVER",
            "PIPEWIRE_RUNTIME_DIR",
            "COLORTERM",
            "TERM",
            "LANG",
        ]
        for key in sorted(os.environ):
            if key.startswith("LC_"):
                keys.append(key)
        return keys

    def linux_host_runtime_dir(self) -> Optional[pathlib.Path]:
        if not is_linux():
            return None
        candidates: List[pathlib.Path] = []
        runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
        if runtime_dir:
            candidates.append(pathlib.Path(runtime_dir))
        candidates.append(pathlib.Path("/run") / "user" / str(self.ident.uid))
        seen = set()
        for candidate in candidates:
            key = str(candidate)
            if key in seen:
                continue
            seen.add(key)
            try:
                if candidate.is_dir():
                    return candidate
            except OSError:
                continue
        return None

    def linux_session_env(self, host_exec: bool = False) -> List[Tuple[str, str]]:
        env: List[Tuple[str, str]] = []
        runtime_dir = self.linux_host_runtime_dir() if host_exec else None
        for key in self.linux_session_env_keys():
            if key == "XDG_RUNTIME_DIR" and runtime_dir is not None:
                value = str(runtime_dir)
            else:
                value = os.environ.get(key)
            if value:
                env.append((key, value))
        return env

    def linux_session_mount_args(self, host_exec: bool) -> List[str]:
        args: List[str] = []
        if os.environ.get("DISPLAY") and pathlib.Path("/tmp/.X11-unix").exists():
            args += ["--mount", "type=bind,src=/tmp/.X11-unix,dst=/tmp/.X11-unix"]
        runtime_dir = self.linux_host_runtime_dir() if host_exec else None
        if runtime_dir is not None:
            args += ["--mount", f"type=bind,src={runtime_dir},dst={runtime_dir}"]
        if pathlib.Path("/dev/dri").exists():
            args += ["--device", "/dev/dri"]
        return args

    def linux_host_runtime_mount_present(self, name: str, runtime_dir: pathlib.Path) -> Optional[bool]:
        info = self.engine.inspect_container(container_name(name), required=False)
        if not info:
            return None
        mounts = info.get("Mounts")
        if not isinstance(mounts, list):
            return False
        source = str(runtime_dir)
        target = str(runtime_dir)
        for item in mounts:
            if not isinstance(item, dict):
                continue
            if str(item.get("Source") or "") == source and str(item.get("Destination") or "") == target:
                return True
        return False

    def container_shell_path(self) -> str:
        common = [
            f"/usr/bin/{self.ident.shell_basename}",
            f"/bin/{self.ident.shell_basename}",
            f"/usr/local/bin/{self.ident.shell_basename}",
        ]
        if self.ident.shell_basename == "sh":
            common.append("/bin/sh")
        return common[0]

    def host_engine_wrapper_dirs(self) -> List[str]:
        dirs: List[str] = []
        for name in ("podman", "docker"):
            found, _ignored = Engine.actual_path(name)
            if found:
                dirs.append(str(self.ident.home / ".local" / "bin" / f"lubox-{name}"))
        return dirs

    def container_path_value(self, host_exec: bool) -> str:
        standard = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
        parts = []
        if host_exec:
            parts += self.host_engine_wrapper_dirs()
        parts += [str(self.ident.home / ".local" / "bin"), str(self.ident.home / "bin"), standard]
        return ":".join(parts)

    def hostexec_mount_dir(self, name: str) -> pathlib.Path:
        return self.paths.mount_dir(name, self.engine.name)

    def hostexec_config_file(self, name: str) -> pathlib.Path:
        return self.hostexec_mount_dir(name) / "hostexec.json"

    def prepare_hostexec_files(self, name: str, host_exec: bool) -> pathlib.Path:
        mount_dir = self.hostexec_mount_dir(name)
        if is_macos() and self.engine.name == "podman" and not path_under(mount_dir, self.ident.home):
            die(
                f"lubox: cannot mount host-exec config path into Podman machine: {mount_dir}\n"
                'Recreate/configure the Podman machine with this path shared, or use: podman machine init -v "$HOME:$HOME" --now'
            )
        token_file = self.paths.token_file(name)
        if host_exec:
            token = secrets.token_bytes(32)
            atomic_write_bytes(token_file, token, 0o600)
            if self.engine.name == "podman":
                self.create_podman_secret(name, token)
            else:
                atomic_write_bytes(mount_dir / "hostexec.token", token, 0o600)
        else:
            safe_unlink(token_file)
            safe_unlink(mount_dir / "hostexec.token")
        self.write_initial_config(name, host_exec, mount_dir)
        return mount_dir

    def write_initial_config(self, name: str, host_exec: bool, mount_dir: pathlib.Path) -> None:
        cfg = {
            "version": 1,
            "enabled": False if not host_exec else False,
            "box_name": name,
            "container_name": container_name(name),
            "container_id": "",
            "host": self.hostexec_host(),
            "port": 0,
            "token_path": self.container_token_path(),
            "pty_default": True,
        }
        if not host_exec:
            cfg["token_path"] = ""
        atomic_write_json(mount_dir / "hostexec.json", cfg, 0o644)

    def write_disabled_config_preserving_sockets(self, name: str, mount_dir: pathlib.Path) -> None:
        cfg_path = mount_dir / "hostexec.json"
        try:
            cfg = load_json_file(cfg_path)
        except (OSError, json.JSONDecodeError, LuboxError):
            self.write_initial_config(name, False, mount_dir)
            return
        cfg["enabled"] = False
        cfg["container_id"] = ""
        cfg["port"] = 0
        cfg["token_path"] = ""
        ssh_cfg = cfg.get("ssh_agent")
        if isinstance(ssh_cfg, dict):
            ssh_cfg["enabled"] = False
            ssh_cfg["port"] = 0
            ssh_cfg["token_path"] = ""
        gpg_cfg = cfg.get("gpg_agent")
        if isinstance(gpg_cfg, dict):
            gpg_cfg["enabled"] = False
            gpg_cfg["port"] = 0
            gpg_cfg["token_path"] = ""
        atomic_write_json(cfg_path, cfg, 0o644)

    def create_podman_secret(self, name: str, token: bytes) -> None:
        sec = secret_name(name)
        self.engine.run(["secret", "rm", sec], check=False, capture=True)
        self.engine.run(["secret", "create", sec, "-"], input_data=token, capture=True)

    def ensure_podman_secret(self, name: str) -> None:
        if self.engine.name != "podman":
            return
        token_path = self.paths.token_file(name)
        if not token_path.exists():
            die(f"lubox: host-exec token missing; recreate container: {name}")
        cp = self.engine.run(["secret", "inspect", secret_name(name)], check=False, capture=True)
        if cp.returncode != 0:
            self.create_podman_secret(name, read_token(token_path))

    def container_token_path(self) -> str:
        if self.engine.name == "podman":
            return PODMAN_TOKEN_PATH
        return CONTAINER_TOKEN_PATH

    def hostexec_host(self) -> str:
        if is_linux():
            return "127.0.0.1"
        if self.engine.name == "podman":
            return "host.containers.internal"
        return "host.docker.internal"

    def hostexec_enabled(self, name: str, info: Optional[Dict[str, Any]] = None) -> bool:
        if info is None:
            info = self.require_container(name)
        labels = self.labels_from_info(info or {})
        return labels.get(f"{LABEL_PREFIX}.host_exec") == "true"

    def ssh_agent_enabled(self, name: str, info: Optional[Dict[str, Any]] = None) -> bool:
        if info is None:
            info = self.require_container(name)
        labels = self.labels_from_info(info or {})
        return labels.get(f"{LABEL_PREFIX}.ssh_agent") == "true"


    def gpg_agent_enabled(self, name: str, info: Optional[Dict[str, Any]] = None) -> bool:
        if info is None:
            info = self.require_container(name)
        labels = self.labels_from_info(info or {})
        configured = labels.get(f"{LABEL_PREFIX}.gpg_agent")
        if configured is not None:
            return configured == "true"
        return self.hostexec_enabled(name, info) and bool(current_gpg_info()[1])

    def gpg_agent_label_enabled(self, info: Dict[str, Any]) -> bool:
        labels = self.labels_from_info(info or {})
        return labels.get(f"{LABEL_PREFIX}.gpg_agent") == "true"

    def labels_from_info(self, info: Dict[str, Any]) -> Dict[str, str]:
        config = info.get("Config", {})
        labels = config.get("Labels", {}) if isinstance(config, dict) else {}
        if labels is None:
            return {}
        return {str(k): str(v) for k, v in labels.items()}

    def env_from_info(self, info: Dict[str, Any]) -> Dict[str, str]:
        config = info.get("Config", {})
        env_list = config.get("Env", []) if isinstance(config, dict) else []
        env: Dict[str, str] = {}
        if isinstance(env_list, list):
            for item in env_list:
                if isinstance(item, str) and "=" in item:
                    key, value = item.split("=", 1)
                    env[key] = value
        return env

    def running_from_info(self, info: Dict[str, Any]) -> bool:
        state = info.get("State", {})
        if isinstance(state, dict):
            return bool(state.get("Running")) or str(state.get("Status", "")).lower() == "running"
        return False

    def container_id_from_info(self, info: Dict[str, Any]) -> str:
        return str(info.get("Id") or "")

    def ensure_runtime_mount_files(self, name: str, host_exec: Optional[bool] = None, running: bool = False) -> None:
        if host_exec is None:
            host_exec = self.hostexec_enabled(name)
        if not host_exec:
            mount_dir = self.hostexec_mount_dir(name)
            self.write_initial_config(name, False, mount_dir)
            return
        mount_dir = self.hostexec_mount_dir(name)
        token_path = self.paths.token_file(name)
        if not token_path.exists():
            die(f"lubox: host-exec token missing; recreate container: {name}")
        if self.engine.name == "docker":
            atomic_write_bytes(mount_dir / "hostexec.token", read_token(token_path), 0o600)
        elif self.engine.name == "podman" and not running:
            self.ensure_podman_secret(name)
        if not (mount_dir / "hostexec.json").exists():
            self.write_initial_config(name, True, mount_dir)

    def require_container(self, name: str) -> Dict[str, Any]:
        validate_box_name(name)
        return self.engine.inspect_container(container_name(name), required=True) or {}

    def start(
        self,
        name: str,
        *,
        start_server: bool = True,
        announce: bool = True,
        ensure_engine_ready: bool = True,
        start_socket_proxies: bool = True,
    ) -> Dict[str, Any]:
        if ensure_engine_ready:
            self.engine.ensure_ready(start_machine=True)
        info = self.require_container(name)
        running = self.running_from_info(info)
        host_exec = self.hostexec_enabled(name, info)
        ssh_agent = self.ssh_agent_enabled(name, info)
        gpg_agent = self.gpg_agent_enabled(name, info)
        self.ensure_runtime_mount_files(name, host_exec, running=running)
        cname = container_name(name)
        if not running:
            self.engine.run(["start", cname], capture=True)
            running = True
        self.sync_container_lubox(cname, name)
        if start_server and host_exec:
            self.ensure_hostexec_server(name, host_exec, ssh_agent, gpg_agent)
            if start_socket_proxies:
                self.ensure_socket_forward_proxies(name, self.current_socket_forward_groups(name, info))
        if announce:
            print(f"started {cname}")
        return info

    def script_sync_stamp(self) -> str:
        script_path = pathlib.Path(__file__).resolve()
        try:
            st = script_path.stat()
            return f"{VERSION}:{int(st.st_mtime)}:{st.st_size}"
        except OSError:
            return VERSION

    def hostexec_server_stamp_file(self, name: str) -> pathlib.Path:
        return self.paths.runtime_dir(name) / "hostexec-server.stamp"

    def hostexec_server_stamp_current(self, name: str) -> bool:
        try:
            return self.hostexec_server_stamp_file(name).read_text(encoding="utf-8").strip() == self.script_sync_stamp()
        except OSError:
            return False

    def sync_container_lubox(self, cname: str, name: str) -> None:
        stamp = self.script_sync_stamp()
        stamp_file = self.paths.state_dir(name) / "container-lubox-sync.stamp"
        try:
            if stamp_file.read_text(encoding="utf-8").strip() == stamp:
                return
        except OSError:
            pass
        script_path = pathlib.Path(__file__).resolve()
        quoted = shlex.quote(str(script_path))
        cmd = (
            f"if [ -x {quoted} ]; then "
            f"sudo install -m 0755 {quoted} /usr/local/bin/lubox "
            "&& sudo /usr/local/bin/lubox __install-xdg-open; "
            "fi"
        )
        cp = self.engine.run(["exec", cname, "/bin/sh", "-lc", cmd], check=False, capture=True)
        if cp.returncode != 0:
            cp = self.engine.run(["exec", "--user", "0:0", cname, "/bin/sh", "-lc", cmd], check=False, capture=True)
        if cp.returncode == 0:
            atomic_write_text(stamp_file, stamp + "\n", 0o600)

    def stop(self, name: str) -> None:
        validate_box_name(name)
        cname = container_name(name)
        if not self.engine.container_exists(cname):
            die(f"lubox: container not found: {cname}\nTry: lubox create {name}")
        self.stop_server(name)
        self.stop_code_server_tunnels(name)
        if self.engine.is_running(cname):
            self.engine.run(["stop", cname], capture=True)
        print(f"stopped {cname}")

    def destroy(self, name: str, force: bool) -> None:
        validate_box_name(name)
        cname = container_name(name)
        self.stop_server(name)
        self.stop_code_server_tunnels(name)
        if self.engine.container_exists(cname):
            if force:
                self.engine.run(["rm", "-f", cname], capture=True)
            else:
                if self.engine.is_running(cname):
                    self.engine.run(["stop", cname], capture=True)
                self.engine.run(["rm", cname], capture=True)
        if self.engine.name == "podman":
            self.engine.run(["secret", "rm", secret_name(name)], check=False, capture=True)
        shutil.rmtree(self.paths.state / name, ignore_errors=True)
        shutil.rmtree(self.paths.runtime / name, ignore_errors=True)
        if force:
            self.engine.run(["rmi", image_name(name)], check=False, capture=True)
            print(f"destroyed {cname} and removed image {image_name(name)}")
        else:
            print(f"destroyed {cname}; image kept: {image_name(name)}")

    def enter(self, name: str, cmd: Sequence[str], *, xquartz: bool = False, fast: bool = False) -> int:
        if fast:
            result = self.enter_fast_linux(name, cmd)
            if result is not None:
                return result
        info = self.enter_info(name)
        cname = container_name(name)
        self.ensure_enter_ready(name, cname, info)
        exec_args = self.enter_exec_args(name, cname, info, cmd, xquartz=xquartz)
        return subprocess.call(self.engine.argv(exec_args))

    def enter_fast_linux(self, name: str, cmd: Sequence[str]) -> Optional[int]:
        if not is_linux():
            return None
        validate_box_name(name)
        cname = container_name(name)
        cfg = self.load_hostexec_config_if_present(name)
        if cfg is None:
            return None
        host_exec = bool(cfg.get("enabled"))
        if not host_exec and self.paths.token_file(name).exists():
            return None
        cwd = self.fast_container_cwd()
        shell_path = self.container_shell_path()
        exec_args = ["exec"]
        if sys.stdin.isatty() and sys.stdout.isatty():
            exec_args.append("-it")
        elif sys.stdin.isatty():
            exec_args.append("-i")
        exec_args += ["--user", f"{self.ident.uid}:{self.ident.gid}", "-w", cwd]
        exec_args += self.env_args(self.lubox_exec_env(name, cname, host_exec))
        exec_args += self.env_args(self.linux_session_env(host_exec))
        run_cmd = strip_dashdash(cmd)
        if run_cmd:
            exec_args += [cname, shell_path, "-l", "-c", shlex.join(run_cmd)]
        else:
            exec_args += [cname, shell_path, "-l"]
        return subprocess.call(self.engine.argv(exec_args))

    def fast_container_cwd(self) -> str:
        cwd = pathlib.Path.cwd()
        if cwd.exists() and path_under(cwd, self.ident.home):
            return str(cwd)
        return str(self.ident.home)

    def enter_info(self, name: str) -> Dict[str, Any]:
        try:
            return self.require_container(name)
        except CommandError as exc:
            if not self.should_start_machine_after_error(exc):
                raise
            eprint("lubox: Podman machine is not running; starting it")
            self.engine.ensure_ready(start_machine=True)
            return self.require_container(name)

    def ensure_enter_ready(self, name: str, cname: str, info: Dict[str, Any]) -> None:
        if not self.running_from_info(info):
            self.ensure_enter_runtime(name, info)
        else:
            self.sync_container_lubox(cname, name)
            self.ensure_enter_socket_proxies(name, info)
        if self.enter_preflight_needed(name, info):
            preflight = self.enter_preflight(name, cname, info)
            if preflight.returncode != 0:
                detail = self.command_failure_detail(preflight)
                if self.preflight_missing_socket_proxy(detail):
                    self.ensure_enter_socket_proxies(name, info)
                elif engine_unavailable_error(self.engine.name, preflight.stderr, preflight.stdout):
                    eprint("lubox: Podman machine is not running; starting it")
                    self.engine.ensure_ready(start_machine=True)
                    self.ensure_enter_runtime(name, info)
                else:
                    self.ensure_enter_runtime(name, info)
                preflight = self.enter_preflight(name, cname, info)
                if preflight.returncode != 0:
                    detail = self.command_failure_detail(preflight)
                    die(f"lubox: enter preflight failed for {name}: {detail}")

    def ensure_enter_socket_proxies(self, name: str, info: Dict[str, Any]) -> None:
        if not self.hostexec_enabled(name, info):
            return
        if is_linux():
            self.ensure_hostexec_server(name, True, False, False)
            return
        ssh_agent = self.ssh_agent_enabled(name, info)
        gpg_agent = self.gpg_agent_enabled(name, info)
        server_current = False
        pid_file = self.paths.pid_file(name)
        try:
            pid = int(pid_file.read_text(encoding="utf-8").strip())
        except (ValueError, OSError):
            pid = 0
        if pid and looks_like_pid_running(pid):
            server_current = self.hostexec_server_stamp_current(name) and not self.hostexec_server_needs_restart_for_agents(name, ssh_agent, gpg_agent)
        self.ensure_hostexec_server(name, True, ssh_agent, gpg_agent)
        cfg = self.load_hostexec_config_if_present(name) or {}
        if cfg.get("enabled"):
            self.ensure_socket_forward_proxies(name, self.socket_forward_groups_from_config(cfg), missing_only=server_current)

    def preflight_missing_socket_proxy(self, detail: str) -> bool:
        return "proxy not running" in detail or "proxy socket missing" in detail

    def command_failure_detail(self, cp: subprocess.CompletedProcess) -> str:
        return _decode_output(cp.stderr).strip() or _decode_output(cp.stdout).strip() or f"exit {cp.returncode}"

    def enter_exec_args(
        self,
        name: str,
        cname: str,
        info: Dict[str, Any],
        cmd: Sequence[str],
        *,
        xquartz: bool,
    ) -> List[str]:
        cwd = self.container_cwd(cname)
        shell_path = self.read_container_shell(cname, info)
        exec_args = ["exec"]
        if sys.stdin.isatty() and sys.stdout.isatty():
            exec_args.append("-it")
        elif sys.stdin.isatty():
            exec_args.append("-i")
        exec_args += ["--user", f"{self.ident.uid}:{self.ident.gid}", "-w", cwd]
        exec_args += self.exec_env_args(cname, name, info=info, auto_start_xquartz=xquartz)
        run_cmd = strip_dashdash(cmd)
        if run_cmd:
            exec_args += [cname, shell_path, "-l", "-c", shlex.join(run_cmd)]
        else:
            exec_args += [cname, shell_path, "-l"]
        return exec_args

    def should_start_machine_after_error(self, exc: CommandError) -> bool:
        if not (is_macos() and self.engine.name == "podman"):
            return False
        return engine_unavailable_error(self.engine.name, exc.stderr)

    def enter_preflight_needed(self, name: str, info: Dict[str, Any]) -> bool:
        if is_linux():
            return False
        return self.hostexec_enabled(name, info) or self.ssh_agent_enabled(name, info) or self.gpg_agent_label_enabled(info)

    def enter_preflight(self, name: str, cname: str, info: Dict[str, Any]) -> subprocess.CompletedProcess:
        host_exec = self.hostexec_enabled(name, info)
        ssh_agent = self.ssh_agent_enabled(name, info)
        gpg_agent = self.gpg_agent_label_enabled(info)
        if not is_linux():
            cfg = self.load_hostexec_config_if_present(name) or {}
            ssh_cfg = cfg.get("ssh_agent")
            gpg_cfg = cfg.get("gpg_agent")
            ssh_agent = isinstance(ssh_cfg, dict) and bool(ssh_cfg.get("enabled"))
            gpg_agent = isinstance(gpg_cfg, dict) and bool(gpg_cfg.get("enabled"))
        argv = self.lubox_exec_prefix(cname, name, host_exec)
        argv += [
            "python3",
            "-c",
            ENTER_PREFLIGHT_SCRIPT,
            str(self.ident.uid),
            "1" if host_exec else "0",
            "1" if ssh_agent and not is_linux() else "0",
            "1" if gpg_agent and not is_linux() else "0",
        ]
        return self.engine.run(
            argv,
            check=False,
            capture=True,
            timeout=20,
        )

    def ensure_enter_runtime(self, name: str, info: Dict[str, Any]) -> None:
        host_exec = self.hostexec_enabled(name, info)
        cname = container_name(name)
        self.ensure_runtime_mount_files(name, host_exec, running=self.running_from_info(info))
        if not self.running_from_info(info):
            self.engine.run(["start", cname], capture=True)
            self.sync_container_lubox(cname, name)
        if not host_exec:
            return
        self.restart_hostexec_server_from_config(name, info)
        cfg = self.load_hostexec_config_if_present(name) or {}
        self.ensure_socket_forward_proxies(name, self.socket_forward_groups_from_config(cfg))

    def exec(self, name: str, cmd: Sequence[str]) -> int:
        run_cmd = strip_dashdash(cmd)
        if not run_cmd:
            die("lubox: exec requires command after --")
        self.start(name, start_server=True, announce=False)
        cname = container_name(name)
        cwd = self.container_cwd(cname)
        exec_args = ["exec"]
        if sys.stdin.isatty() and sys.stdout.isatty():
            exec_args.append("-it")
        exec_args += ["--user", f"{self.ident.uid}:{self.ident.gid}", "-w", cwd]
        exec_args += self.exec_env_args(cname, name)
        exec_args += [cname] + run_cmd
        return subprocess.call(self.engine.argv(exec_args))

    def code_server(self, name: str, args: argparse.Namespace) -> int:
        info = self.start(name, start_server=True, announce=False)
        cname = container_name(name)
        host_exec = self.hostexec_enabled(name, info)
        target = self.code_server_target(cname, args.path)
        bin_path = self.ensure_code_server_installed(cname, reinstall=bool(args.reinstall))
        if args.install_only:
            print(bin_path)
            return 0
        host_port = int(args.port) if args.port is not None else self.choose_random_high_port()
        container_port = int(args.container_port) if args.container_port is not None else host_port
        auth = str(args.auth)
        password = str(args.password or "")
        if args.host:
            auth = "password"
            password = secrets.token_urlsafe(18)
        elif auth == "password" and not password:
            password = secrets.token_urlsafe(18)
        if not self.local_port_available_on("0.0.0.0" if args.host else "127.0.0.1", host_port):
            die(f"lubox: local port already in use: {host_port}")
        bind_host = "127.0.0.1"
        if args.host and not (is_macos() and self.engine.name == "podman"):
            bind_host = "0.0.0.0"
        code_proc = self.start_code_server_foreground(
            name,
            cname,
            bin_path,
            container_port,
            target,
            auth,
            password,
            bind_host,
            host_exec,
        )
        proxy_proc: Optional[subprocess.Popen] = None
        listen_host = "0.0.0.0" if args.host else "127.0.0.1"
        try:
            self.wait_code_server_ready(cname, container_port, code_proc)
            if is_macos() and self.engine.name == "podman":
                proxy_proc = self.start_code_server_proxy_foreground(name, cname, listen_host, host_port, container_port)
                public_port = host_port
            elif self.uses_host_network(host_exec):
                if host_port != container_port:
                    eprint("lubox: --port cannot remap on host-network containers; using --container-port")
                public_port = container_port
            else:
                die("lubox: code-server supports host-network containers and macOS Podman")
        except Exception:
            self.terminate_process(code_proc)
            if proxy_proc is not None:
                self.terminate_process(proxy_proc)
            raise
        url = f"http://127.0.0.1:{public_port}/"
        print(f"code-server: {url}")
        print(f"port: {public_port}")
        if args.host:
            print(f"listen: 0.0.0.0:{public_port}")
        if auth == "password":
            print(f"password: {password}")
        sys.stdout.flush()
        if not args.no_open:
            self.open_url(url)
        try:
            return normalize_exit_code(code_proc.wait())
        except KeyboardInterrupt:
            self.terminate_process(code_proc, signal.SIGINT)
            if proxy_proc is not None:
                self.terminate_process(proxy_proc, signal.SIGINT)
            return 130
        finally:
            if proxy_proc is not None:
                self.terminate_process(proxy_proc)
            self.stop_code_server_process(cname, container_port)

    def code_server_target(self, cname: str, value: str) -> str:
        if not value or value == ".":
            return self.container_cwd(cname)
        path = pathlib.Path(value)
        if path.is_absolute():
            return value
        host_path = pathlib.Path.cwd() / value
        try:
            host_path = host_path.resolve()
        except OSError:
            pass
        if path_under(host_path, self.ident.home):
            return str(host_path)
        return value

    def ensure_code_server_installed(self, cname: str, *, reinstall: bool = False) -> str:
        check_cmd = (
            'p="$HOME/.local/share/lubox/code-server/current/bin/code-server"; '
            'if [ -x "$p" ]; then printf "%s\\n" "$p"; '
            'elif command -v code-server >/dev/null 2>&1; then command -v code-server; fi'
        )
        if not reinstall:
            cp = self.engine.run(["exec", cname, "sh", "-lc", check_cmd], check=False, capture=True)
            found = _decode_output(cp.stdout).strip().splitlines()
            if cp.returncode == 0 and found:
                return found[0]
        eprint(f"lubox: installing code-server in {cname.removeprefix('lubox-')} (first run only)")
        cp = self.engine.run(
            ["exec", "-i", cname, "python3", "-"],
            check=False,
            capture=True,
            input_data=CODE_SERVER_INSTALL_SCRIPT,
            timeout=900,
        )
        if cp.returncode != 0:
            stderr = _decode_output(cp.stderr).strip()
            stdout = _decode_output(cp.stdout).strip()
            detail = stderr or stdout or f"exit {cp.returncode}"
            die(f"lubox: failed to install code-server in {cname}: {detail}")
        lines = [line.strip() for line in _decode_output(cp.stdout).splitlines() if line.strip()]
        if not lines:
            die("lubox: code-server install did not report binary path")
        return lines[-1]

    def choose_random_high_port(self) -> int:
        for _ in range(256):
            port = 49152 + secrets.randbelow(65535 - 49152 + 1)
            if self.local_port_available_on("127.0.0.1", port):
                return port
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            sock.bind(("127.0.0.1", 0))
            return int(sock.getsockname()[1])
        finally:
            sock.close()

    def local_port_available_on(self, host: str, port: int) -> bool:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            sock.bind((host, port))
            return True
        except OSError:
            return False
        finally:
            sock.close()

    def start_code_server_foreground(
        self,
        name: str,
        cname: str,
        bin_path: str,
        port: int,
        target: str,
        auth: str,
        password: str,
        bind_host: str,
        host_exec: bool,
    ) -> subprocess.Popen:
        exec_args = ["exec", "-i", "--user", f"{self.ident.uid}:{self.ident.gid}"]
        exec_args += self.env_args(self.lubox_exec_env(name, cname, host_exec))
        if is_linux():
            exec_args += self.env_args(self.linux_session_env(host_exec))
        if auth == "password":
            exec_args += ["--env", f"PASSWORD={password}"]
        if self.ssh_agent_enabled(name):
            exec_args += ["--env", f"SSH_AUTH_SOCK={container_ssh_auth_sock(self.ident.uid)}"]
        if self.gpg_agent_enabled(name) and not is_linux():
            exec_args += ["--env", f"GNUPGHOME={container_gpg_home(self.ident.uid)}"]
            exec_args += ["--env", "LUBOX_GPG_AGENT_PROXY=1"]
        exec_args += [
            cname,
            bin_path,
            "--bind-addr",
            f"{bind_host}:{port}",
            "--auth",
            auth,
            target,
        ]
        return self.engine.popen(exec_args, stdin=subprocess.DEVNULL, stdout=None, stderr=None)

    def wait_code_server_ready(self, cname: str, port: int, proc: subprocess.Popen) -> None:
        deadline = time.time() + 30
        while time.time() < deadline:
            if proc.poll() is not None:
                die(f"lubox: code-server exited early with status {normalize_exit_code(proc.returncode)}")
            if self.container_port_open(cname, port):
                return
            time.sleep(0.25)
        die(f"lubox: timed out waiting for code-server on port {port}")

    def start_code_server_proxy_foreground(
        self,
        name: str,
        cname: str,
        listen_host: str,
        host_port: int,
        container_port: int,
    ) -> subprocess.Popen:
        log_path = self.paths.code_server_tunnel_log_file(name, host_port)
        pid_file = self.paths.code_server_tunnel_pid_file(name, host_port)
        safe_unlink(pid_file)
        script = str(pathlib.Path(__file__).resolve())
        argv = [
            sys.executable,
            script,
            "__code-server-proxy-server",
            "--engine",
            self.engine.name,
            "--container",
            cname,
            "--listen-host",
            listen_host,
            "--listen-port",
            str(host_port),
            "--target-port",
            str(container_port),
            "--pid-file",
            str(pid_file),
            "--log-file",
            str(log_path),
        ]
        proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        deadline = time.time() + 10
        while time.time() < deadline:
            if tcp_port_open("127.0.0.1", host_port):
                return proc
            if proc.poll() is not None:
                stderr = _decode_output(proc.stderr.read() if proc.stderr is not None else b"").strip()
                stdout = _decode_output(proc.stdout.read() if proc.stdout is not None else b"").strip()
                detail = stderr or stdout or f"exit {proc.returncode}"
                die(f"lubox: failed to start code-server proxy: {detail}")
            time.sleep(0.2)
        self.terminate_process(proc)
        die(f"lubox: timed out waiting for code-server proxy on port {host_port}")

    def terminate_process(self, proc: subprocess.Popen, signum: int = signal.SIGTERM) -> None:
        if proc.poll() is not None:
            return
        try:
            proc.send_signal(signum)
        except OSError:
            return
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            try:
                proc.kill()
            except OSError:
                pass
            proc.wait()

    def start_code_server_process(
        self,
        cname: str,
        name: str,
        bin_path: str,
        port: int,
        target: str,
        auth: str,
        password: str,
        bind_host: str,
    ) -> None:
        if self.container_port_open(cname, port):
            if bind_host == "127.0.0.1" or self.container_port_listens_publicly(cname, port):
                return
            self.stop_code_server_process(cname, port)
        log_path = self.paths.code_server_log_file(name)
        log_path.parent.mkdir(parents=True, exist_ok=True)
        env_prefix = f"PASSWORD={shlex.quote(password)} " if auth == "password" else ""
        cmd = (
            f"mkdir -p {shlex.quote(str(log_path.parent))}; "
            f"{env_prefix}nohup {shlex.quote(bin_path)} "
            f"--bind-addr {shlex.quote(bind_host)}:{port} --auth {shlex.quote(auth)} "
            f"{shlex.quote(target)} > {shlex.quote(str(log_path))} 2>&1 &"
        )
        cp = self.engine.run(["exec", cname, "sh", "-lc", cmd], check=False, capture=True)
        if cp.returncode != 0:
            die(f"lubox: failed to start code-server: {_decode_output(cp.stderr).strip() or _decode_output(cp.stdout).strip()}")
        deadline = time.time() + 25
        while time.time() < deadline:
            if self.container_port_open(cname, port):
                return
            time.sleep(0.25)
        tail = ""
        try:
            tail = log_path.read_text(encoding="utf-8", errors="replace")[-4000:].strip()
        except OSError:
            pass
        detail = f"\nlog tail:\n{tail}" if tail else ""
        die(f"lubox: timed out waiting for code-server on port {port}{detail}")

    def container_port_open(self, cname: str, port: int) -> bool:
        script = (
            "import socket,sys\n"
            "try:\n"
            " s=socket.create_connection(('127.0.0.1', int(sys.argv[1])), timeout=1); s.close(); raise SystemExit(0)\n"
            "except OSError:\n"
            " raise SystemExit(1)\n"
        )
        cp = self.engine.run(["exec", cname, "python3", "-c", script, str(port)], check=False, capture=True, timeout=5)
        return cp.returncode == 0

    def container_port_listens_publicly(self, cname: str, port: int) -> bool:
        cp = self.engine.run(["exec", cname, "ss", "-ltn"], check=False, capture=True, timeout=5)
        if cp.returncode != 0:
            return False
        suffix = f":{port}"
        for line in _decode_output(cp.stdout).splitlines():
            parts = line.split()
            if len(parts) < 4:
                continue
            local = parts[3]
            if not local.endswith(suffix):
                continue
            if local.startswith("127.") or local.startswith("[::1]") or local.startswith("::1"):
                continue
            return True
        return False

    def stop_code_server_process(self, cname: str, port: int) -> None:
        pattern = f"code-server.*--bind-addr .*:{port}"
        self.engine.run(["exec", cname, "sh", "-lc", f"pkill -f {shlex.quote(pattern)} || true"], check=False, capture=True)
        deadline = time.time() + 5
        while time.time() < deadline:
            if not self.container_port_open(cname, port):
                return
            time.sleep(0.2)

    def ensure_code_server_exposed(
        self,
        name: str,
        cname: str,
        info: Dict[str, Any],
        host_port: Optional[int],
        container_port: int,
        *,
        explicit_port: bool,
    ) -> int:
        if is_macos() and self.engine.name == "podman":
            self.stop_code_server_tunnels(name)
            public_port = self.choose_code_server_host_port(name, host_port or 8080, explicit=explicit_port)
            self.ensure_code_server_proxy(name, cname, public_port, container_port)
            return public_port
        if self.uses_host_network(self.hostexec_enabled(name, info)):
            if host_port is not None and host_port != container_port:
                eprint("lubox: --port cannot remap on host-network containers; using --container-port")
            return container_port
        die("lubox: code-server host tunnel currently supports host-network containers and macOS Podman")

    def choose_code_server_host_port(self, name: str, preferred: int, *, explicit: bool) -> int:
        if self.code_server_tunnel_running(name, preferred):
            return preferred
        if self.local_port_available(preferred):
            return preferred
        if explicit:
            die(f"lubox: local port already in use: {preferred}")
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            sock.bind(("127.0.0.1", 0))
            return int(sock.getsockname()[1])
        finally:
            sock.close()

    def local_port_available(self, port: int) -> bool:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            sock.bind(("127.0.0.1", port))
            return True
        except OSError:
            return False
        finally:
            sock.close()

    def code_server_tunnel_running(self, name: str, port: int) -> bool:
        pid_file = self.paths.code_server_tunnel_pid_file(name, port)
        if not pid_file.exists() or not tcp_port_open("127.0.0.1", port):
            return False
        try:
            pid = int(pid_file.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            return False
        return looks_like_pid_running(pid)

    def ensure_podman_code_server_tunnel(
        self,
        name: str,
        cname: str,
        info: Dict[str, Any],
        host_port: int,
        container_port: int,
    ) -> None:
        if self.code_server_tunnel_running(name, host_port):
            return
        pid_file = self.paths.code_server_tunnel_pid_file(name, host_port)
        safe_unlink(pid_file)
        container_ip = self.container_ip(info) or self.container_ip(self.engine.inspect_container(cname, required=True) or {})
        if not container_ip:
            die(f"lubox: cannot determine container IP for {cname}")
        user, host, ssh_port, identity = self.podman_ssh_connection()
        ssh_bin = shutil.which("ssh")
        if not ssh_bin:
            die("lubox: ssh not found; cannot create Podman machine tunnel")
        log_path = self.paths.code_server_tunnel_log_file(name, host_port)
        log_path.parent.mkdir(parents=True, exist_ok=True)
        argv = [
            ssh_bin,
            "-N",
            "-L",
            f"127.0.0.1:{host_port}:{container_ip}:{container_port}",
            "-o",
            "ExitOnForwardFailure=yes",
            "-o",
            "ServerAliveInterval=30",
            "-o",
            "ServerAliveCountMax=2",
            "-o",
            "StrictHostKeyChecking=no",
            "-o",
            "UserKnownHostsFile=/dev/null",
            "-o",
            "LogLevel=ERROR",
        ]
        if identity:
            argv += ["-i", identity]
        if ssh_port:
            argv += ["-p", str(ssh_port)]
        argv.append(f"{user}@{host}")
        log = log_path.open("ab")
        try:
            proc = subprocess.Popen(argv, stdout=log, stderr=log, start_new_session=True)
        finally:
            log.close()
        atomic_write_text(pid_file, f"{proc.pid}\n", 0o600)
        deadline = time.time() + 10
        while time.time() < deadline:
            if tcp_port_open("127.0.0.1", host_port):
                return
            if proc.poll() is not None:
                break
            time.sleep(0.2)
        safe_unlink(pid_file)
        try:
            proc.terminate()
        except OSError:
            pass
        tail = ""
        try:
            tail = log_path.read_text(encoding="utf-8", errors="replace")[-4000:].strip()
        except OSError:
            pass
        detail = f"\nlog tail:\n{tail}" if tail else ""
        die(f"lubox: failed to start code-server tunnel on localhost:{host_port}{detail}")

    def ensure_code_server_proxy(self, name: str, cname: str, host_port: int, container_port: int) -> None:
        if self.code_server_tunnel_running(name, host_port):
            return
        pid_file = self.paths.code_server_tunnel_pid_file(name, host_port)
        safe_unlink(pid_file)
        log_path = self.paths.code_server_tunnel_log_file(name, host_port)
        log_path.parent.mkdir(parents=True, exist_ok=True)
        script = str(pathlib.Path(__file__).resolve())
        argv = [
            sys.executable,
            script,
            "__code-server-proxy-server",
            "--engine",
            self.engine.name,
            "--container",
            cname,
            "--listen-port",
            str(host_port),
            "--target-port",
            str(container_port),
            "--pid-file",
            str(pid_file),
            "--log-file",
            str(log_path),
        ]
        log = log_path.open("ab")
        try:
            proc = subprocess.Popen(argv, stdout=log, stderr=log, start_new_session=True)
        finally:
            log.close()
        atomic_write_text(pid_file, f"{proc.pid}\n", 0o600)
        deadline = time.time() + 10
        while time.time() < deadline:
            if tcp_port_open("127.0.0.1", host_port):
                return
            if proc.poll() is not None:
                break
            time.sleep(0.2)
        safe_unlink(pid_file)
        try:
            proc.terminate()
        except OSError:
            pass
        tail = ""
        try:
            tail = log_path.read_text(encoding="utf-8", errors="replace")[-4000:].strip()
        except OSError:
            pass
        detail = f"\nlog tail:\n{tail}" if tail else ""
        die(f"lubox: failed to start code-server proxy on localhost:{host_port}{detail}")

    def podman_ssh_connection(self) -> Tuple[str, str, int, str]:
        cp = self.engine.run(["system", "connection", "list", "--format", "json"], check=False, capture=True, timeout=15)
        if cp.returncode != 0:
            die(f"lubox: cannot inspect Podman SSH connection: {_decode_output(cp.stderr).strip()}")
        try:
            rows = json.loads(_decode_output(cp.stdout) or "[]")
        except json.JSONDecodeError as exc:
            die(f"lubox: cannot parse Podman connection JSON: {exc}")
        if not isinstance(rows, list):
            rows = []
        choices = [row for row in rows if isinstance(row, dict) and row.get("IsMachine")]
        choices.sort(key=lambda row: 0 if row.get("Default") else 1)
        for row in choices:
            uri_value = str(row.get("URI") or "")
            parsed = urllib.parse.urlparse(uri_value)
            if parsed.scheme != "ssh" or not parsed.hostname:
                continue
            user = urllib.parse.unquote(parsed.username or "core")
            host = parsed.hostname
            port = int(parsed.port or 22)
            identity = str(row.get("Identity") or "")
            return user, host, port, identity
        die("lubox: no Podman machine SSH connection found")

    def container_ip(self, info: Dict[str, Any]) -> str:
        settings = info.get("NetworkSettings")
        if not isinstance(settings, dict):
            return ""
        direct = str(settings.get("IPAddress") or "")
        if direct:
            return direct
        networks = settings.get("Networks")
        if isinstance(networks, dict):
            for net in networks.values():
                if isinstance(net, dict):
                    ip = str(net.get("IPAddress") or "")
                    if ip:
                        return ip
        return ""

    def open_url(self, url: str) -> None:
        if is_macos():
            argv = ["open", url]
        elif shutil.which("xdg-open"):
            argv = ["xdg-open", url]
        else:
            return
        try:
            subprocess.Popen(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass

    def stop_code_server_tunnels(self, name: str) -> None:
        runtime_dir = self.paths.runtime_dir(name)
        for pid_file in runtime_dir.glob("code-server-tunnel-*.pid"):
            try:
                pid = int(pid_file.read_text(encoding="utf-8").strip())
            except (OSError, ValueError):
                safe_unlink(pid_file)
                continue
            if looks_like_pid_running(pid):
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
            safe_unlink(pid_file)

    def env_args(self, env: Iterable[Tuple[str, str]]) -> List[str]:
        args: List[str] = []
        for key, value in env:
            args += ["--env", f"{key}={value}"]
        return args

    def lubox_exec_env(self, name: str, cname: str, host_exec: bool) -> List[Tuple[str, str]]:
        return [
            ("LUBOX_NAME", name),
            ("LUBOX_CONTAINER_NAME", name),
            ("LUBOX_ENGINE_CONTAINER_NAME", cname),
            ("LUBOX_HOST_LUBOX", host_lubox_path()),
            ("LUBOX_HOST_OS", host_os_name()),
            ("LUBOX_HOST_EXEC", "1" if host_exec else "0"),
            ("LUBOX_HOSTEXEC_CONFIG", CONTAINER_CONFIG_PATH),
            ("PATH", self.container_path_value(host_exec)),
        ]

    def lubox_exec_prefix(
        self,
        cname: str,
        name: str,
        host_exec: bool,
        *,
        detach: bool = False,
        user: bool = True,
        extra_env: Iterable[Tuple[str, str]] = (),
    ) -> List[str]:
        args = ["exec"]
        if detach:
            args.append("-d")
        if user:
            args += ["--user", f"{self.ident.uid}:{self.ident.gid}"]
        args += self.env_args(self.lubox_exec_env(name, cname, host_exec))
        args += self.env_args(extra_env)
        args.append(cname)
        return args

    def exec_env_args(
        self,
        cname: str,
        name: str,
        *,
        info: Optional[Dict[str, Any]] = None,
        auto_start_xquartz: bool = False,
    ) -> List[str]:
        args: List[str] = []
        host_exec = self.hostexec_enabled(name, info) if info is not None else self.hostexec_enabled(name)
        gpg_agent = self.gpg_agent_label_enabled(info) if info is not None else self.gpg_agent_enabled(name)
        args += self.env_args(self.lubox_exec_env(name, cname, host_exec))
        if gpg_agent and not is_linux():
            args += ["--env", f"GNUPGHOME={container_gpg_home(self.ident.uid)}"]
            args += ["--env", "LUBOX_GPG_AGENT_PROXY=1"]
        if is_linux():
            args += self.env_args(self.linux_session_env(host_exec))
        else:
            for key, value in self.xquartz_env(auto_start=auto_start_xquartz).items():
                args += ["--env", f"{key}={value}"]
            keys = ["TERM", "COLORTERM", "LANG"] + [k for k in sorted(os.environ) if k.startswith("LC_")]
            for key in keys:
                value = os.environ.get(key)
                if value:
                    args += ["--env", f"{key}={value}"]
        return args

    def xquartz_env(self, *, auto_start: bool) -> Dict[str, str]:
        if not is_macos():
            return {}
        mode = os.environ.get("LUBOX_XQUARTZ", "")
        if env_flag_disabled(mode):
            return {}
        if env_flag_enabled(mode):
            auto_start = True
        if not auto_start:
            return {}
        display_number = parse_display_number(os.environ.get("DISPLAY", ":0"))
        if not self.ensure_xquartz(display_number, auto_start=auto_start):
            return {}
        return {
            "DISPLAY": f"{self.hostexec_host()}:{display_number}",
            "LIBGL_ALWAYS_INDIRECT": "1",
            "LUBOX_XQUARTZ": "1",
        }

    def enable(self, args: argparse.Namespace) -> int:
        if args.feature == "xquartz":
            env = self.xquartz_env(auto_start=True)
            if not env:
                eprint("lubox: XQuartz not available or failed to start")
                return 1
            self.print_env_exports(env, args.shell)
            return 0
        die(f"lubox: unsupported feature: {args.feature}")

    def print_env_exports(self, env: Dict[str, str], shell: str) -> None:
        if shell == "json":
            print(json.dumps(env, sort_keys=True))
            return
        for key in sorted(env):
            value = shlex.quote(env[key])
            if shell == "fish":
                print(f"set -gx {key} {value}")
            else:
                print(f"export {key}={value}")

    def ensure_xquartz(self, display_number: int, *, auto_start: bool) -> bool:
        port = 6000 + display_number
        if tcp_port_open("127.0.0.1", port):
            self.allow_xquartz_clients(display_number)
            return True
        if not auto_start:
            return False
        if x11_binary("Xquartz") is None and xquartz_app_path() is None:
            eprint("lubox: XQuartz not found; GUI DISPLAY not forwarded")
            return False
        subprocess.run(
            ["defaults", "write", "org.xquartz.X11", "nolisten_tcp", "-bool", "false"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        was_running = self.xquartz_running()
        if not was_running:
            self.start_xquartz()
        deadline = time.time() + 10
        while time.time() < deadline:
            if tcp_port_open("127.0.0.1", port):
                self.allow_xquartz_clients(display_number)
                return True
            time.sleep(0.2)
        if was_running:
            eprint("lubox: XQuartz TCP listener is disabled; quit XQuartz and run lubox enter again")
        else:
            eprint("lubox: XQuartz started but TCP listener did not appear; GUI DISPLAY not forwarded")
        return False

    def xquartz_running(self) -> bool:
        cp = subprocess.run(
            ["pgrep", "-x", "Xquartz"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return cp.returncode == 0

    def start_xquartz(self) -> None:
        app = xquartz_app_path()
        if app is not None:
            argv = ["open", "-g", str(app)]
        else:
            argv = ["open", "-g", "-a", "XQuartz"]
        subprocess.run(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    def allow_xquartz_clients(self, display_number: int) -> None:
        xhost = x11_binary("xhost")
        if xhost is None:
            eprint("lubox: xhost not found; GUI apps may be refused by XQuartz")
            return
        env = os.environ.copy()
        env["DISPLAY"] = f":{display_number}"
        targets = ["+localhost", "+127.0.0.1"]
        if self.engine.name == "podman":
            for ip in self.podman_machine_ips():
                targets.append(f"+{ip}")
        for target in sorted(set(targets)):
            subprocess.run([xhost, target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=env, check=False)

    def podman_machine_ips(self) -> List[str]:
        if not (is_macos() and self.engine.name == "podman"):
            return []
        cp = self.engine.run(
            ["machine", "ssh", "--", "sh", "-lc", "hostname -I 2>/dev/null || true"],
            check=False,
            capture=True,
            timeout=8,
        )
        ips: List[str] = []
        for token in _decode_output(cp.stdout).replace("\n", " ").split():
            ip = token.split("/", 1)[0]
            if self.valid_ipv4(ip) and not ip.startswith("127."):
                ips.append(ip)
        return ips

    def valid_ipv4(self, value: str) -> bool:
        parts = value.split(".")
        if len(parts) != 4:
            return False
        try:
            nums = [int(part) for part in parts]
        except ValueError:
            return False
        return all(0 <= num <= 255 for num in nums)

    def container_locale_names(self, cname: str) -> List[str]:
        cached = self._locale_cache.get(cname)
        if cached is not None:
            return cached
        cp = self.engine.run(["exec", cname, "locale", "-a"], check=False, capture=True)
        if cp.returncode != 0:
            names = ["C", "POSIX"]
        else:
            names = [line.strip() for line in _decode_output(cp.stdout).splitlines() if line.strip()]
        self._locale_cache[cname] = names
        return names

    def locale_available(self, cname: str, value: str) -> bool:
        wanted = self.normalize_locale(value)
        return any(self.normalize_locale(name) == wanted for name in self.container_locale_names(cname))

    def container_locale_value(self, cname: str, value: str) -> str:
        if not value or value in ("C", "POSIX") or self.locale_available(cname, value):
            return value
        for fallback in ("C.UTF-8", "C.utf8", "en_US.UTF-8", "en_US.utf8", "C"):
            if fallback in ("C", "POSIX") or self.locale_available(cname, fallback):
                return fallback
        return "C"

    def normalize_locale(self, value: str) -> str:
        return value.strip().lower().replace("-", "").replace("utf8", "utf8")

    def container_cwd(self, cname: str) -> str:
        cwd = pathlib.Path.cwd()
        if cwd.exists() and path_under(cwd, self.ident.home):
            return str(cwd)
        cp = self.engine.run(["exec", cname, "test", "-d", str(cwd)], check=False, capture=True)
        if cp.returncode == 0:
            return str(cwd)
        eprint(f"lubox: cwd not available in container, using home: {cwd}")
        return str(self.ident.home)

    def read_container_shell(self, cname: str, info: Optional[Dict[str, Any]] = None) -> str:
        if info:
            shell = self.env_from_info(info).get("SHELL", "").strip()
            if shell.startswith("/"):
                return shell
        cp = self.engine.run(["exec", cname, "cat", "/etc/lubox/shell"], check=False, capture=True)
        if cp.returncode == 0:
            shell = _decode_output(cp.stdout).strip()
            if shell:
                return shell
        return self.container_shell_path()

    def list_infos(self) -> List[ContainerInfo]:
        infos: List[ContainerInfo] = []
        cnames = self.engine.list_lubox_names()
        inspected = self.engine.inspect_containers(cnames)
        for cname in cnames:
            info = inspected.get(cname)
            if not info:
                continue
            labels = self.labels_from_info(info)
            name = labels.get(f"{LABEL_PREFIX}.name", cname.removeprefix("lubox-"))
            state = info.get("State", {})
            status = "unknown"
            if isinstance(state, dict):
                status = str(state.get("Status") or ("running" if state.get("Running") else "stopped"))
            config = info.get("Config", {})
            image = ""
            if isinstance(config, dict):
                image = str(config.get("Image") or "")
            infos.append(
                ContainerInfo(
                    name=name,
                    status=status,
                    image=image,
                    host_exec=labels.get(f"{LABEL_PREFIX}.host_exec", "?"),
                    base_image=labels.get(f"{LABEL_PREFIX}.base_image", "?"),
                )
            )
        return sorted(infos, key=lambda item: item.name)

    def print_list(self) -> None:
        infos = self.list_infos()
        if not infos:
            print("no lubox containers")
            return
        rows = [["NAME", "STATUS", "IMAGE", "HOST-EXEC", "BASE-IMAGE"]]
        for info in infos:
            rows.append([info.name, info.status, info.image, info.host_exec, info.base_image])
        widths = [max(len(row[i]) for row in rows) for i in range(len(rows[0]))]
        for row in rows:
            print("  ".join(row[i].ljust(widths[i]) for i in range(len(row))))

    def stop_server(self, name: str) -> None:
        pid_file = self.paths.pid_file(name)
        pid = None
        if pid_file.exists():
            try:
                pid = int(pid_file.read_text(encoding="utf-8").strip())
            except (ValueError, OSError):
                pid = None
        current_server_pid = os.environ.get("LUBOX_HOSTEXEC_SERVER_PID")
        if pid and looks_like_pid_running(pid):
            if current_server_pid == str(pid):
                safe_unlink(pid_file)
            else:
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                deadline = time.time() + 5
                while time.time() < deadline and looks_like_pid_running(pid):
                    time.sleep(0.1)
                if looks_like_pid_running(pid):
                    try:
                        os.kill(pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
        safe_unlink(pid_file)
        safe_unlink(self.hostexec_server_stamp_file(name))
        safe_unlink(self.paths.runtime_dir(name) / "ssh-agent-proxy.stamp")
        safe_unlink(self.paths.runtime_dir(name) / "gpg-agent-proxy.stamp")
        try:
            cfg_path = self.hostexec_config_file(name)
            if cfg_path.exists():
                self.write_disabled_config_preserving_sockets(name, cfg_path.parent)
        except LuboxError:
            pass

    def ensure_hostexec_server(
        self,
        name: str,
        host_exec_enabled: Optional[bool] = None,
        ssh_agent_enabled: Optional[bool] = None,
        gpg_agent_enabled: Optional[bool] = None,
    ) -> None:
        if host_exec_enabled is None:
            host_exec_enabled = self.hostexec_enabled(name)
        if not host_exec_enabled:
            return
        lock_path = self.paths.lock_file(name)
        with lock_path.open("a+") as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            pid_file = self.paths.pid_file(name)
            if pid_file.exists():
                try:
                    pid = int(pid_file.read_text(encoding="utf-8").strip())
                except (ValueError, OSError):
                    pid = 0
                if pid and looks_like_pid_running(pid):
                    if self.hostexec_server_stamp_current(name) and not self.hostexec_server_needs_restart_for_agents(name, ssh_agent_enabled, gpg_agent_enabled):
                        return
                    self.stop_server(name)
            self.ensure_runtime_mount_files(name, host_exec_enabled, running=True)
            last_error = ""
            for bind_addr in self.hostexec_bind_candidates():
                ok, last_error = self.try_start_hostexec_server(name, bind_addr, ssh_agent_enabled, gpg_agent_enabled)
                if ok:
                    return
                if bind_addr == "0.0.0.0":
                    break
            die(f"lubox: host-exec server failed probe for {name}: {last_error}")

    def hostexec_bind_candidates(self) -> List[str]:
        candidates = ["127.0.0.1"]
        if is_macos() and self.engine.name == "podman":
            discovered = self.discover_podman_host_bind_address()
            if discovered and discovered not in candidates:
                candidates.append(discovered)
            candidates.append("0.0.0.0")
        return candidates

    def try_start_hostexec_server(
        self,
        name: str,
        bind_addr: str,
        ssh_agent_enabled: Optional[bool],
        gpg_agent_enabled: Optional[bool],
    ) -> Tuple[bool, str]:
        port = self.choose_port(bind_addr)
        ssh_auth_sock = self.ssh_agent_host_socket(name, ssh_agent_enabled)
        ssh_port = self.choose_port(bind_addr) if ssh_auth_sock is not None else 0
        gpg_home, gpg_sockets = self.gpg_agent_host_info(name, gpg_agent_enabled)
        proc = self.start_server_process(name, bind_addr, port, ssh_auth_sock, ssh_port, gpg_sockets, gpg_home)
        try:
            self.wait_server_config(name, port, proc)
            probe = self.probe_hostexec(name)
            if probe.returncode == 0:
                return True, ""
            error = _decode_output(probe.stderr).strip() or f"probe exited {probe.returncode}"
            self.stop_server(name)
            if bind_addr != "0.0.0.0":
                self.append_server_log(name, f"probe failed on {bind_addr}:{port}: {error}\n")
            return False, error
        except LuboxError as exc:
            self.stop_server(name)
            return False, str(exc)

    def hostexec_server_needs_restart_for_agents(
        self,
        name: str,
        ssh_agent_enabled: Optional[bool] = None,
        gpg_agent_enabled: Optional[bool] = None,
    ) -> bool:
        if ssh_agent_enabled is None:
            ssh_agent_enabled = self.ssh_agent_enabled(name)
        if gpg_agent_enabled is None:
            gpg_agent_enabled = self.gpg_agent_enabled(name)
        ssh_sock = current_ssh_auth_sock() if ssh_agent_enabled else None
        gpg_sockets: Dict[str, pathlib.Path] = {}
        if gpg_agent_enabled:
            _home, gpg_sockets = current_gpg_info()
        if is_linux() or (ssh_sock is None and not gpg_sockets):
            return False
        cfg_path = self.hostexec_config_file(name)
        try:
            cfg = load_json_file(cfg_path)
        except (OSError, json.JSONDecodeError, LuboxError):
            return True
        if ssh_agent_enabled and ssh_sock is not None:
            ssh_cfg = cfg.get("ssh_agent")
            if not (isinstance(ssh_cfg, dict) and ssh_cfg.get("enabled")):
                return True
            if str(ssh_cfg.get("host_path") or "") != str(ssh_sock):
                return True
        if gpg_sockets:
            gpg_cfg = cfg.get("gpg_agent")
            cfg_sockets = gpg_cfg.get("sockets") if isinstance(gpg_cfg, dict) else None
            if not (isinstance(gpg_cfg, dict) and gpg_cfg.get("enabled") and isinstance(cfg_sockets, dict)):
                return True
            if set(gpg_sockets) != set(cfg_sockets):
                return True
            for key, path in gpg_sockets.items():
                item = cfg_sockets.get(key)
                if not isinstance(item, dict) or str(item.get("host_path") or "") != str(path):
                    return True
        return False

    def ssh_agent_host_socket(self, name: str, ssh_agent_enabled: Optional[bool] = None) -> Optional[pathlib.Path]:
        if ssh_agent_enabled is None:
            ssh_agent_enabled = self.ssh_agent_enabled(name)
        if is_linux() or not ssh_agent_enabled:
            return None
        sock = current_ssh_auth_sock()
        if sock is None:
            eprint("lubox: SSH_AUTH_SOCK was requested for this container, but host SSH_AUTH_SOCK is unset or not a socket")
            return None
        return sock

    def gpg_agent_host_info(self, name: str, gpg_agent_enabled: Optional[bool] = None) -> Tuple[Optional[pathlib.Path], Dict[str, pathlib.Path]]:
        if gpg_agent_enabled is None:
            gpg_agent_enabled = self.gpg_agent_enabled(name)
        if is_linux() or not gpg_agent_enabled:
            return None, {}
        home, sockets = current_gpg_info()
        if not sockets:
            eprint("lubox: GPG agent was requested for this container, but no host GPG sockets are available")
        return home, sockets

    def load_hostexec_config_if_present(self, name: str) -> Optional[Dict[str, Any]]:
        cfg_path = self.hostexec_config_file(name)
        try:
            return load_json_file(cfg_path)
        except (OSError, json.JSONDecodeError, LuboxError):
            return None

    def cached_hostexec_socket_sources(self, cfg: Dict[str, Any]) -> Tuple[Optional[pathlib.Path], Optional[pathlib.Path], Dict[str, pathlib.Path]]:
        ssh_sock: Optional[pathlib.Path] = None
        ssh_cfg = cfg.get("ssh_agent")
        if isinstance(ssh_cfg, dict):
            host_path = str(ssh_cfg.get("host_path") or "")
            if host_path:
                ssh_sock = socket_path_if_connectable(pathlib.Path(host_path))
        gpg_home: Optional[pathlib.Path] = None
        gpg_sockets: Dict[str, pathlib.Path] = {}
        gpg_cfg = cfg.get("gpg_agent")
        if isinstance(gpg_cfg, dict):
            home_value = str(gpg_cfg.get("home") or "")
            if home_value:
                gpg_home = pathlib.Path(home_value)
            sockets = gpg_cfg.get("sockets")
            if isinstance(sockets, dict):
                for key, item in sockets.items():
                    if key not in GPG_SOCKET_BASENAMES or not isinstance(item, dict):
                        continue
                    host_path = str(item.get("host_path") or "")
                    if not host_path:
                        continue
                    sock = socket_path_if_connectable(pathlib.Path(host_path))
                    if sock is not None:
                        gpg_sockets[str(key)] = sock
        return ssh_sock, gpg_home, gpg_sockets

    def restart_hostexec_server_from_config(self, name: str, info: Dict[str, Any]) -> None:
        cfg = self.load_hostexec_config_if_present(name) or {}
        ssh_sock, gpg_home, gpg_sockets = self.cached_hostexec_socket_sources(cfg)
        if ssh_sock is None and self.ssh_agent_enabled(name, info):
            ssh_sock = current_ssh_auth_sock()
        self.stop_server(name)
        self.ensure_runtime_mount_files(name, True, running=True)
        bind_addr = str(cfg.get("bind_address") or "")
        if not bind_addr:
            bind_addr = "0.0.0.0" if is_macos() and self.engine.name == "podman" else "127.0.0.1"
        port = self.choose_port(bind_addr)
        ssh_port = self.choose_port(bind_addr) if ssh_sock is not None else 0
        proc = self.start_server_process(name, bind_addr, port, ssh_sock, ssh_port, gpg_sockets, gpg_home)
        self.wait_server_config(name, port, proc)

    def socket_proxy_marker(self, name: str, proxy_name: str) -> pathlib.Path:
        return self.paths.runtime_dir(name) / f"{proxy_name}-proxy.stamp"

    def container_socket_proxy_running(self, cname: str, group: SocketForwardGroup) -> bool:
        socket_paths = group.socket_paths()
        if not group.pid_file or not socket_paths:
            return False
        checks = [
            f"test -f {shlex.quote(group.pid_file)} || exit 1",
            f"pid=$(cat {shlex.quote(group.pid_file)}) || exit 1",
            "case \"$pid\" in ''|*[!0-9]*) exit 1;; esac",
            "kill -0 \"$pid\" 2>/dev/null || exit 1",
        ]
        checks.extend(f"test -S {shlex.quote(path)} || exit 1" for path in socket_paths)
        cp = self.engine.run(["exec", cname, "sh", "-lc", "; ".join(checks)], check=False, capture=True, timeout=5)
        return cp.returncode == 0

    def stop_socket_forward_proxy(self, cname: str, group: SocketForwardGroup) -> None:
        if not group.pid_file:
            return
        paths = [group.pid_file] + group.socket_paths()
        script = (
            f"if [ -f {shlex.quote(group.pid_file)} ]; then "
            f"pid=$(cat {shlex.quote(group.pid_file)}) || pid=; "
            "case \"$pid\" in ''|*[!0-9]*) ;; *) kill \"$pid\" 2>/dev/null || true ;; esac; "
            "fi; "
            f"rm -f {' '.join(shlex.quote(path) for path in paths)}"
        )
        self.engine.run(["exec", cname, "sh", "-lc", script], check=False, capture=True)

    def start_socket_forward_proxy(self, name: str, cname: str, group: SocketForwardGroup) -> None:
        if not group.proxy_command:
            return
        argv = self.lubox_exec_prefix(cname, name, True, detach=True, extra_env=group.proxy_env)
        argv += list(group.proxy_command)
        self.engine.run(argv, check=False, capture=True)

    def socket_forward_proxy_healthy(self, cname: str, group: SocketForwardGroup) -> bool:
        if not group.check_command:
            return True
        cp = self.engine.run(
            ["exec", cname] + list(group.check_command),
            check=False,
            capture=True,
            timeout=8,
        )
        return cp.returncode == 0

    def wait_socket_forward_proxy(
        self,
        name: str,
        cname: str,
        group: SocketForwardGroup,
    ) -> bool:
        deadline = time.time() + 5
        saw_socket = False
        while time.time() < deadline:
            if self.container_socket_proxy_running(cname, group):
                saw_socket = True
                if self.socket_forward_proxy_healthy(cname, group):
                    return True
            time.sleep(0.1)
        if saw_socket:
            self.append_server_log(name, f"WARNING: {group.label} socket proxy healthcheck failed\n")
            self.stop_socket_forward_proxy(cname, group)
            return False
        self.append_server_log(name, f"WARNING: {group.label} socket proxy did not appear in container\n")
        return False

    def ensure_socket_forward_proxies(self, name: str, groups: Iterable[SocketForwardGroup], *, missing_only: bool = False) -> bool:
        if is_linux():
            return True
        cname = container_name(name)
        ok = True
        for group in groups:
            if not self.ensure_socket_forward_proxy(name, cname, group, missing_only=missing_only):
                ok = False
        return ok

    def ensure_socket_forward_proxy(self, name: str, cname: str, group: SocketForwardGroup, *, missing_only: bool = False) -> bool:
        marker = self.socket_proxy_marker(name, group.name)
        if missing_only and self.container_socket_proxy_running(cname, group):
            return True
        try:
            if marker.read_text(encoding="utf-8").strip() == group.marker_text:
                if self.container_socket_proxy_running(cname, group):
                    return True
        except OSError:
            pass
        self.stop_socket_forward_proxy(cname, group)
        self.start_socket_forward_proxy(name, cname, group)
        if self.wait_socket_forward_proxy(name, cname, group):
            atomic_write_text(marker, group.marker_text + "\n", 0o600)
            return True
        return False

    def restart_socket_proxies(self, name: str, kind: str) -> None:
        validate_box_name(name)
        if is_linux():
            die("lubox: socket proxies are not used on Linux; SSH/GPG sockets are bind-mounted")
        if kind not in ("all", "ssh", "gpg"):
            die(f"lubox: unsupported socket proxy kind: {kind}")
        info = self.start(
            name,
            start_server=True,
            announce=False,
            ensure_engine_ready=True,
            start_socket_proxies=False,
        )
        if not self.hostexec_enabled(name, info):
            die(f"lubox: host-exec is disabled for {name}; socket proxies are unavailable")
        cname = container_name(name)
        groups = [group for group in self.current_socket_forward_groups(name, info) if kind == "all" or group.kind == kind]
        if not groups:
            die(f"lubox: {kind} socket proxy is not available for {name}" if kind != "all" else f"lubox: no socket proxies are available for {name}")
        restarted: List[str] = []
        for group in groups:
            self.stop_socket_forward_proxy(cname, group)
            safe_unlink(self.socket_proxy_marker(name, group.name))
            if self.ensure_socket_forward_proxy(name, cname, group):
                restarted.append(group.kind)
        if not restarted:
            die(f"lubox: no socket proxies started for {name}; see {self.paths.log_file(name)}")
        print(f"restarted {','.join(restarted)} socket proxy for {cname}")

    def choose_port(self, bind_addr: str) -> int:
        attempts = HOSTEXEC_MAX_PORT - HOSTEXEC_MIN_PORT + 1
        for _ in range(min(attempts, 256)):
            port = HOSTEXEC_MIN_PORT + secrets.randbelow(HOSTEXEC_MAX_PORT - HOSTEXEC_MIN_PORT + 1)
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            try:
                sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                sock.bind((bind_addr, port))
                return port
            except OSError:
                continue
            finally:
                sock.close()
        die(f"lubox: could not choose free host-exec port on {bind_addr}")

    def start_server_process(
        self,
        name: str,
        bind_addr: str,
        port: int,
        ssh_auth_sock: Optional[pathlib.Path],
        ssh_port: int,
        gpg_sockets: Dict[str, pathlib.Path],
        gpg_home: Optional[pathlib.Path] = None,
    ) -> subprocess.Popen:
        if bind_addr == "0.0.0.0":
            self.append_server_log(
                name,
                "WARNING: binding host-exec server to 0.0.0.0; token authentication remains mandatory\n",
            )
        script = str(pathlib.Path(__file__).resolve())
        mount_dir = self.hostexec_mount_dir(name)
        token_file = self.paths.token_file(name)
        log_file = self.paths.log_file(name)
        pid_file = self.paths.pid_file(name)
        argv = [
            sys.executable,
            script,
            "__hostexec-server",
            "--engine",
            self.engine.name,
            "--name",
            name,
            "--container",
            container_name(name),
            "--port",
            str(port),
            "--token-file",
            str(token_file),
            "--config-file",
            str(mount_dir / "hostexec.json"),
            "--bind-address",
            bind_addr,
            "--host",
            self.hostexec_host(),
            "--token-path",
            self.container_token_path(),
            "--pid-file",
            str(pid_file),
        ]
        if gpg_home is not None:
            argv += ["--gpg-home", str(gpg_home)]
        if ssh_auth_sock is not None and ssh_port > 0:
            argv += [
                "--ssh-auth-sock",
                str(ssh_auth_sock),
                "--ssh-port",
                str(ssh_port),
                "--ssh-socket-path",
                container_ssh_auth_sock(self.ident.uid),
            ]
        for key in sorted(gpg_sockets):
            argv += ["--gpg-socket", f"{key}={gpg_sockets[key]}"]
        log_file.parent.mkdir(parents=True, exist_ok=True)
        log = log_file.open("ab")
        proc = subprocess.Popen(argv, stdout=log, stderr=log, start_new_session=True)
        atomic_write_text(pid_file, f"{proc.pid}\n", 0o600)
        atomic_write_text(self.hostexec_server_stamp_file(name), self.script_sync_stamp() + "\n", 0o600)
        return proc

    def wait_server_config(self, name: str, port: int, proc: subprocess.Popen) -> None:
        cfg_path = self.hostexec_config_file(name)
        deadline = time.time() + 8
        while time.time() < deadline:
            if proc.poll() is not None:
                die(f"lubox: host-exec server exited early; see {self.paths.log_file(name)}")
            if cfg_path.exists():
                try:
                    cfg = load_json_file(cfg_path)
                    if cfg.get("enabled") is True and int(cfg.get("port", 0)) == port:
                        return
                except (OSError, ValueError, json.JSONDecodeError):
                    pass
            time.sleep(0.1)
        die(f"lubox: timed out waiting for host-exec server; see {self.paths.log_file(name)}")

    def probe_hostexec(self, name: str) -> subprocess.CompletedProcess:
        cname = container_name(name)
        return self.engine.run(
            ["exec"] + self.exec_env_args(cname, name) + [cname, "/usr/local/bin/lubox", "__hostexec-probe"],
            check=False,
            capture=True,
            timeout=15,
        )

    def append_server_log(self, name: str, text: str) -> None:
        log_path = self.paths.log_file(name)
        log_path.parent.mkdir(parents=True, exist_ok=True)
        with log_path.open("a", encoding="utf-8") as f:
            f.write(text)

    def discover_podman_host_bind_address(self) -> Optional[str]:
        if not (is_macos() and self.engine.name == "podman"):
            return None
        cp = self.engine.run(
            ["machine", "ssh", "--", "sh", "-lc", "getent hosts host.containers.internal 2>/dev/null || true"],
            check=False,
            capture=True,
            timeout=8,
        )
        if cp.returncode != 0:
            return None
        for line in _decode_output(cp.stdout).splitlines():
            parts = line.split()
            if parts and self.can_bind_address(parts[0]):
                return parts[0]
        return None

    def can_bind_address(self, addr: str) -> bool:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        try:
            sock.bind((addr, 0))
            return True
        except OSError:
            return False
        finally:
            sock.close()


def send_control(sock: socket.socket, obj: Dict[str, Any]) -> None:
    data = json.dumps(obj, sort_keys=True, separators=(",", ":")).encode("utf-8")
    if len(data) > CONTROL_MAX:
        raise LuboxError("lubox: control message too large")
    sock.sendall(struct.pack(">I", len(data)) + data)


def recv_exact(sock: socket.socket, n: int) -> bytes:
    chunks = bytearray()
    while len(chunks) < n:
        chunk = sock.recv(n - len(chunks))
        if not chunk:
            raise EOFError("connection closed")
        chunks.extend(chunk)
    return bytes(chunks)


def recv_control(sock: socket.socket) -> Dict[str, Any]:
    header = recv_exact(sock, 4)
    (length,) = struct.unpack(">I", header)
    if length > CONTROL_MAX:
        raise LuboxError("lubox: control message too large")
    data = recv_exact(sock, length)
    obj = json.loads(data.decode("utf-8"))
    if not isinstance(obj, dict):
        raise LuboxError("lubox: expected control object")
    return obj


def send_frame(sock: socket.socket, channel: int, payload: bytes) -> None:
    if len(payload) > FRAME_MAX:
        raise LuboxError("lubox: frame too large")
    sock.sendall(struct.pack(">BI", channel, len(payload)) + payload)


def recv_frame(sock: socket.socket) -> Tuple[int, bytes]:
    header = recv_exact(sock, 5)
    channel, length = struct.unpack(">BI", header)
    if length > FRAME_MAX:
        raise LuboxError("lubox: frame too large")
    return channel, recv_exact(sock, length)


def canonical_request(obj: Dict[str, Any]) -> bytes:
    return json.dumps(obj, sort_keys=True, separators=(",", ":")).encode("utf-8")


def hmac_for_request(token: bytes, nonce: bytes, request: Dict[str, Any]) -> str:
    return hmac.new(token, nonce + b"\0" + canonical_request(request), hashlib.sha256).hexdigest()


def safe_forward_env() -> Dict[str, str]:
    env: Dict[str, str] = {}
    for key, value in os.environ.items():
        if key in ("TERM", "COLORTERM", "LANG") or key.startswith("LC_"):
            env[key] = value
    return env


def normalize_exit_code(code: int) -> int:
    if code < 0:
        return 128 + min(abs(code), 127)
    return code


def lubox_config_matches_env(cfg: Dict[str, Any], env_name: str) -> bool:
    names = {str(value) for value in (cfg.get("box_name"), cfg.get("name"), cfg.get("container_name")) if value}
    engine_name = str(cfg.get("container_name") or "")
    if engine_name.startswith("lubox-"):
        names.add(engine_name.removeprefix("lubox-"))
    return env_name in names


def raw_socket_proxy(left: socket.socket, right: socket.socket) -> None:
    def copy(src: socket.socket, dst: socket.socket) -> None:
        try:
            while True:
                data = src.recv(65536)
                if not data:
                    break
                dst.sendall(data)
        except OSError:
            pass
        try:
            dst.shutdown(socket.SHUT_WR)
        except OSError:
            pass

    t1 = threading.Thread(target=copy, args=(left, right), daemon=True)
    t2 = threading.Thread(target=copy, args=(right, left), daemon=True)
    t1.start()
    t2.start()
    t1.join()
    t2.join()


class HostExecClient:
    def __init__(self, argv: Sequence[str], *, probe: bool = False):
        self.argv = list(argv)
        self.probe = probe
        self.stop = threading.Event()
        self.send_lock = threading.Lock()
        self.exit_code = 1

    def run(self) -> int:
        config_path = os.environ.get("LUBOX_HOSTEXEC_CONFIG", CONTAINER_CONFIG_PATH)
        env_container = os.environ.get("LUBOX_CONTAINER_NAME")
        if not env_container:
            eprint("lubox: host-exec must be run inside a lubox container")
            return 126
        if os.environ.get("LUBOX_HOST_EXEC") == "0":
            eprint("lubox: host-exec is disabled for this container")
            return 126
        cfg_file = pathlib.Path(config_path)
        if not cfg_file.exists():
            eprint(f"lubox: host-exec config missing: {cfg_file}")
            return 126
        cfg = load_json_file(cfg_file)
        if not lubox_config_matches_env(cfg, env_container):
            eprint("lubox: host-exec config does not match this container")
            return 126
        if not cfg.get("enabled"):
            eprint("lubox: host-exec is disabled for this container")
            return 126
        token_path = pathlib.Path(str(cfg.get("token_path") or ""))
        if not token_path.exists():
            eprint(f"lubox: host-exec token missing: {token_path}")
            return 126
        token = token_path.read_bytes()
        host = str(cfg.get("host") or "")
        port = int(cfg.get("port") or 0)
        if not host or port <= 0:
            eprint("lubox: host-exec endpoint is not configured")
            return 126
        sock = socket.create_connection((host, port), timeout=10)
        sock.settimeout(None)
        try:
            send_control(
                sock,
                {
                    "type": "hello",
                    "version": 1,
                    "container_name": cfg.get("container_name"),
                    "container_id": cfg.get("container_id"),
                },
            )
            challenge = recv_control(sock)
            if challenge.get("type") != "challenge":
                eprint("lubox: host-exec auth failed")
                return 126
            nonce = base64.b64decode(str(challenge.get("nonce") or ""))
            request = self.request(cfg)
            request["hmac"] = hmac_for_request(token, nonce, request)
            send_control(sock, request)
            if self.probe:
                return self.read_until_exit(sock)
            return self.stream(sock)
        finally:
            try:
                sock.close()
            except OSError:
                pass

    def request(self, cfg: Dict[str, Any]) -> Dict[str, Any]:
        rows, cols = terminal_size()
        req_type = "probe" if self.probe else "exec"
        return {
            "type": req_type,
            "version": 1,
            "container_name": cfg.get("container_name"),
            "container_id": cfg.get("container_id"),
            "argv": [] if self.probe else self.argv,
            "cwd": os.getcwd(),
            "pty": False if self.probe else bool(sys.stdin.isatty() and sys.stdout.isatty()),
            "rows": rows,
            "cols": cols,
            "env": safe_forward_env(),
        }

    def read_until_exit(self, sock: socket.socket) -> int:
        while True:
            channel, payload = recv_frame(sock)
            if channel == 3:
                data = json.loads(payload.decode("utf-8"))
                return normalize_exit_code(int(data.get("exit_code", 1)))
            if channel == 6:
                data = json.loads(payload.decode("utf-8"))
                eprint(str(data.get("error", "host-exec error")))
                return 126

    def stream(self, sock: socket.socket) -> int:
        pty_mode = sys.stdin.isatty() and sys.stdout.isatty()
        old_term = None
        old_winch = None
        old_int = signal.getsignal(signal.SIGINT)

        def on_int(signum: int, frame: object) -> None:
            try:
                with self.send_lock:
                    send_frame(sock, 7, json.dumps({"signal": int(signum)}).encode("utf-8"))
            except OSError:
                self.stop.set()

        signal.signal(signal.SIGINT, on_int)
        if pty_mode:
            old_term = termios.tcgetattr(sys.stdin.fileno())
            tty.setraw(sys.stdin.fileno())
            old_winch = signal.getsignal(signal.SIGWINCH)

            def on_winch(signum: int, frame: object) -> None:
                rows, cols = terminal_size()
                payload = json.dumps({"rows": rows, "cols": cols}).encode("utf-8")
                try:
                    with self.send_lock:
                        send_frame(sock, 4, payload)
                except OSError:
                    self.stop.set()

            signal.signal(signal.SIGWINCH, on_winch)
        stdin_thread = threading.Thread(target=self.stdin_loop, args=(sock,), daemon=True)
        stdin_thread.start()
        try:
            while True:
                channel, payload = recv_frame(sock)
                if channel == 1:
                    os.write(sys.stdout.fileno(), payload)
                elif channel == 2:
                    os.write(sys.stderr.fileno(), payload)
                elif channel == 3:
                    data = json.loads(payload.decode("utf-8"))
                    return normalize_exit_code(int(data.get("exit_code", 1)))
                elif channel == 6:
                    data = json.loads(payload.decode("utf-8"))
                    eprint(str(data.get("error", "host-exec error")))
                    return 126
        except EOFError:
            eprint("lubox: host-exec connection closed")
            return 1
        finally:
            self.stop.set()
            if pty_mode and old_term is not None:
                termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old_term)
            if pty_mode and old_winch is not None:
                signal.signal(signal.SIGWINCH, old_winch)
            if old_int is not None:
                signal.signal(signal.SIGINT, old_int)

    def stdin_loop(self, sock: socket.socket) -> None:
        fd = sys.stdin.fileno()
        while not self.stop.is_set():
            try:
                data = os.read(fd, 65536)
            except OSError as exc:
                if exc.errno in (errno.EBADF, errno.EIO):
                    data = b""
                else:
                    return
            try:
                with self.send_lock:
                    if data:
                        send_frame(sock, 0, data)
                    else:
                        send_frame(sock, 5, b"")
                        return
            except OSError:
                return


class SSHAgentProxyClient:
    def __init__(self, args: argparse.Namespace):
        self.config_path = pathlib.Path(os.environ.get("LUBOX_HOSTEXEC_CONFIG", CONTAINER_CONFIG_PATH))
        self.socket_path = pathlib.Path(args.socket_path or container_ssh_auth_sock())
        self.pid_file = pathlib.Path(args.pid_file or container_ssh_agent_pid())
        self.check = bool(args.check)
        self.stop = threading.Event()

    def run(self) -> int:
        if self.check:
            try:
                if self.existing_proxy_running():
                    return self.check_local_proxy()
                with self.connect_bridge():
                    pass
                return 0
            except LuboxError as exc:
                eprint(str(exc))
                return 1
        if self.existing_proxy_running():
            return 0
        self.socket_path.parent.mkdir(parents=True, exist_ok=True)
        safe_unlink(self.socket_path)
        signal.signal(signal.SIGTERM, self.handle_signal)
        signal.signal(signal.SIGINT, self.handle_signal)
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            srv.bind(str(self.socket_path))
            os.chmod(self.socket_path, 0o600)
            srv.listen(16)
            srv.settimeout(0.5)
            atomic_write_text(self.pid_file, f"{os.getpid()}\n", 0o600)
            while not self.stop.is_set():
                try:
                    conn, _addr = srv.accept()
                except socket.timeout:
                    continue
                thread = threading.Thread(target=self.handle_client_safe, args=(conn,), daemon=True)
                thread.start()
        finally:
            try:
                srv.close()
            except OSError:
                pass
            safe_unlink(self.socket_path)
            safe_unlink(self.pid_file)
        return 0

    def handle_signal(self, signum: int, frame: object) -> None:
        self.stop.set()

    def existing_proxy_running(self) -> bool:
        if not self.pid_file.exists() or not self.socket_path.exists():
            return False
        try:
            pid = int(self.pid_file.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            return False
        return looks_like_pid_running(pid)

    def check_local_proxy(self) -> int:
        sock: Optional[socket.socket] = None
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(3)
            sock.connect(str(self.socket_path))
            sock.sendall(struct.pack(">I", 1) + b"\x0b")
            header = sock.recv(5)
        except OSError as exc:
            raise LuboxError(f"lubox: SSH agent proxy healthcheck failed: {exc}")
        finally:
            if sock is not None:
                try:
                    sock.close()
                except OSError:
                    pass
        if len(header) == 5 and header[4] == 12:
            return 0
        raise LuboxError("lubox: SSH agent proxy healthcheck failed")

    def load_bridge_config(self) -> Dict[str, Any]:
        env_container = os.environ.get("LUBOX_CONTAINER_NAME")
        if not env_container:
            raise LuboxError("lubox: SSH agent proxy must run inside a lubox container")
        if not self.config_path.exists():
            raise LuboxError(f"lubox: host-exec config missing: {self.config_path}")
        cfg = load_json_file(self.config_path)
        if not lubox_config_matches_env(cfg, env_container):
            raise LuboxError("lubox: SSH agent proxy config does not match this container")
        ssh_cfg = cfg.get("ssh_agent")
        if not isinstance(ssh_cfg, dict) or not ssh_cfg.get("enabled"):
            raise LuboxError("lubox: SSH agent proxy is disabled for this container")
        return cfg

    def connect_bridge(self) -> socket.socket:
        cfg = self.load_bridge_config()
        ssh_cfg = cfg.get("ssh_agent")
        if not isinstance(ssh_cfg, dict):
            raise LuboxError("lubox: SSH agent proxy config invalid")
        host = str(ssh_cfg.get("host") or cfg.get("host") or "")
        port = int(ssh_cfg.get("port") or 0)
        token_path = pathlib.Path(str(ssh_cfg.get("token_path") or cfg.get("token_path") or ""))
        if not host or port <= 0:
            raise LuboxError("lubox: SSH agent proxy endpoint is not configured")
        if not token_path.exists():
            raise LuboxError(f"lubox: SSH agent proxy token missing: {token_path}")
        token = token_path.read_bytes()
        sock = socket.create_connection((host, port), timeout=10)
        sock.settimeout(None)
        ok = False
        try:
            send_control(
                sock,
                {
                    "type": "hello",
                    "version": 1,
                    "container_name": cfg.get("container_name"),
                    "container_id": cfg.get("container_id"),
                },
            )
            challenge = recv_control(sock)
            if challenge.get("type") != "challenge":
                raise LuboxError("lubox: SSH agent proxy auth failed")
            nonce = base64.b64decode(str(challenge.get("nonce") or ""))
            request = {
                "type": "ssh-agent",
                "version": 1,
                "container_name": cfg.get("container_name"),
                "container_id": cfg.get("container_id"),
            }
            request["hmac"] = hmac_for_request(token, nonce, request)
            send_control(sock, request)
            reply = recv_control(sock)
            if reply.get("type") != "ok":
                error = str(reply.get("error") or "lubox: SSH agent proxy auth failed")
                raise LuboxError(error)
            ok = True
            return sock
        finally:
            if not ok:
                sock.close()

    def handle_client_safe(self, conn: socket.socket) -> None:
        try:
            with conn:
                bridge = self.connect_bridge()
                with bridge:
                    raw_socket_proxy(conn, bridge)
        except (OSError, EOFError, json.JSONDecodeError, LuboxError) as exc:
            eprint(f"lubox: SSH agent proxy client error: {exc}")


class GPGAgentProxyClient:
    def __init__(self, args: argparse.Namespace):
        self.config_path = pathlib.Path(os.environ.get("LUBOX_HOSTEXEC_CONFIG", CONTAINER_CONFIG_PATH))
        self.home = pathlib.Path(args.home or container_gpg_home())
        self.pid_file = pathlib.Path(args.pid_file or container_gpg_agent_pid())
        self.check = bool(args.check)
        self.stop = threading.Event()

    def run(self) -> int:
        try:
            cfg, gpg_cfg = self.load_bridge_config()
            socket_keys = self.socket_keys(gpg_cfg)
            if self.check:
                if self.existing_proxy_running(gpg_cfg, socket_keys):
                    for key in socket_keys:
                        self.check_local_proxy(gpg_cfg, key)
                else:
                    for key in socket_keys:
                        with self.connect_bridge(cfg, gpg_cfg, key):
                            pass
                return 0
            if self.existing_proxy_running(gpg_cfg, socket_keys):
                return 0
            self.setup_home(gpg_cfg)
            signal.signal(signal.SIGTERM, self.handle_signal)
            signal.signal(signal.SIGINT, self.handle_signal)
            selector = selectors.DefaultSelector()
            servers: List[Tuple[socket.socket, pathlib.Path]] = []
            try:
                for key in socket_keys:
                    socket_path = self.socket_path(gpg_cfg, key)
                    socket_path.parent.mkdir(parents=True, exist_ok=True)
                    safe_unlink(socket_path)
                    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    srv.bind(str(socket_path))
                    os.chmod(socket_path, 0o600)
                    srv.listen(16)
                    srv.setblocking(False)
                    selector.register(srv.fileno(), selectors.EVENT_READ, (srv, key))
                    servers.append((srv, socket_path))
                atomic_write_text(self.pid_file, f"{os.getpid()}\n", 0o600)
                while not self.stop.is_set():
                    for key, _mask in selector.select(0.5):
                        srv, socket_key = key.data
                        try:
                            conn, _addr = srv.accept()
                        except OSError:
                            continue
                        thread = threading.Thread(target=self.handle_client_safe, args=(conn, cfg, gpg_cfg, socket_key), daemon=True)
                        thread.start()
            finally:
                selector.close()
                for srv, socket_path in servers:
                    try:
                        srv.close()
                    except OSError:
                        pass
                    safe_unlink(socket_path)
                safe_unlink(self.pid_file)
            return 0
        except LuboxError as exc:
            eprint(str(exc))
            return 1

    def handle_signal(self, signum: int, frame: object) -> None:
        self.stop.set()

    def socket_keys(self, gpg_cfg: Dict[str, Any]) -> List[str]:
        sockets = gpg_cfg.get("sockets")
        if not isinstance(sockets, dict):
            raise LuboxError("lubox: GPG agent proxy config invalid")
        keys = [key for key in sorted(sockets) if key in GPG_SOCKET_BASENAMES]
        if not keys:
            raise LuboxError("lubox: GPG agent proxy has no sockets")
        return keys

    def socket_path(self, gpg_cfg: Dict[str, Any], key: str) -> pathlib.Path:
        sockets = gpg_cfg.get("sockets")
        if isinstance(sockets, dict):
            item = sockets.get(key)
            if isinstance(item, dict) and item.get("socket_path"):
                return pathlib.Path(str(item.get("socket_path")))
        return pathlib.Path(container_gpg_proxy_socket_path(key))

    def existing_proxy_running(self, gpg_cfg: Dict[str, Any], socket_keys: Sequence[str]) -> bool:
        if not self.pid_file.exists():
            return False
        try:
            pid = int(self.pid_file.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            return False
        if not looks_like_pid_running(pid):
            return False
        return all(self.socket_path(gpg_cfg, key).exists() for key in socket_keys)

    def setup_home(self, gpg_cfg: Dict[str, Any]) -> None:
        self.home.mkdir(parents=True, exist_ok=True)
        os.chmod(self.home, 0o700)
        host_home_value = str(gpg_cfg.get("home") or "")
        host_home = pathlib.Path(host_home_value) if host_home_value else None
        if host_home is None or not host_home.exists():
            return
        socket_names = set(GPG_SOCKET_BASENAMES.values())
        try:
            children = list(host_home.iterdir())
        except OSError:
            return
        for child in children:
            if child.name in socket_names:
                continue
            dest = self.home / child.name
            if dest.exists() or dest.is_symlink():
                continue
            try:
                os.symlink(str(child), str(dest))
            except OSError:
                pass

    def check_local_proxy(self, gpg_cfg: Dict[str, Any], key: str) -> None:
        socket_path = self.socket_path(gpg_cfg, key)
        sock: Optional[socket.socket] = None
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(3)
            sock.connect(str(socket_path))
            data = sock.recv(16)
        except OSError as exc:
            raise LuboxError(f"lubox: GPG agent proxy healthcheck failed for {key}: {exc}")
        finally:
            if sock is not None:
                try:
                    sock.close()
                except OSError:
                    pass
        if data:
            return
        raise LuboxError(f"lubox: GPG agent proxy healthcheck failed for {key}")

    def load_bridge_config(self) -> Tuple[Dict[str, Any], Dict[str, Any]]:
        env_container = os.environ.get("LUBOX_CONTAINER_NAME")
        if not env_container:
            raise LuboxError("lubox: GPG agent proxy must run inside a lubox container")
        if not self.config_path.exists():
            raise LuboxError(f"lubox: host-exec config missing: {self.config_path}")
        cfg = load_json_file(self.config_path)
        if not lubox_config_matches_env(cfg, env_container):
            raise LuboxError("lubox: GPG agent proxy config does not match this container")
        gpg_cfg = cfg.get("gpg_agent")
        if not isinstance(gpg_cfg, dict) or not gpg_cfg.get("enabled"):
            raise LuboxError("lubox: GPG agent proxy is disabled for this container")
        return cfg, gpg_cfg

    def connect_bridge(self, cfg: Dict[str, Any], gpg_cfg: Dict[str, Any], socket_key: str) -> socket.socket:
        host = str(gpg_cfg.get("host") or cfg.get("host") or "")
        port = int(gpg_cfg.get("port") or 0)
        token_path = pathlib.Path(str(gpg_cfg.get("token_path") or cfg.get("token_path") or ""))
        if not host or port <= 0:
            raise LuboxError("lubox: GPG agent proxy endpoint is not configured")
        if not token_path.exists():
            raise LuboxError(f"lubox: GPG agent proxy token missing: {token_path}")
        token = token_path.read_bytes()
        sock = socket.create_connection((host, port), timeout=10)
        sock.settimeout(None)
        ok = False
        try:
            send_control(
                sock,
                {
                    "type": "hello",
                    "version": 1,
                    "container_name": cfg.get("container_name"),
                    "container_id": cfg.get("container_id"),
                },
            )
            challenge = recv_control(sock)
            if challenge.get("type") != "challenge":
                raise LuboxError("lubox: GPG agent proxy auth failed")
            nonce = base64.b64decode(str(challenge.get("nonce") or ""))
            request = {
                "type": "gpg-agent",
                "version": 1,
                "container_name": cfg.get("container_name"),
                "container_id": cfg.get("container_id"),
                "socket": socket_key,
            }
            request["hmac"] = hmac_for_request(token, nonce, request)
            send_control(sock, request)
            reply = recv_control(sock)
            if reply.get("type") != "ok":
                error = str(reply.get("error") or "lubox: GPG agent proxy auth failed")
                raise LuboxError(error)
            ok = True
            return sock
        finally:
            if not ok:
                sock.close()

    def handle_client_safe(self, conn: socket.socket, cfg: Dict[str, Any], gpg_cfg: Dict[str, Any], socket_key: str) -> None:
        try:
            with conn:
                bridge = self.connect_bridge(cfg, gpg_cfg, socket_key)
                with bridge:
                    raw_socket_proxy(conn, bridge)
        except (OSError, EOFError, json.JSONDecodeError, LuboxError) as exc:
            eprint(f"lubox: GPG agent proxy client error: {exc}")


class CodeServerProxyServer:
    def __init__(self, args: argparse.Namespace):
        self.engine = Engine.select(args.engine)
        self.container = args.container
        self.listen_host = args.listen_host
        self.listen_port = int(args.listen_port)
        self.target_port = int(args.target_port)
        self.pid_file = pathlib.Path(args.pid_file)
        self.log_file = pathlib.Path(args.log_file)
        self.stop = threading.Event()

    def run(self) -> int:
        signal.signal(signal.SIGTERM, self.handle_signal)
        signal.signal(signal.SIGINT, self.handle_signal)
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind((self.listen_host, self.listen_port))
            sock.listen(32)
            sock.settimeout(0.5)
            atomic_write_text(self.pid_file, f"{os.getpid()}\n", 0o600)
            while not self.stop.is_set():
                try:
                    conn, addr = sock.accept()
                except socket.timeout:
                    continue
                thread = threading.Thread(target=self.handle_client_safe, args=(conn, addr), daemon=True)
                thread.start()
        finally:
            try:
                sock.close()
            except OSError:
                pass
            safe_unlink(self.pid_file)
        return 0

    def handle_signal(self, signum: int, frame: object) -> None:
        self.stop.set()

    def handle_client_safe(self, conn: socket.socket, addr: Tuple[str, int]) -> None:
        try:
            with conn:
                self.handle_client(conn)
        except OSError as exc:
            self.append_log(f"client {addr} error: {exc}\n")

    def handle_client(self, conn: socket.socket) -> None:
        log = self.log_file.open("ab")
        try:
            proc = subprocess.Popen(
                self.engine.argv(["exec", "-i", self.container, "python3", "-c", CODE_SERVER_CONNECT_SCRIPT, str(self.target_port)]),
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=log,
                bufsize=0,
            )
        finally:
            log.close()
        assert proc.stdin is not None
        assert proc.stdout is not None
        t1 = threading.Thread(target=self.copy_socket_to_pipe, args=(conn, proc.stdin, proc), daemon=True)
        t2 = threading.Thread(target=self.copy_pipe_to_socket, args=(proc.stdout.fileno(), conn, proc), daemon=True)
        t1.start()
        t2.start()
        while proc.poll() is None and (t1.is_alive() or t2.is_alive()):
            time.sleep(0.05)
        if proc.poll() is None:
            proc.terminate()
        try:
            proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()

    def copy_socket_to_pipe(self, conn: socket.socket, pipe: Any, proc: subprocess.Popen) -> None:
        while proc.poll() is None:
            try:
                data = conn.recv(65536)
            except OSError:
                break
            if not data:
                break
            try:
                pipe.write(data)
                pipe.flush()
            except OSError:
                break
        try:
            pipe.close()
        except OSError:
            pass

    def copy_pipe_to_socket(self, fd: int, conn: socket.socket, proc: subprocess.Popen) -> None:
        while proc.poll() is None:
            try:
                data = os.read(fd, 65536)
            except OSError:
                break
            if not data:
                break
            try:
                conn.sendall(data)
            except OSError:
                break
        try:
            conn.shutdown(socket.SHUT_WR)
        except OSError:
            pass

    def append_log(self, text: str) -> None:
        try:
            with self.log_file.open("a", encoding="utf-8") as f:
                f.write(text)
        except OSError:
            pass


class HostExecServer:
    def __init__(self, args: argparse.Namespace):
        self.engine = Engine.select(args.engine)
        self.name = args.name
        self.container = args.container
        self.port = int(args.port)
        self.token_file = pathlib.Path(args.token_file)
        self.config_file = pathlib.Path(args.config_file)
        self.bind_address = args.bind_address
        self.host = args.host
        self.token_path = args.token_path
        self.pid_file = pathlib.Path(args.pid_file)
        self.ssh_auth_sock = pathlib.Path(args.ssh_auth_sock) if args.ssh_auth_sock else None
        self.ssh_port = int(args.ssh_port or 0)
        self.ssh_socket_path = args.ssh_socket_path or container_ssh_auth_sock()
        self.gpg_sockets = self.parse_gpg_sockets(args.gpg_socket or [])
        self.gpg_home = pathlib.Path(args.gpg_home) if args.gpg_home else None
        self.stop = threading.Event()
        self.token = read_token(self.token_file)

    def parse_gpg_sockets(self, values: Sequence[str]) -> Dict[str, pathlib.Path]:
        sockets: Dict[str, pathlib.Path] = {}
        for value in values:
            if "=" not in value:
                continue
            key, path = value.split("=", 1)
            if key in GPG_SOCKET_BASENAMES and path:
                sockets[key] = pathlib.Path(path)
        return sockets

    def run(self) -> int:
        signal.signal(signal.SIGTERM, self.handle_signal)
        signal.signal(signal.SIGINT, self.handle_signal)
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        ssh_sock: Optional[socket.socket] = None
        try:
            sock.bind((self.bind_address, self.port))
            sock.listen(16)
            sock.settimeout(0.5)
            ssh_sock = self.create_ssh_listener()
            cid = self.container_id()
            self.write_config(True, cid)
            if ssh_sock is not None:
                thread = threading.Thread(target=self.ssh_accept_loop, args=(ssh_sock,), daemon=True)
                thread.start()
            monitor = threading.Thread(target=self.monitor_container, daemon=True)
            monitor.start()
            while not self.stop.is_set():
                try:
                    conn, addr = sock.accept()
                except socket.timeout:
                    continue
                thread = threading.Thread(target=self.handle_client_safe, args=(conn, addr), daemon=True)
                thread.start()
        finally:
            try:
                sock.close()
            except OSError:
                pass
            if ssh_sock is not None:
                try:
                    ssh_sock.close()
                except OSError:
                    pass
            self.write_config(False, "")
            safe_unlink(self.pid_file)
        return 0

    def create_ssh_listener(self) -> Optional[socket.socket]:
        if self.ssh_auth_sock is None or self.ssh_port <= 0:
            return None
        try:
            st = self.ssh_auth_sock.stat()
        except OSError as exc:
            eprint(f"lubox: SSH_AUTH_SOCK not available for proxy: {self.ssh_auth_sock}: {exc}")
            self.ssh_auth_sock = None
            self.ssh_port = 0
            return None
        if not stat.S_ISSOCK(st.st_mode):
            eprint(f"lubox: SSH_AUTH_SOCK is not a socket: {self.ssh_auth_sock}")
            self.ssh_auth_sock = None
            self.ssh_port = 0
            return None
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind((self.bind_address, self.ssh_port))
            sock.listen(16)
            sock.settimeout(0.5)
            return sock
        except OSError:
            self.ssh_auth_sock = None
            self.ssh_port = 0
            sock.close()
            raise

    def handle_signal(self, signum: int, frame: object) -> None:
        self.stop.set()

    def container_id(self) -> str:
        info = self.engine.inspect_container(self.container, required=False)
        if not info:
            return ""
        return str(info.get("Id") or "")

    def container_running(self) -> bool:
        return self.engine.is_running(self.container)

    def pid_file_current(self) -> bool:
        try:
            return self.pid_file.read_text(encoding="utf-8").strip() == str(os.getpid())
        except OSError:
            return False

    def monitor_container(self) -> None:
        while not self.stop.is_set():
            if not self.pid_file_current():
                self.stop.set()
                return
            if not self.container_running():
                self.stop.set()
                return
            time.sleep(1)

    def write_config(self, enabled: bool, cid: str) -> None:
        cfg = {
            "version": 1,
            "enabled": bool(enabled),
            "box_name": self.name,
            "container_name": self.container,
            "container_id": cid if enabled else "",
            "host": self.host,
            "bind_address": self.bind_address,
            "port": self.port if enabled else 0,
            "token_path": self.token_path if enabled else "",
            "pty_default": True,
            "ssh_agent": {
                "enabled": bool(enabled and self.ssh_auth_sock is not None and self.ssh_port > 0),
                "host": self.host,
                "port": self.ssh_port if enabled and self.ssh_auth_sock is not None else 0,
                "socket_path": self.ssh_socket_path,
                "host_path": str(self.ssh_auth_sock) if enabled and self.ssh_auth_sock is not None else "",
                "token_path": self.token_path if enabled and self.ssh_auth_sock is not None else "",
            },
            "gpg_agent": {
                "enabled": bool(enabled and self.gpg_sockets),
                "host": self.host,
                "port": self.port if enabled and self.gpg_sockets else 0,
                "home": str(self.gpg_home or ""),
                "proxy_home": container_gpg_home(),
                "token_path": self.token_path if enabled and self.gpg_sockets else "",
                "sockets": {
                    key: {
                        "socket_path": container_gpg_proxy_socket_path(key),
                        "host_path": str(path),
                    }
                    for key, path in sorted(self.gpg_sockets.items())
                },
            },
        }
        try:
            atomic_write_json(self.config_file, cfg, 0o644)
        except OSError as exc:
            eprint(f"lubox: failed to write host-exec config: {exc}")

    def handle_client_safe(self, conn: socket.socket, addr: Tuple[str, int]) -> None:
        try:
            with conn:
                self.handle_client(conn)
        except (OSError, EOFError, json.JSONDecodeError, LuboxError) as exc:
            eprint(f"lubox: host-exec client error from {addr}: {exc}")

    def handle_client(self, conn: socket.socket) -> None:
        hello = recv_control(conn)
        if hello.get("type") != "hello" or hello.get("version") != 1:
            raise LuboxError("invalid hello")
        nonce = secrets.token_bytes(32)
        send_control(conn, {"type": "challenge", "version": 1, "nonce": base64.b64encode(nonce).decode("ascii")})
        request = recv_control(conn)
        if not self.auth_ok(request, nonce):
            eprint("lubox: host-exec auth failure")
            send_frame(conn, 6, json.dumps({"error": "lubox: host-exec auth failed"}).encode("utf-8"))
            return
        req_type = request.get("type")
        if req_type == "gpg-agent":
            self.handle_gpg_client(conn, request)
            return
        if req_type == "probe":
            send_frame(conn, 3, json.dumps({"exit_code": 0}).encode("utf-8"))
            return
        if req_type != "exec":
            send_frame(conn, 6, json.dumps({"error": "lubox: unsupported host-exec request"}).encode("utf-8"))
            return
        self.run_command(conn, request)

    def ssh_accept_loop(self, sock: socket.socket) -> None:
        while not self.stop.is_set():
            try:
                conn, addr = sock.accept()
            except socket.timeout:
                continue
            except OSError:
                if self.stop.is_set():
                    return
                raise
            thread = threading.Thread(target=self.handle_ssh_client_safe, args=(conn, addr), daemon=True)
            thread.start()

    def handle_ssh_client_safe(self, conn: socket.socket, addr: Tuple[str, int]) -> None:
        try:
            with conn:
                self.handle_ssh_client(conn)
        except (OSError, EOFError, json.JSONDecodeError, LuboxError) as exc:
            eprint(f"lubox: SSH agent bridge client error from {addr}: {exc}")

    def handle_ssh_client(self, conn: socket.socket) -> None:
        hello = recv_control(conn)
        if hello.get("type") != "hello" or hello.get("version") != 1:
            raise LuboxError("invalid SSH agent hello")
        nonce = secrets.token_bytes(32)
        send_control(conn, {"type": "challenge", "version": 1, "nonce": base64.b64encode(nonce).decode("ascii")})
        request = recv_control(conn)
        if request.get("type") != "ssh-agent" or not self.auth_ok(request, nonce):
            eprint("lubox: SSH agent bridge auth failure")
            send_control(conn, {"type": "error", "error": "lubox: SSH agent bridge auth failed"})
            return
        if self.ssh_auth_sock is None:
            send_control(conn, {"type": "error", "error": "lubox: SSH agent bridge disabled"})
            return
        agent = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            agent.connect(str(self.ssh_auth_sock))
            send_control(conn, {"type": "ok", "version": 1})
            raw_socket_proxy(conn, agent)
        finally:
            agent.close()

    def handle_gpg_client(self, conn: socket.socket, request: Dict[str, Any]) -> None:
        socket_key = str(request.get("socket") or "")
        agent_path = self.gpg_sockets.get(socket_key)
        if agent_path is None:
            send_control(conn, {"type": "error", "error": "lubox: GPG agent bridge disabled"})
            return
        sock_path = socket_path_if_socket(agent_path)
        if sock_path is None:
            send_control(conn, {"type": "error", "error": f"lubox: GPG socket unavailable: {agent_path}"})
            return
        agent = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            agent.connect(str(sock_path))
            send_control(conn, {"type": "ok", "version": 1})
            raw_socket_proxy(conn, agent)
        finally:
            agent.close()

    def auth_ok(self, request: Dict[str, Any], nonce: bytes) -> bool:
        supplied = request.get("hmac")
        if not isinstance(supplied, str):
            return False
        if request.get("version") != 1:
            return False
        if request.get("container_name") != self.container:
            return False
        current_id = self.container_id()
        if not current_id or request.get("container_id") != current_id:
            return False
        req = dict(request)
        req.pop("hmac", None)
        expected = hmac_for_request(self.token, nonce, req)
        return hmac.compare_digest(supplied, expected)

    def run_command(self, conn: socket.socket, request: Dict[str, Any]) -> None:
        argv = request.get("argv")
        if argv is None:
            argv = []
        if not isinstance(argv, list) or any(not isinstance(item, str) for item in argv):
            send_frame(conn, 6, json.dumps({"error": "lubox: invalid argv"}).encode("utf-8"))
            return
        if not argv:
            shell = HostIdentity.load().login_shell
            if not shell.exists():
                send_frame(conn, 6, json.dumps({"error": f"lubox: host login shell not found: {shell}"}).encode("utf-8"))
                return
            argv = [str(shell)]
        cwd = self.host_cwd(str(request.get("cwd") or ""), conn)
        env = os.environ.copy()
        env["LUBOX_HOSTEXEC_SERVER_PID"] = str(os.getpid())
        forwarded = request.get("env") or {}
        if isinstance(forwarded, dict):
            for key, value in forwarded.items():
                if isinstance(key, str) and isinstance(value, str):
                    if key in ("TERM", "COLORTERM", "LANG") or key.startswith("LC_"):
                        env[key] = value
        rows = int(request.get("rows") or 24)
        cols = int(request.get("cols") or 80)
        if bool(request.get("pty")):
            self.run_pty(conn, argv, cwd, env, rows, cols)
        else:
            self.run_pipes(conn, argv, cwd, env)

    def host_cwd(self, requested: str, conn: socket.socket) -> str:
        if requested and pathlib.Path(requested).exists() and pathlib.Path(requested).is_dir():
            return requested
        home = str(HostIdentity.load().home)
        warning = f"lubox: host cwd not found, using home: {requested}\n".encode("utf-8")
        try:
            send_frame(conn, 2, warning)
        except OSError:
            pass
        return home

    def run_pty(self, conn: socket.socket, argv: List[str], cwd: str, env: Dict[str, str], rows: int, cols: int) -> None:
        master, slave = pty.openpty()
        os.set_blocking(master, False)
        self.set_winsize(slave, rows, cols)
        try:
            proc = subprocess.Popen(
                argv,
                cwd=cwd,
                env=env,
                stdin=slave,
                stdout=slave,
                stderr=slave,
                close_fds=True,
                preexec_fn=setup_child_pty,
            )
        except FileNotFoundError:
            os.close(master)
            os.close(slave)
            send_frame(conn, 6, json.dumps({"error": f"lubox: command not found: {argv[0]}"}).encode("utf-8"))
            return
        os.close(slave)
        input_thread = threading.Thread(target=self.pty_input_loop, args=(conn, master, proc), daemon=True)
        input_thread.start()
        selector = selectors.DefaultSelector()
        selector.register(master, selectors.EVENT_READ)
        try:
            while True:
                events = selector.select(0.1)
                for key, _mask in events:
                    try:
                        data = os.read(key.fd, 65536)
                    except OSError as exc:
                        if exc.errno == errno.EIO:
                            data = b""
                        elif exc.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                            continue
                        else:
                            raise
                    if data:
                        send_frame(conn, 1, data)
                    else:
                        selector.unregister(master)
                        proc.wait()
                        send_frame(conn, 3, json.dumps({"exit_code": proc.returncode}).encode("utf-8"))
                        return
                if proc.poll() is not None and not events:
                    try:
                        data = os.read(master, 65536)
                        if data:
                            send_frame(conn, 1, data)
                            continue
                    except OSError as exc:
                        if exc.errno not in (errno.EAGAIN, errno.EWOULDBLOCK, errno.EIO):
                            raise
                        pass
                    send_frame(conn, 3, json.dumps({"exit_code": proc.returncode}).encode("utf-8"))
                    return
        finally:
            try:
                selector.close()
            except OSError:
                pass
            try:
                os.close(master)
            except OSError:
                pass

    def pty_input_loop(self, conn: socket.socket, master: int, proc: subprocess.Popen) -> None:
        while True:
            try:
                channel, payload = recv_frame(conn)
            except (OSError, EOFError, LuboxError):
                self.signal_process(proc, signal.SIGINT)
                return
            try:
                if channel == 0 and payload:
                    if b"\x03" in payload:
                        self.signal_process(proc, signal.SIGINT)
                    os.write(master, payload)
                elif channel == 4:
                    data = json.loads(payload.decode("utf-8"))
                    self.set_winsize(master, int(data.get("rows") or 24), int(data.get("cols") or 80))
                elif channel == 5:
                    os.write(master, b"\x04")
                elif channel == 7:
                    self.signal_from_payload(proc, payload)
            except OSError:
                return

    def run_pipes(self, conn: socket.socket, argv: List[str], cwd: str, env: Dict[str, str]) -> None:
        try:
            proc = subprocess.Popen(
                argv,
                cwd=cwd,
                env=env,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                close_fds=True,
                start_new_session=True,
            )
        except FileNotFoundError:
            send_frame(conn, 6, json.dumps({"error": f"lubox: command not found: {argv[0]}"}).encode("utf-8"))
            return
        input_thread = threading.Thread(target=self.pipe_input_loop, args=(conn, proc), daemon=True)
        input_thread.start()
        selector = selectors.DefaultSelector()
        assert proc.stdout is not None
        assert proc.stderr is not None
        selector.register(proc.stdout.fileno(), selectors.EVENT_READ, 1)
        selector.register(proc.stderr.fileno(), selectors.EVENT_READ, 2)
        try:
            while selector.get_map():
                for key, _mask in selector.select(0.1):
                    data = os.read(key.fd, 65536)
                    if data:
                        send_frame(conn, int(key.data), data)
                    else:
                        selector.unregister(key.fd)
                if proc.poll() is not None and not selector.get_map():
                    break
            proc.wait()
            send_frame(conn, 3, json.dumps({"exit_code": proc.returncode}).encode("utf-8"))
        finally:
            selector.close()

    def pipe_input_loop(self, conn: socket.socket, proc: subprocess.Popen) -> None:
        assert proc.stdin is not None
        stdin_open = True
        while True:
            try:
                channel, payload = recv_frame(conn)
            except (OSError, EOFError, LuboxError):
                if stdin_open:
                    try:
                        proc.stdin.close()
                    except OSError:
                        pass
                self.signal_process(proc, signal.SIGINT)
                return
            if channel == 0 and stdin_open:
                try:
                    proc.stdin.write(payload)
                    proc.stdin.flush()
                except OSError:
                    stdin_open = False
            elif channel == 5 and stdin_open:
                try:
                    proc.stdin.close()
                except OSError:
                    pass
                stdin_open = False
            elif channel == 7:
                self.signal_from_payload(proc, payload)
            if proc.poll() is not None:
                if stdin_open:
                    try:
                        proc.stdin.close()
                    except OSError:
                        pass
                return

    def signal_from_payload(self, proc: subprocess.Popen, payload: bytes) -> None:
        try:
            data = json.loads(payload.decode("utf-8"))
            signum = int(data.get("signal") or signal.SIGINT)
        except (ValueError, json.JSONDecodeError):
            signum = signal.SIGINT
        if signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            self.signal_process(proc, signum)

    def signal_process(self, proc: subprocess.Popen, signum: int) -> None:
        if proc.poll() is not None:
            return
        try:
            os.killpg(proc.pid, signum)
        except ProcessLookupError:
            return
        except OSError:
            try:
                proc.send_signal(signum)
            except OSError:
                pass

    def set_winsize(self, fd: int, rows: int, cols: int) -> None:
        rows = max(1, rows)
        cols = max(1, cols)
        try:
            fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
        except OSError:
            pass


def terminal_size() -> Tuple[int, int]:
    size = shutil.get_terminal_size(fallback=(80, 24))
    return size.lines, size.columns


def setup_child_pty() -> None:
    try:
        os.setsid()
    except OSError:
        pass
    try:
        fcntl.ioctl(0, termios.TIOCSCTTY, 0)
    except OSError:
        pass


def command_doctor(args: argparse.Namespace) -> int:
    paths = LuboxPaths.load()
    ident = HostIdentity.load()
    print(f"lubox version: {VERSION}")
    print(f"platform: {platform.system()} {platform.release()}")
    print(f"host user: {ident.username} uid={ident.uid} gid={ident.gid}")
    print(f"host home: {ident.home}")
    print(f"host login shell: {ident.login_shell}")
    print(f"data: {paths.data}")
    print(f"state: {paths.state}")
    print(f"cache: {paths.cache}")
    print(f"runtime: {paths.runtime}")
    try:
        engine = Engine.select(getattr(args, "engine", None))
    except LuboxError as exc:
        print(f"engine: FAIL: {exc}")
        return 1
    print(f"engine: {engine.name} ({engine.path})")
    if is_macos() and engine.name == "podman":
        try:
            rows = engine.podman_machine_rows()
            if not rows:
                print('podman machine: FAIL: none; run: podman machine init -v "$HOME:$HOME" --now')
                return 1
            running = any(bool(row.get("Running")) or str(row.get("Status", "")).lower() == "running" for row in rows)
            print(f"podman machine running: {'yes' if running else 'no'}")
        except LuboxError as exc:
            print(f"podman machine: FAIL: {exc}")
            return 1
    cp = engine.run(["version"], check=False, capture=True, timeout=30)
    if cp.returncode != 0:
        print(f"engine version: FAIL ({cp.returncode})")
        stderr = _decode_output(cp.stderr).strip()
        if stderr:
            print(stderr)
        return 1
    first_line = _decode_output(cp.stdout).splitlines()[0] if _decode_output(cp.stdout).splitlines() else "ok"
    print(f"engine version: {first_line}")
    manager = ContainerManager(engine, ident, paths)
    try:
        infos = manager.list_infos()
    except LuboxError as exc:
        print(f"list lubox containers: FAIL: {exc}")
        return 1
    print(f"lubox containers: {len(infos)}")
    for info in infos:
        print(f"- {info.name}: {info.status}, host_exec={info.host_exec}, base={info.base_image}")
    if is_linux():
        host_exec_infos = [info for info in infos if info.host_exec == "true"]
        runtime_dir = manager.linux_host_runtime_dir()
        if host_exec_infos and runtime_dir is None:
            print("host runtime mount: WARN: no host runtime dir found; expected XDG_RUNTIME_DIR or /run/user/UID")
        elif runtime_dir is not None:
            for info in host_exec_infos:
                mounted = manager.linux_host_runtime_mount_present(info.name, runtime_dir)
                if mounted is False:
                    print(f"host runtime mount: WARN ({info.name}): missing {runtime_dir}; recreate container")
                elif mounted is None:
                    print(f"host runtime mount: WARN ({info.name}): cannot inspect container mounts")
    probe_done = False
    for info in infos:
        if info.status == "running" and info.host_exec == "true":
            try:
                manager.ensure_hostexec_server(info.name)
                probe = manager.probe_hostexec(info.name)
                if probe.returncode == 0:
                    print(f"host-exec probe: ok ({info.name})")
                    probe_done = True
                    break
                print(f"host-exec probe: FAIL ({info.name}): {_decode_output(probe.stderr).strip()}")
                return 1
            except LuboxError as exc:
                print(f"host-exec probe: FAIL ({info.name}): {exc}")
                return 1
    if not probe_done:
        print("host-exec probe: skipped (no running host-exec lubox container)")
    return 0


def command_container_init_check() -> int:
    shell = pathlib.Path("/etc/lubox/shell")
    user = pathlib.Path("/etc/lubox/user.json")
    xdg_open = pathlib.Path("/usr/local/bin/xdg-open")
    if not shell.exists():
        eprint("lubox: missing /etc/lubox/shell")
        return 1
    shell_path = pathlib.Path(shell.read_text(encoding="utf-8").strip())
    if not shell_path.exists():
        eprint(f"lubox: configured shell missing: {shell_path}")
        return 1
    if not user.exists():
        eprint("lubox: missing /etc/lubox/user.json")
        return 1
    if not xdg_open.exists() or not os.access(xdg_open, os.X_OK):
        eprint("lubox: missing /usr/local/bin/xdg-open")
        return 1
    return 0


def command_install_xdg_open() -> int:
    try:
        atomic_write_text(pathlib.Path("/usr/local/bin/xdg-open"), XDG_OPEN_SCRIPT, 0o755)
    except OSError as exc:
        eprint(f"lubox: failed to install xdg-open bridge: {exc}")
        return 1
    return 0


def command_fish_complete(args: argparse.Namespace) -> int:
    kind = args.kind
    if inside_lubox_container() and os.environ.get("LUBOX_HOST_EXEC") == "1":
        return HostExecClient(host_lubox_command(["__fish-complete", kind]), probe=False).run()
    if kind == "commands":
        rows = [
            ("doctor", "diagnose lubox setup"),
            ("list", "list lubox containers"),
            ("create", "create lubox container"),
            ("destroy", "destroy lubox container"),
            ("start", "start lubox container"),
            ("stop", "stop lubox container"),
            ("enter", "enter lubox container"),
            ("exec", "execute command in lubox container"),
            ("code-server", "start code-server in container"),
            ("enable", "enable optional feature"),
            ("socket-proxy", "manage socket proxies"),
            ("host-exec", "run command on host"),
        ]
        for value, desc in rows:
            print(f"{value}\t{desc}")
        return 0
    if kind == "engines":
        print("podman\tPodman engine")
        print("docker\tDocker engine")
        return 0
    if kind == "boxes":
        try:
            engine = Engine.select(None)
            ident = HostIdentity.load()
            paths = LuboxPaths.load()
            manager = ContainerManager(engine, ident, paths)
            for info in manager.list_infos():
                desc = f"{info.status}, host_exec={info.host_exec}, base={info.base_image}"
                print(f"{info.name}\t{desc}")
        except LuboxError:
            return 0
        return 0
    return 0


def build_parser() -> argparse.ArgumentParser:
    epilog = """examples:
  lubox create dev --image docker.io/library/fedora:latest
  lubox enter dev
  lubox exec dev -- uname -a
  lubox host-exec open .
  lubox create safe --no-host-exec
  lubox destroy dev

destroy keeps lubox/NAME:latest by default; destroy --force also removes it.
"""
    parser = LuboxArgumentParser(
        prog="lubox",
        description="Small Distrobox-like wrapper around podman/docker.",
        epilog=epilog,
    )
    sub = parser.add_subparsers(dest="command", metavar="COMMAND", parser_class=LuboxArgumentParser)

    def add_engine(p: argparse.ArgumentParser) -> None:
        p.add_argument("--engine", choices=["podman", "docker"], help="container engine (default: podman, then docker; env: LUBOX_ENGINE)")

    p = sub.add_parser("doctor", help="diagnose lubox setup")
    add_engine(p)

    p = sub.add_parser("list", help="list lubox containers")
    add_engine(p)

    p = sub.add_parser("create", help="create lubox container")
    p.add_argument("name", metavar="NAME")
    p.add_argument("--image", default=DEFAULT_IMAGE, help=f"base image (default: {DEFAULT_IMAGE})")
    add_engine(p)
    p.add_argument("--no-host-exec", action="store_true", help="disable host-exec bridge")
    p.add_argument("--rebuild", action="store_true", help="recreate existing container and rebuild image")
    p.add_argument("--bwrap", action="store_true", help="allow unprivileged bubblewrap via a narrow seccomp profile (Docker only)")

    p = sub.add_parser("reconfigure", help="migrate a stopped container without losing its writable filesystem")
    add_engine(p)
    p.add_argument("name", metavar="NAME")
    p.add_argument("--bwrap", action="store_true", required=True, help="enable bubblewrap; refuses running containers and keeps a rollback backup")

    p = sub.add_parser("destroy", help="stop and remove container; --force also removes image")
    add_engine(p)
    p.add_argument("name", metavar="NAME")
    p.add_argument("-f", "--force", action="store_true", help="force container removal and remove lubox image")

    p = sub.add_parser("start", help="start container")
    add_engine(p)
    p.add_argument("name", metavar="NAME")

    p = sub.add_parser("stop", help="stop container")
    add_engine(p)
    p.add_argument("name", metavar="NAME")

    p = sub.add_parser("socket-proxy", help="manage SSH/GPG socket proxies")
    add_engine(p)
    p.add_argument("action", choices=["restart"], metavar="ACTION")
    p.add_argument("name", metavar="NAME")
    p.add_argument("kind", nargs="?", choices=["all", "ssh", "gpg"], default="all", metavar="KIND")

    p = sub.add_parser("enter", help="enter container login shell, or run command after --")
    add_engine(p)
    p.add_argument("--xquartz", action="store_true", help="enable XQuartz DISPLAY forwarding on macOS")
    p.add_argument("--fast", action="store_true", help="skip Linux enter readiness checks and use cached runtime state")
    p.add_argument("name", metavar="NAME")
    p.add_argument("cmd", nargs=argparse.REMAINDER, metavar="CMD")

    p = sub.add_parser("exec", help="execute command in container")
    add_engine(p)
    p.add_argument("name", metavar="NAME")
    p.add_argument("cmd", nargs=argparse.REMAINDER, metavar="CMD")

    p = sub.add_parser("code-server", help="start code-server in container and open browser")
    add_engine(p)
    p.add_argument("name", nargs="?", metavar="NAME")
    p.add_argument("path", nargs="?", default=".", metavar="PATH", help="folder to open (default: current directory if mounted, else home)")
    p.add_argument("--port", type=int, help="local browser port (default: random high port)")
    p.add_argument("--container-port", type=int, help="container code-server port (default: same as local port)")
    p.add_argument("--host", action="store_true", help="listen on all host interfaces with a random password")
    p.add_argument("--auth", choices=["none", "password"], default="none", help="code-server auth mode (default: none, localhost tunnel only)")
    p.add_argument("--password", help="password for --auth password; generated if omitted")
    p.add_argument("--no-open", action="store_true", help="print URL without opening browser")
    p.add_argument("--install-only", action="store_true", help="install code-server and print binary path")
    p.add_argument("--reinstall", action="store_true", help="download latest code-server even if installed")

    p = sub.add_parser("host-exec", help="run host command from inside lubox container")
    p.add_argument("cmd", nargs=argparse.REMAINDER, metavar="CMD")

    p = sub.add_parser("enable", help="enable optional feature in current shell")
    add_engine(p)
    p.add_argument("feature", choices=["xquartz"], metavar="FEATURE")
    p.add_argument("--shell", choices=["sh", "fish", "json"], default="sh", help="output format for environment changes")

    hidden_names: List[str] = []

    p = sub.add_parser("__hostexec-server", help=argparse.SUPPRESS)
    hidden_names.append("__hostexec-server")
    p.add_argument("--engine", required=True, choices=["podman", "docker"])
    p.add_argument("--name", required=True)
    p.add_argument("--container", required=True)
    p.add_argument("--port", required=True, type=int)
    p.add_argument("--token-file", required=True)
    p.add_argument("--config-file", required=True)
    p.add_argument("--bind-address", required=True)
    p.add_argument("--host", required=True)
    p.add_argument("--token-path", required=True)
    p.add_argument("--pid-file", required=True)
    p.add_argument("--gpg-home")
    p.add_argument("--ssh-auth-sock")
    p.add_argument("--ssh-port", type=int, default=0)
    p.add_argument("--ssh-socket-path", default=container_ssh_auth_sock())
    p.add_argument("--gpg-socket", action="append", default=[])

    sub.add_parser("__hostexec-probe", help=argparse.SUPPRESS)
    hidden_names.append("__hostexec-probe")
    p = sub.add_parser("__ssh-agent-proxy-client", help=argparse.SUPPRESS)
    hidden_names.append("__ssh-agent-proxy-client")
    p.add_argument("--check", action="store_true")
    p.add_argument("--socket-path")
    p.add_argument("--pid-file")
    p = sub.add_parser("__gpg-agent-proxy-client", help=argparse.SUPPRESS)
    hidden_names.append("__gpg-agent-proxy-client")
    p.add_argument("--check", action="store_true")
    p.add_argument("--home")
    p.add_argument("--pid-file")
    p = sub.add_parser("__code-server-proxy-server", help=argparse.SUPPRESS)
    hidden_names.append("__code-server-proxy-server")
    p.add_argument("--engine", required=True, choices=["podman", "docker"])
    p.add_argument("--container", required=True)
    p.add_argument("--listen-host", default="127.0.0.1")
    p.add_argument("--listen-port", required=True, type=int)
    p.add_argument("--target-port", required=True, type=int)
    p.add_argument("--pid-file", required=True)
    p.add_argument("--log-file", required=True)
    sub.add_parser("__container-init-check", help=argparse.SUPPRESS)
    hidden_names.append("__container-init-check")
    sub.add_parser("__install-xdg-open", help=argparse.SUPPRESS)
    hidden_names.append("__install-xdg-open")
    p = sub.add_parser("__fish-complete", help=argparse.SUPPRESS)
    hidden_names.append("__fish-complete")
    p.add_argument("kind", choices=["commands", "boxes", "engines"])
    sub._choices_actions = [action for action in sub._choices_actions if action.dest not in hidden_names]
    return parser


def dispatch(args: argparse.Namespace) -> int:
    if args.command == "doctor":
        return command_doctor(args)
    if args.command == "host-exec":
        return HostExecClient(strip_dashdash(args.cmd), probe=False).run()
    if args.command == "__hostexec-probe":
        return HostExecClient([], probe=True).run()
    if args.command == "__container-init-check":
        return command_container_init_check()
    if args.command == "__install-xdg-open":
        return command_install_xdg_open()
    if args.command == "__hostexec-server":
        return HostExecServer(args).run()
    if args.command == "__ssh-agent-proxy-client":
        return SSHAgentProxyClient(args).run()
    if args.command == "__gpg-agent-proxy-client":
        return GPGAgentProxyClient(args).run()
    if args.command == "__code-server-proxy-server":
        return CodeServerProxyServer(args).run()
    if args.command == "__fish-complete":
        return command_fish_complete(args)
    paths = LuboxPaths.load()
    ident = HostIdentity.load()
    engine = Engine.select(getattr(args, "engine", None))
    manager = ContainerManager(engine, ident, paths)
    if args.command == "list":
        manager.print_list()
        return 0
    if args.command == "create":
        manager.create(args.name, args.image, args.no_host_exec, args.rebuild, bwrap=args.bwrap)
        return 0
    if args.command == "reconfigure":
        manager.reconfigure_bwrap(args.name)
        return 0
    if args.command == "destroy":
        manager.destroy(args.name, args.force)
        return 0
    if args.command == "start":
        manager.start(args.name, start_server=True)
        return 0
    if args.command == "stop":
        manager.stop(args.name)
        return 0
    if args.command == "socket-proxy":
        if args.action == "restart":
            manager.restart_socket_proxies(args.name, args.kind)
            return 0
    if args.command == "enter":
        return manager.enter(args.name, args.cmd, xquartz=args.xquartz, fast=args.fast)
    if args.command == "exec":
        return manager.exec(args.name, args.cmd)
    if args.command == "code-server":
        if not args.name:
            die("lubox: code-server requires NAME unless run inside a lubox container")
        return manager.code_server(args.name, args)
    if args.command == "enable":
        return manager.enable(args)
    return 0


def main(argv: Optional[Sequence[str]] = None) -> int:
    raw_args = list(sys.argv[1:] if argv is None else argv)
    try:
        forwarded = forward_lubox_command_if_needed(raw_args)
        if forwarded is not None:
            return forwarded
        parser = build_parser()
        args = parser.parse_args(raw_args)
        if args.command is None:
            parser.print_help()
            return 0
        return dispatch(args)
    except BrokenPipeError:
        return 1
    except KeyboardInterrupt:
        eprint("lubox: interrupted")
        return 130
    except CommandError as exc:
        eprint(str(exc))
        return exc.code
    except LuboxError as exc:
        eprint(str(exc))
        return exc.code


if __name__ == "__main__":
    sys.exit(main())
