#!/bin/sh
set -eu

if [ -n "${LESS-}" ]; then
  case " $LESS " in
    *" -R "*) ;;
    *) export LESS="-R $LESS" ;;
  esac
else
  export LESS=-R
fi

: "${LESS_TERMCAP_mb:=$(printf '\033[1;31m')}"
: "${LESS_TERMCAP_md:=$(printf '\033[1;38;2;2;128;165m')}"
: "${LESS_TERMCAP_me:=$(printf '\033[0m')}"
: "${LESS_TERMCAP_us:=$(printf '\033[4;38;2;91;165;2m')}"
: "${LESS_TERMCAP_ue:=$(printf '\033[0m')}"
: "${LESS_TERMCAP_so:=$(printf '\033[7;38;2;240;203;2m')}"
: "${LESS_TERMCAP_se:=$(printf '\033[0m')}"
export LESS_TERMCAP_mb LESS_TERMCAP_md LESS_TERMCAP_me LESS_TERMCAP_us LESS_TERMCAP_ue LESS_TERMCAP_so LESS_TERMCAP_se
export GROFF_NO_SGR=1

if [ -n "${MANROFFOPT-}" ]; then
  case " $MANROFFOPT " in
    *" -P-c "*) ;;
    *) export MANROFFOPT="-P-c $MANROFFOPT" ;;
  esac
else
  export MANROFFOPT=-P-c
fi

terminal_width=$(tput cols 2>/dev/null || :)
case "$terminal_width" in
  ''|*[!0-9]*) terminal_width=80 ;;
esac

if [ "$terminal_width" -lt 80 ]; then
  export MANWIDTH=$terminal_width
else
  export MANWIDTH=80
fi

if [ -t 1 ]; then
  MAN_LEFT_PAD=0
  if [ "$terminal_width" -gt "$MANWIDTH" ]; then
    MAN_LEFT_PAD=$(( (terminal_width - MANWIDTH) / 2 ))
  fi
  export MAN_LEFT_PAD
  export MANPAGER='sh -c '\''
pad=${MAN_LEFT_PAD:-0}
case "$pad" in
  ""|*[!0-9]*) pad=0 ;;
esac

if [ "$pad" -gt 0 ]; then
  prefix=$(printf "%*s" "$pad" "")
  awk -v prefix="$prefix" "{ print prefix \$0 }" | less
else
  exec less
fi
'\'''
fi

exec /usr/bin/man "$@"
