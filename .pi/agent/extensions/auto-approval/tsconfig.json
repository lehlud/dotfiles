{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["*.ts", "tests/**/*.ts", "../conversations/*.ts", "../multiplex/*.ts", "../provider-recovery/*.ts"]
}
