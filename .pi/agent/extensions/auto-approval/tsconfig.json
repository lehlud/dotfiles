{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "**/*.ts",
    "tests/**/*.ts",
    "../shared/**/*.ts",
    "../conversations/**/*.ts",
    "../multiplex/**/*.ts",
    "../provider-recovery/*.ts",
    "../code-quality/*.ts",
    "../fast-mode/*.ts",
    "../model-selection/*.ts",
    "../subagents/**/*.ts",
    "../context-management/**/*.ts",
    "../remote/**/*.ts",
    "../container-tools/**/*.ts"
  ]
}
